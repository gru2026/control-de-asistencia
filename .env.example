# Copiar a .env y completar. NUNCA subir .env a Git (está en .gitignore).
# Supabase → Project → Settings → API Keys

# Públicas
PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# Solo servidor (secret key / service_role). Jamás en código del navegador.
SUPABASE_SECRET_KEY=sb_secret_...

# Protege /api/cierre-diario (Vercel Cron la envía como Bearer token). Semana 2.
CRON_SECRET=

# SOLO para scripts locales (npm run db:*). Token personal de Supabase (sbp_...).
# Da control total de la cuenta: NO configurarlo en Vercel.
TOKEN_ACCESS=

# SOLO local: token de Vercel para gestionar variables y despliegues por API. Nunca en Vercel ni en Git.
VERCEL_TOKEN=
