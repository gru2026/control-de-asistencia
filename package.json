{
  "name": "asistencia-uen",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "PWA de control de asistencia del personal docente y administrativo — U.E.E. General Rafael Urdaneta",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "docs": "node Documentacion/90-Export/generar-consolidado.mjs",
    "db:migrar": "node --env-file=.env scripts/db.mjs migrar",
    "db:seed": "node --env-file=.env scripts/db.mjs seed",
    "db:sql": "node --env-file=.env scripts/db.mjs sql",
    "crear-usuario": "node --env-file=.env scripts/crear-usuario.mjs",
    "test:e2e": "node tests/e2e/navegacion.mjs",
    "capturas": "node tests/e2e/capturas.mjs",
    "e2e:instalar": "playwright install chromium"
  },
  "dependencies": {
    "@astrojs/vercel": "^11.0.12",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "astro": "^7.3.6",
    "exceljs": "^4.4.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.4",
    "eslint": "^10.12.0",
    "eslint-plugin-astro": "^3.2.1",
    "globals": "^17.13.0",
    "playwright": "^1.64.0",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
