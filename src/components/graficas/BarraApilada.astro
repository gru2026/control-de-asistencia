---
/** Composición de un total (p. ej. el día de hoy). Leyenda con números: no depende del color. */
interface Segmento {
  etiqueta: string;
  valor: number;
  clase: "presente" | "tarde" | "falta" | "permiso" | "pendiente";
  /** Destino al tocar el segmento o su leyenda (D-56) */
  href?: string;
}
interface Props {
  segmentos: Segmento[];
  /** En la leyenda, mostrar solo los valores mayores que cero. */
  soloConValor?: boolean;
}
const { segmentos, soloConValor = false } = Astro.props;
const leyenda = soloConValor ? segmentos.filter((s) => s.valor > 0) : segmentos;
const total = segmentos.reduce((s, x) => s + x.valor, 0);
const pct = (v: number) => (total ? Math.round((v / total) * 100) : 0);
---

<div
  class="apilada"
  role="img"
  aria-label={segmentos.map((s) => `${s.etiqueta}: ${s.valor}`).join(", ")}
>
  {segmentos
    .filter((s) => s.valor > 0)
    .map((s) =>
      s.href ? (
        <a
          href={s.href}
          class:list={["seg", s.clase]}
          style={`flex: ${s.valor}`}
          title={`${s.etiqueta}: ${s.valor} (${pct(s.valor)}%). Ver`}
          aria-hidden="true"
          tabindex="-1"
        />
      ) : (
        <span
          class:list={["seg", s.clase]}
          style={`flex: ${s.valor}`}
          title={`${s.etiqueta}: ${s.valor} (${pct(s.valor)}%)`}
        />
      ),
    )}
  {total === 0 && <span class="seg vacio" style="flex: 1" />}
</div>
<ul class="leyenda">
  {leyenda.map((s) => (
    <li>
      {s.href ? (
        <a
          href={s.href}
          class="enlace-leyenda"
          aria-label={`${s.etiqueta}: ${s.valor}. Ver quiénes`}
        >
          <span class:list={["m", s.clase]} />
          <span class="et">{s.etiqueta}</span>
          <strong>{s.valor}</strong>
          <span class="pc">{pct(s.valor)}%</span>
        </a>
      ) : (
        <>
          <span class:list={["m", s.clase]} />
          <span class="et">{s.etiqueta}</span>
          <strong>{s.valor}</strong>
          <span class="pc">{pct(s.valor)}%</span>
        </>
      )}
    </li>
  ))}
</ul>

<style>
  a.seg {
    transition: filter var(--duracion-rapida) var(--curva);
  }
  a.seg:hover {
    filter: brightness(1.12);
  }
  .enlace-leyenda {
    display: inline-flex;
    align-items: center;
    gap: inherit;
    min-height: 36px;
    margin: -4px -8px;
    padding: 4px 8px;
    border-radius: var(--radio-sm);
    color: inherit;
    text-decoration: none;
  }
  .enlace-leyenda:hover,
  .enlace-leyenda:focus-visible {
    background: var(--color-superficie-hover);
  }
  .enlace-leyenda .et {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  /* Pista con relleno interior: los segmentos son píldoras dentro de la pista */
  .apilada {
    display: flex;
    height: 28px;
    gap: 3px;
    padding: 4px;
    border-radius: 999px;
    background: var(--color-superficie-hover);
  }
  .seg {
    min-width: 14px;
    border-radius: 999px;
    transform-origin: left;
    animation: a-crecer-x 700ms var(--curva) both;
    animation-delay: 150ms;
  }
  .presente {
    background: var(--color-exito);
  }
  .tarde {
    background: var(--color-alerta);
  }
  .falta {
    background: repeating-linear-gradient(135deg, var(--color-error) 0 6px, #ef4444 6px 10px);
  }
  .permiso {
    background: #94a3b8;
  }
  .pendiente,
  .vacio {
    background: repeating-linear-gradient(
      90deg,
      var(--color-borde) 0 6px,
      var(--color-superficie-hover) 6px 12px
    );
  }
  .leyenda {
    display: flex;
    flex-wrap: wrap;
    gap: var(--esp-2) var(--esp-6);
    margin: var(--esp-4) 0 0;
    padding: 0;
    list-style: none;
    font-size: var(--texto-sm);
  }
  .leyenda li {
    display: flex;
    align-items: center;
    gap: var(--esp-2);
  }
  .m {
    flex: none;
    width: 12px;
    height: 12px;
    border-radius: 3px;
  }
  .et {
    color: var(--color-texto-suave);
    white-space: nowrap;
  }
  strong {
    font-variant-numeric: tabular-nums;
  }
  .pc {
    color: var(--color-texto-suave);
    font-size: var(--texto-xs);
  }
</style>
