---
/**
 * Barras horizontales con etiqueta y valor escritos (no dependen del color).
 * Ideal para comparar categorías o días.
 */
interface Item {
  etiqueta: string;
  valor: number;
  texto?: string; // valor formateado (por defecto "valor%")
  detalle?: string; // texto secundario
  color?: string;
  resaltar?: boolean;
}
interface Props {
  items: Item[];
  maximo?: number;
}
const { items, maximo } = Astro.props;
const max = maximo ?? Math.max(1, ...items.map((i) => i.valor));
---

<ul class="barras">
  {items.map((i) => (
    <li class:list={[i.resaltar && "resaltada"]}>
      <div class="fila">
        <span class="etiqueta">
          {i.etiqueta}
          {i.detalle && <small>{i.detalle}</small>}
        </span>
        <span class="valor">{i.texto ?? `${i.valor}%`}</span>
      </div>
      <div class="pista" aria-hidden="true">
        <div
          class="relleno"
          style={`width: ${Math.max(1, (i.valor / max) * 100)}%; ${i.color ? `--c: ${i.color}` : ""}`}
        />
      </div>
    </li>
  ))}
</ul>

<style>
  .barras {
    display: grid;
    gap: var(--esp-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .fila {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--esp-3);
    margin-bottom: 6px;
    font-size: var(--texto-sm);
  }
  .etiqueta {
    display: flex;
    gap: var(--esp-2);
    align-items: baseline;
    min-width: 0;
  }
  .etiqueta small {
    color: var(--color-texto-suave);
  }
  .valor {
    font-weight: var(--peso-fuerte);
    font-variant-numeric: tabular-nums;
  }
  .pista {
    height: 10px;
    border-radius: 999px;
    background: var(--color-superficie-hover);
    overflow: hidden;
  }
  .relleno {
    --c: var(--color-acento);
    height: 100%;
    border-radius: 999px;
    background: var(--c);
    transition: width var(--duracion) var(--curva);
  }
  .resaltada .valor {
    color: var(--color-error);
  }
  .resaltada .relleno {
    background: repeating-linear-gradient(
      135deg,
      var(--c) 0 6px,
      color-mix(in srgb, var(--c) 60%, white) 6px 10px
    );
  }
</style>
