---
/**
 * Barras horizontales con etiqueta y valor escritos (no dependen del color).
 * Ideal para comparar categorías o días.
 */
import { lecturaPorcentaje } from "@/lib/reglas/estadisticas";
interface Item {
  etiqueta: string;
  valor: number;
  texto?: string; // valor formateado (por defecto "valor%")
  detalle?: string; // texto secundario
  color?: string;
  resaltar?: boolean;
  /** Destino al tocar la barra (D-56: todo dato que resume lleva a su detalle) */
  href?: string;
}
interface Props {
  items: Item[];
  maximo?: number;
  /** Colorear por lectura (Bien/Atención/Bajo); el color propio queda como punto junto al nombre. */
  lectura?: boolean;
}
const { items, maximo, lectura = false } = Astro.props;
const max = maximo ?? Math.max(1, ...items.map((i) => i.valor));
---

<ul class="barras">
  {items.map((i, n) => (
    <li
      class:list={[i.resaltar && "resaltada", lectura && lecturaPorcentaje(i.valor)]}
      style={`--i: ${n}`}
    >
      <Fragment>
        {(() => {
          const contenido = (
            <>
              <div class="fila">
                <span class="etiqueta">
                  {lectura && i.color && <span class="punto" style={`background: ${i.color}`} />}
                  {i.etiqueta}
                  {i.detalle && <small>{i.detalle}</small>}
                </span>
                <span class="valor">
                  {i.texto ?? `${i.valor}%`}
                  {i.href && (
                    <svg
                      class="flecha"
                      width="16"
                      height="16"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <path d="m9 18 6-6-6-6" />
                    </svg>
                  )}
                </span>
              </div>
              <div class="pista" aria-hidden="true">
                <div
                  class="relleno"
                  style={`width: ${Math.max(1, (i.valor / max) * 100)}%; ${i.color && !lectura ? `--c: ${i.color}` : ""}`}
                />
              </div>
            </>
          );
          return i.href ? (
            <a
              class="enlace"
              href={i.href}
              aria-label={`${i.etiqueta}: ${i.texto ?? `${i.valor}%`}. Ver detalle`}
            >
              {contenido}
            </a>
          ) : (
            contenido
          );
        })()}
      </Fragment>
    </li>
  ))}
</ul>

<style>
  /* Barra que lleva a su detalle: toda la fila se toca */
  .enlace {
    display: block;
    margin: calc(-1 * var(--esp-2)) calc(-1 * var(--esp-3));
    padding: var(--esp-2) var(--esp-3);
    border-radius: var(--radio-sm);
    color: inherit;
    text-decoration: none;
    transition: background var(--duracion-rapida) var(--curva);
  }
  .enlace:hover,
  .enlace:focus-visible {
    background: var(--color-superficie-hover);
  }
  .valor {
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }
  .flecha {
    color: var(--color-acento-texto);
    transition: transform var(--duracion-rapida) var(--curva);
  }
  .enlace:hover .flecha {
    transform: translateX(3px);
  }
  /* Cada fila (etiqueta + barra) es un grupo; entre filas, separación clara. */
  .barras {
    display: flex;
    flex-direction: column;
    gap: var(--esp-6);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .fila {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--esp-3);
    margin-bottom: var(--esp-2);
    font-size: var(--texto-sm);
  }
  .etiqueta {
    display: flex;
    gap: var(--esp-2);
    align-items: baseline;
    min-width: 0;
  }
  .punto {
    flex: none;
    align-self: center;
    width: 9px;
    height: 9px;
    border-radius: 50%;
  }
  .barras {
    --c: var(--color-acento);
  }
  .bien {
    --c: var(--lectura-bien);
  }
  .atencion {
    --c: var(--lectura-atencion);
  }
  .bajo {
    --c: var(--lectura-bajo);
  }
  .etiqueta small {
    color: var(--color-texto-suave);
  }
  .valor {
    font-weight: var(--peso-fuerte);
    font-variant-numeric: tabular-nums;
  }
  .pista {
    height: 12px;
    border-radius: 999px;
    background: var(--color-superficie-hover);
    overflow: hidden;
  }
  .relleno {
    height: 100%;
    border-radius: 999px;
    background: var(--c);
    transform-origin: left;
    animation: a-crecer-x 750ms var(--curva) both;
    animation-delay: calc(150ms + var(--i) * var(--mov-desfase));
  }
  .resaltada .valor {
    color: var(--color-error);
  }
  .resaltada .relleno {
    background: repeating-linear-gradient(
      135deg,
      var(--c) 0 6px,
      color-mix(in srgb, var(--c) 60%, white) 6px 10px
    );
  }
</style>
