---
/**
 * Tendencia (0–100 %). Solo la línea y el área son SVG (se estiran con el ancho);
 * ejes, promedio, puntos y tooltips son HTML: el texto mantiene la tipografía del
 * sistema en cualquier tamaño y los puntos siguen siendo círculos.
 * Con `fecha`, la posición horizontal respeta los días reales (los fines de semana
 * dejan su hueco).
 */
interface Punto {
  etiqueta: string; // texto del eje X
  valor: number;
  fecha?: string; // AAAA-MM-DD
  detalle?: string; // segunda línea del tooltip
}
interface Props {
  puntos: Punto[];
  /** Línea de referencia horizontal (p. ej. el promedio). */
  referencia?: { valor: number; etiqueta: string };
  /** Formato del valor en tooltips y etiquetas. */
  formato?: (v: number) => string;
}
const { puntos, referencia, formato = (v: number) => `${Math.round(v)} %` } = Astro.props;

// Eje Y ajustado a los datos en pasos de 5 (siempre rotulado: no exagera sin avisar)
const menor = Math.min(...puntos.map((p) => p.valor), referencia?.valor ?? 100);
const yMin = Math.max(0, Math.floor((menor - 2) / 5) * 5);
const yMax = 100;
const yPct = (v: number) => ((yMax - v) / (yMax - yMin)) * 100; // 0 arriba, 100 abajo
// marca intermedia redondeada a 5 (p. ej. 45–100 → 70)
const marcas = [yMax, yMin + Math.round((yMax - yMin) / 2 / 5) * 5, yMin];

// Eje X: por fecha real si existe; si no, por posición
const dias = (f: string) => Date.parse(`${f}T00:00:00Z`) / 86_400_000;
const conFecha = puntos.every((p) => p.fecha);
const inicio = conFecha && puntos.length ? dias(puntos[0]!.fecha!) : 0;
const fin = conFecha && puntos.length ? dias(puntos[puntos.length - 1]!.fecha!) : puntos.length - 1;
const xPct = (p: Punto, i: number) => {
  const v = conFecha ? dias(p.fecha!) : i;
  return fin === inicio ? 50 : ((v - inicio) / (fin - inicio)) * 100;
};

const coords = puntos.map((p, i) => ({ ...p, x: xPct(p, i), y: yPct(p.valor) }));

// Curva suave monótona (Fritsch–Carlson): no inventa picos entre dos días
const P = coords.map((c) => ({ x: c.x * 10, y: c.y }));
function curvaMonotona(pts: { x: number; y: number }[]): string {
  const n = pts.length;
  if (!n) return "";
  if (n === 1) return `M${pts[0]!.x},${pts[0]!.y}`;
  const d: number[] = [];
  const m: number[] = [];
  for (let i = 0; i < n - 1; i++) {
    const dx = pts[i + 1]!.x - pts[i]!.x || 1e-6;
    d.push((pts[i + 1]!.y - pts[i]!.y) / dx);
  }
  m.push(d[0]!);
  for (let i = 1; i < n - 1; i++) m.push(d[i - 1]! * d[i]! <= 0 ? 0 : (d[i - 1]! + d[i]!) / 2);
  m.push(d[n - 2]!);
  for (let i = 0; i < n - 1; i++) {
    if (d[i] === 0) {
      m[i] = 0;
      m[i + 1] = 0;
      continue;
    }
    const a = m[i]! / d[i]!;
    const b = m[i + 1]! / d[i]!;
    const h = a * a + b * b;
    if (h > 9) {
      const t = 3 / Math.sqrt(h);
      m[i] = t * a * d[i]!;
      m[i + 1] = t * b * d[i]!;
    }
  }
  let ruta = `M${pts[0]!.x.toFixed(1)},${pts[0]!.y.toFixed(2)}`;
  for (let i = 0; i < n - 1; i++) {
    const p0 = pts[i]!;
    const p1 = pts[i + 1]!;
    const dx = (p1.x - p0.x) / 3;
    ruta += ` C${(p0.x + dx).toFixed(1)},${(p0.y + m[i]! * dx).toFixed(2)} ${(p1.x - dx).toFixed(1)},${(p1.y - m[i + 1]! * dx).toFixed(2)} ${p1.x.toFixed(1)},${p1.y.toFixed(2)}`;
  }
  return ruta;
}
const linea = curvaMonotona(P);
const area = P.length
  ? `${linea} L${P[P.length - 1]!.x.toFixed(1)},100 L${P[0]!.x.toFixed(1)},100 Z`
  : "";

// Franjas de lectura (D-53): Bien ≥ 90 %, Atención 80–89 %, Bajo < 80 %; solo las visibles
const franjas = [
  { clase: "bien", desde: 90, hasta: 100, texto: "Bien" },
  { clase: "atencion", desde: 80, hasta: 90, texto: "Atención" },
  { clase: "bajo", desde: 0, hasta: 80, texto: "Bajo" },
]
  .map((f) => ({ ...f, desde: Math.max(f.desde, yMin), hasta: Math.min(f.hasta, yMax) }))
  .filter((f) => f.hasta > f.desde);

// Etiquetas X: como mucho 6, repartidas; siempre la primera y la última
const maxEtiquetas = 6;
const paso = Math.max(1, Math.ceil(coords.length / maxEtiquetas));
const etiquetasX = coords.filter(
  (_, i) =>
    i === 0 || i === coords.length - 1 || (i % paso === 0 && coords.length - 1 - i >= paso / 2),
);
const ultimo = coords[coords.length - 1];
const nivel = (v: number) => (v >= 90 ? "alto" : v >= 80 ? "medio" : "bajo");
---

<div
  class="tendencia"
  role="img"
  aria-label="Gráfica de tendencia de asistencia; los datos están en «Ver datos»"
>
  <div class="eje-y" aria-hidden="true">
    {marcas.map((m) => (
      <span style={`top: ${yPct(m)}%`}>{m}%</span>
    ))}
  </div>

  <div class="trazado">
    {franjas.map((f) => (
      <span
        class:list={["franja", f.clase]}
        style={`top: ${yPct(f.hasta)}%; height: ${yPct(f.desde) - yPct(f.hasta)}%`}
        aria-hidden="true"
      ></span>
    ))}
    {marcas.map((m) => (
      <span class="rejilla" style={`top: ${yPct(m)}%`} aria-hidden="true" />
    ))}

    <svg viewBox="0 0 1000 100" preserveAspectRatio="none" aria-hidden="true">
      <defs>
        <linearGradient id="relleno-tendencia" x1="0" x2="0" y1="0" y2="1">
          <stop offset="0" stop-color="var(--color-acento)" stop-opacity="0.24" />
          <stop offset="1" stop-color="var(--color-acento)" stop-opacity="0" />
        </linearGradient>
      </defs>
      <path d={area} fill="url(#relleno-tendencia)" />
      <path d={linea} class="trazo" vector-effect="non-scaling-stroke" />
    </svg>

    {referencia && (
      <div class="referencia" style={`top: ${yPct(referencia.valor)}%`} aria-hidden="true" />
    )}

    {coords.map((c, i) => (
      <span
        class:list={[
          "punto",
          nivel(c.valor),
          i === coords.length - 1 && "ultimo",
          c.x > 70 && "a-la-izquierda",
        ]}
        style={`left: ${c.x}%; top: ${c.y}%; --y: ${c.y}; --i: ${Math.min(i, 30)}`}
        tabindex="0"
        aria-label={`${c.etiqueta}: ${formato(c.valor)}`}
      >
        <span class="globo" role="tooltip">
          <strong>{formato(c.valor)}</strong>
          <span>{c.detalle ?? c.etiqueta}</span>
        </span>
      </span>
    ))}

    {ultimo && (
      <span class="valor-final" style={`left: ${ultimo.x}%; top: ${ultimo.y}%`} aria-hidden="true">
        {formato(ultimo.valor)}
      </span>
    )}
  </div>

  <div class="eje-ref" aria-hidden="true">
    {referencia && <span style={`top: ${yPct(referencia.valor)}%`}>{referencia.etiqueta}</span>}
  </div>

  <div class="eje-x" aria-hidden="true">
    {etiquetasX.map((c, i) => (
      <span
        class:list={[
          i === 0 && "primera",
          i === etiquetasX.length - 1 && "final",
          i > 0 && i < etiquetasX.length - 1 && (ultimo?.x ?? 100) - c.x < 15 && "cerca-borde",
        ]}
        style={`left: ${c.x}%`}
      >
        {c.etiqueta}
      </span>
    ))}
  </div>
  {franjas.length > 0 && (
    <p class="leyenda-franjas">
      Fondo:{" "}
      {franjas.map((f, i) => (
        <span class={f.clase}>
          {i > 0 && " · "}
          {f.texto.toLowerCase()}
        </span>
      ))}
    </p>
  )}
</div>

<style>
  .tendencia {
    --alto: 220px;
    display: grid;
    grid-template-columns: 2.75rem 1fr auto;
    grid-template-rows: var(--alto) auto;
    column-gap: var(--esp-2);
    padding-top: var(--esp-6); /* espacio para el valor final y los globos */
    font-size: var(--texto-xs);
    color: var(--color-texto-suave);
    font-variant-numeric: tabular-nums;
  }

  /* Eje Y */
  .eje-y {
    position: relative;
  }
  .eje-y span {
    position: absolute;
    right: 0;
    transform: translateY(-50%);
    line-height: 1;
  }

  /* Área de trazado */
  .trazado {
    position: relative;
    isolation: isolate;
    margin-inline: 6px; /* los puntos de los extremos no se cortan */
  }
  .rejilla {
    position: absolute;
    left: -6px;
    right: -6px;
    border-top: 1px dashed var(--color-borde);
  }
  .rejilla:last-of-type {
    border-top-color: var(--color-borde-fuerte);
  }
  svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    animation: a-revelar var(--mov-grafica) var(--curva) both;
    animation-delay: 150ms;
  }
  /* Franjas de lectura: fondo muy suave con su nombre */
  .franja {
    position: absolute;
    left: 0;
    right: 0;
    animation: a-aparecer 500ms var(--curva) both;
  }
  .leyenda-franjas {
    grid-column: 2;
    margin: var(--esp-2) 0 0;
    font-size: var(--texto-xs);
  }
  .leyenda-franjas .bien {
    color: #166534;
  }
  .leyenda-franjas .atencion {
    color: #92400e;
  }
  .leyenda-franjas .bajo {
    color: #991b1b;
  }
  .franja.bien {
    background: color-mix(in srgb, var(--lectura-bien) 6%, transparent);
    color: #166534;
  }
  .franja.atencion {
    background: color-mix(in srgb, var(--lectura-atencion) 7%, transparent);
    color: var(--lectura-atencion);
  }
  .franja.bajo {
    background: color-mix(in srgb, var(--lectura-bajo) 6%, transparent);
    color: var(--lectura-bajo);
  }
  .trazo {
    fill: none;
    stroke: var(--color-acento);
    stroke-width: 3;
    stroke-linejoin: round;
    stroke-linecap: round;
  }

  /* Promedio: línea discreta con su etiqueta al final, fuera del trazo */
  .referencia {
    position: absolute;
    left: -6px;
    right: -14px;
    border-top: 1.5px dashed var(--color-texto-tenue);
  }
  /* Etiqueta del promedio en su propia columna: nunca tapa la línea */
  .eje-ref {
    position: relative;
    width: 5.25rem;
  }
  .eje-ref span {
    position: absolute;
    left: 0;
    transform: translateY(-50%);
    padding: 4px 10px;
    border-radius: 999px;
    background: var(--color-superficie-hover);
    color: var(--color-texto-suave);
    font-weight: var(--peso-medio);
    white-space: nowrap;
  }

  /* Puntos (HTML: siempre redondos) con zona de toque generosa */
  .punto {
    position: absolute;
    width: 28px;
    height: 28px;
    margin: -14px 0 0 -14px;
    border-radius: 50%;
    cursor: default;
    outline-offset: -6px;
    animation: a-surgir 380ms var(--curva-salida) both;
    animation-delay: calc(500ms + var(--i) * 25ms);
  }
  /* Línea guía vertical al pasar el mouse por un día */
  .punto::after {
    content: "";
    position: absolute;
    left: 13px;
    top: calc(14px - var(--alto) * var(--y) / 100);
    width: 2px;
    height: var(--alto);
    background: color-mix(in srgb, var(--color-acento) 25%, transparent);
    opacity: 0;
    z-index: -1;
    transition: opacity var(--duracion-rapida) var(--curva);
    pointer-events: none;
  }
  .punto:hover::after,
  .punto:focus-visible::after {
    opacity: 1;
  }
  .punto::before {
    content: "";
    position: absolute;
    inset: 9px;
    border-radius: 50%;
    background: var(--color-superficie);
    border: 2px solid var(--color-acento);
    transition: transform var(--duracion-rapida) var(--curva);
  }
  .punto.medio::before {
    border-color: var(--lectura-atencion);
  }
  .punto.bajo::before {
    border-color: var(--lectura-bajo);
    background: var(--lectura-bajo);
  }
  .punto.ultimo::before {
    inset: 7px;
    background: var(--color-acento);
    box-shadow: 0 0 0 5px rgb(37 99 235 / 0.18);
  }
  .punto:hover::before,
  .punto:focus-visible::before {
    transform: scale(1.35);
  }

  /* Tooltip */
  .globo {
    position: absolute;
    bottom: calc(100% + 2px);
    left: 50%;
    z-index: 3;
    display: grid;
    gap: 2px;
    min-width: max-content;
    padding: var(--esp-2) var(--esp-3);
    border-radius: var(--radio-sm);
    background: var(--color-primario);
    color: var(--color-primario-contraste);
    font-size: var(--texto-xs);
    line-height: 1.35;
    box-shadow: var(--sombra-lg);
    transform: translate(-50%, 4px);
    opacity: 0;
    pointer-events: none;
    transition:
      opacity var(--duracion-rapida) var(--curva),
      transform var(--duracion-rapida) var(--curva);
  }
  .globo strong {
    font-size: var(--texto-sm);
  }
  .globo span {
    opacity: 0.8;
  }
  .a-la-izquierda .globo {
    left: auto;
    right: 50%;
    transform: translate(14px, 4px);
  }
  .punto:hover .globo,
  .punto:focus-visible .globo {
    opacity: 1;
    transform: translate(-50%, 0);
  }
  .a-la-izquierda:hover .globo,
  .a-la-izquierda:focus-visible .globo {
    transform: translate(14px, 0);
  }

  /* Valor del último día, siempre visible */
  .valor-final {
    position: absolute;
    transform: translate(-50%, calc(-100% - 12px));
    padding: 3px 8px;
    border-radius: 6px;
    background: var(--color-acento);
    color: #fff;
    font-weight: var(--peso-fuerte);
    white-space: nowrap;
    pointer-events: none;
    animation: a-subir 400ms var(--curva-salida) both;
    animation-delay: 1000ms;
  }
  .trazado:has(.punto:hover, .punto:focus-visible) .valor-final {
    opacity: 0;
  }

  /* Eje X */
  .eje-x {
    grid-column: 2;
    position: relative;
    height: 1.5rem;
    margin: var(--esp-2) 6px 0;
  }
  .eje-x span {
    position: absolute;
    top: 0;
    transform: translateX(-50%);
    white-space: nowrap;
  }
  .eje-x .primera {
    transform: translateX(-6px);
  }
  .eje-x .final {
    transform: translateX(calc(-100% + 6px));
  }

  /* Celular: sin columna del promedio (ya está en el título de la sección)
     y la mitad de las fechas del eje X */
  @media (max-width: 600px) {
    .tendencia {
      --alto: 180px;
      grid-template-columns: 2.25rem 1fr;
    }
    .eje-ref {
      display: none;
    }
    .referencia {
      right: -6px;
    }
    .eje-x span:nth-child(even):not(.final),
    .eje-x .cerca-borde {
      display: none;
    }
  }
</style>
