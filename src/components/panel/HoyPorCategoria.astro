---
/** Llegadas de hoy por categoría: «llegaron / esperados» con una barra fina. */
interface Fila {
  nombre: string;
  color: string;
  llegaron: number;
  esperados: number;
  /** Destino al tocar la fila (D-56) */
  href?: string;
}
interface Props {
  filas: Fila[];
}
const { filas } = Astro.props;
---

{filas.length ? (
  <ul class="lista-llegadas">
    {filas.map((f) => {
      const completo = f.llegaron >= f.esperados;
      return (
        <li style={`--c: ${f.color}`} class:list={[f.href && "con-enlace"]}>
          {f.href ? (
            <a class="nombre" href={f.href}>
              {f.nombre}
            </a>
          ) : (
            <span class="nombre">{f.nombre}</span>
          )}
          <span class:list={["cifra", completo && "completo"]}>
            <strong>{f.llegaron}</strong>/{f.esperados}
          </span>
          <span class="pista" aria-hidden="true">
            <span
              class="relleno"
              style={`width: ${f.esperados ? (f.llegaron / f.esperados) * 100 : 0}%`}
            />
          </span>
        </li>
      );
    })}
  </ul>
) : (
  <p class="vacio">Nadie tiene jornada hoy.</p>
)}

<style>
  .con-enlace {
    position: relative;
  }
  /* Toda la fila se toca; el enlace es el nombre */
  a.nombre {
    color: inherit;
    font-weight: var(--peso-medio);
  }
  a.nombre::after {
    content: "";
    position: absolute;
    inset: -4px -8px;
    border-radius: var(--radio-sm);
  }
  .con-enlace:hover {
    background: var(--color-superficie-hover);
    border-radius: var(--radio-sm);
  }
  .lista-llegadas {
    display: flex;
    flex-direction: column;
    gap: var(--esp-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  li {
    display: grid;
    grid-template-columns: 1fr auto;
    row-gap: 6px;
    font-size: var(--texto-sm);
  }
  .nombre {
    color: var(--color-texto);
  }
  .cifra {
    color: var(--color-texto-suave);
    font-variant-numeric: tabular-nums;
  }
  .cifra strong {
    color: var(--color-texto);
  }
  .completo strong {
    color: var(--color-exito);
  }
  .pista {
    grid-column: 1 / -1;
    height: 6px;
    border-radius: 999px;
    background: var(--color-superficie-hover);
    overflow: hidden;
  }
  .relleno {
    display: block;
    height: 100%;
    border-radius: 999px;
    background: var(--c);
    transform-origin: left;
    animation: a-crecer-x 700ms var(--curva) both;
    animation-delay: 150ms;
  }
  .vacio {
    margin: 0;
    font-size: var(--texto-sm);
    color: var(--color-texto-suave);
  }
</style>
