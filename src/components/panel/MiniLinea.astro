---
/**
 * Línea mínima sin ejes para la vista Resumen (D-54). La escala se ajusta al
 * rango real para que se vea la forma; el valor exacto va en el punto final.
 */
interface Props {
  valores: number[];
  /** Texto del último valor */
  final?: string;
}
const { valores, final } = Astro.props;
const n = valores.length;
const min = Math.max(0, Math.min(...valores) - 3);
const max = Math.min(100, Math.max(...valores) + 3);
const rango = Math.max(1, max - min);
const pts = valores.map((v, i) => ({
  x: n > 1 ? (i / (n - 1)) * 100 : 50,
  y: 36 - ((v - min) / rango) * 30,
}));
// Curva suave (Catmull-Rom → Bézier), sin pasarse de los puntos en tramos cortos
const curva = pts.reduce((d, p, i, a) => {
  if (i === 0) return `M${p.x},${p.y}`;
  const p0 = a[i - 2] ?? a[i - 1]!;
  const p1 = a[i - 1]!;
  const p3 = a[i + 1] ?? p;
  const c1 = `${p1.x + (p.x - p0.x) / 6},${p1.y + (p.y - p0.y) / 6}`;
  const c2 = `${p.x - (p3.x - p1.x) / 6},${p.y - (p3.y - p1.y) / 6}`;
  return `${d} C${c1} ${c2} ${p.x},${p.y}`;
}, "");
const ultimo = pts[n - 1];
const id = `mini-${Math.random().toString(36).slice(2, 8)}`;
---

{n > 1 && (
  <span class="mini">
    {final && <span class="valor">{final}</span>}
    <svg viewBox="0 0 100 40" preserveAspectRatio="none">
      <defs>
        <linearGradient id={id} x1="0" x2="0" y1="0" y2="1">
          <stop offset="0" stop-color="var(--color-exito)" stop-opacity="0.22" />
          <stop offset="1" stop-color="var(--color-exito)" stop-opacity="0" />
        </linearGradient>
      </defs>
      <path d={`${curva} L100,40 L0,40 Z`} fill={`url(#${id})`} />
      <path d={curva} class="trazo" vector-effect="non-scaling-stroke" />
    </svg>
    {ultimo && (
      <span class="fin" style={`top: calc(26px + ${(ultimo.y / 40).toFixed(3)} * (100% - 26px))`} />
    )}
  </span>
)}

<style>
  /* La etiqueta del último valor va en su propia franja, encima de la línea */
  .mini {
    position: relative;
    display: block;
    height: 86px;
    padding-top: 26px;
    margin-right: 6px;
  }
  svg {
    position: relative;
    z-index: 0;
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
    animation: a-revelar var(--mov-grafica) var(--curva) both;
    animation-delay: 200ms;
  }
  .trazo {
    fill: none;
    stroke: var(--color-exito);
    stroke-width: 2.5;
    stroke-linejoin: round;
    stroke-linecap: round;
  }
  .fin {
    position: absolute;
    z-index: 1;
    right: -6px;
    width: 12px;
    height: 12px;
    margin-top: -6px;
    border-radius: 50%;
    background: var(--color-exito);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--color-exito) 20%, transparent);
    animation: a-surgir 400ms var(--curva-salida) both;
    animation-delay: 1000ms;
  }
  .valor {
    position: absolute;
    top: 0;
    right: -6px;
    animation: a-aparecer 400ms var(--curva) both;
    animation-delay: 1000ms;
    padding: 3px 8px;
    border-radius: 6px;
    background: var(--color-exito);
    color: #fff;
    font-size: var(--texto-xs);
    font-weight: var(--peso-fuerte);
    white-space: nowrap;
  }
</style>
