---
/**
 * Módulo del panel en vista Resumen (D-53): una frase en palabras, una cifra y
 * una mini gráfica. Todo el módulo se toca para abrir su segunda capa.
 */
import Icono, { type NombreIcono } from "@/components/ui/Icono.astro";
import { NOMBRE_LECTURA, type Lectura } from "@/lib/reglas/estadisticas";

interface Props {
  titulo: string;
  icono: NombreIcono;
  frase: string;
  detalle?: string;
  lectura?: Lectura;
  /** id del <template> con la segunda capa */
  capa?: string;
  /** Enlace en lugar de la segunda capa */
  href?: string;
  /** Color de la pastilla del ícono */
  tono?: "azul" | "verde" | "ambar" | "violeta" | "rosa" | "cian";
  /** Posición en la cuadrícula (escalona la entrada) */
  orden?: number;
}
const {
  titulo,
  icono,
  frase,
  detalle,
  lectura,
  capa,
  href,
  tono = "azul",
  orden = 0,
} = Astro.props;
// La frase puede venir con cifras animadas (slot "frase"); si el slot queda vacío, se usa el texto
const fraseHtml = Astro.slots.has("frase") ? (await Astro.slots.render("frase")).trim() : "";
---

<a
  class:list={["modulo", tono]}
  style={`--i: ${orden}`}
  href={href ?? `#${capa}`}
  data-ventana-local={capa}
  aria-label={`${titulo}: ${frase}${detalle ? `. ${detalle}` : ""}. Ver detalle`}
>
  <span class="cabeza">
    <span class="titulo">
      <span class="pastilla" aria-hidden="true">
        <Icono nombre={icono} tamano={18} />
      </span>
      {titulo}
    </span>
    {lectura && (
      <span class:list={["lectura", lectura]}>
        <span class="punto" aria-hidden="true" />
        {NOMBRE_LECTURA[lectura]}
      </span>
    )}
  </span>
  <span class="frase">{fraseHtml ? <Fragment set:html={fraseHtml} /> : frase}</span>
  {detalle && <span class="detalle">{detalle}</span>}
  <span class="grafica" aria-hidden="true">
    <slot />
  </span>
  <span class="ver" aria-hidden="true">
    Ver detalle{" "}
    <span class="flecha">
      <Icono nombre="siguiente" tamano={16} />
    </span>
  </span>
</a>

<style>
  .modulo {
    display: flex;
    flex-direction: column;
    gap: var(--esp-2);
    min-height: 13rem;
    padding: var(--esp-5);
    background: var(--color-superficie);
    border: 1px solid var(--color-borde);
    border-radius: var(--radio);
    color: var(--color-texto);
    text-decoration: none;
    animation: a-subir var(--mov-entrada) var(--curva-salida) both;
    animation-delay: calc(var(--i) * var(--mov-desfase));
    transition:
      border-color var(--duracion-rapida) var(--curva),
      transform var(--duracion) var(--curva);
  }
  .modulo:hover,
  .modulo:focus-visible {
    border-color: var(--color-acento);
    transform: translateY(-3px);
  }
  .modulo:active {
    transform: translateY(-1px);
  }
  .modulo {
    --tono: var(--color-acento);
  }
  .verde {
    --tono: var(--color-exito);
  }
  .ambar {
    --tono: var(--color-alerta);
  }
  .violeta {
    --tono: #7c3aed;
  }
  .rosa {
    --tono: #db2777;
  }
  .cian {
    --tono: #0e7490;
  }
  .pastilla {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 10px;
    background: color-mix(in srgb, var(--tono) 12%, white);
    color: var(--tono);
    transition: transform var(--duracion) var(--curva-salida);
  }
  .modulo:hover .pastilla {
    transform: rotate(-6deg) scale(1.08);
  }
  .cabeza {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--esp-2);
  }
  .titulo {
    display: inline-flex;
    align-items: center;
    gap: var(--esp-2);
    color: var(--color-texto-suave);
    font-size: var(--texto-sm);
    font-weight: var(--peso-medio);
  }
  .lectura {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 5px var(--esp-3);
    border-radius: 999px;
    font-size: var(--texto-sm);
    font-weight: var(--peso-fuerte);
  }
  .lectura .punto {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: currentColor;
  }
  .lectura.bien {
    background: var(--color-exito-suave);
    color: var(--color-exito);
  }
  .lectura.atencion {
    background: var(--color-alerta-suave);
    color: var(--color-alerta);
  }
  .lectura.bajo {
    background: var(--color-error-suave);
    color: var(--color-error);
  }
  /* La cifra que cuenta se destaca dentro de la frase */
  .frase :global(.contador) {
    font-size: var(--texto-3xl);
    line-height: 1;
    letter-spacing: -0.02em;
  }
  .frase {
    font-size: var(--texto-xl);
    letter-spacing: -0.01em;
    font-weight: var(--peso-titulo);
    line-height: 1.25;
  }
  .detalle {
    color: var(--color-texto-suave);
    font-size: var(--texto-sm);
  }
  .grafica {
    display: block;
    margin-top: auto;
    padding-top: var(--esp-3);
  }
  .grafica:empty {
    display: none;
  }
  .flecha {
    display: inline-flex;
    transition: transform var(--duracion) var(--curva);
  }
  .modulo:hover .flecha {
    transform: translateX(4px);
  }
  .ver {
    display: inline-flex;
    align-items: center;
    gap: var(--esp-1);
    color: var(--color-acento-texto);
    font-size: var(--texto-sm);
    font-weight: var(--peso-medio);
  }
</style>
