---
import Input from "@/components/ui/Input.astro";
import Select from "@/components/ui/Select.astro";
import { NOMBRE_ROL, ROLES } from "@/types";

interface Props {
  valores: Record<string, string | undefined>;
  errores?: Record<string, string>;
  claveSugerida: string;
  conRol?: boolean;
}
const { valores: v, errores: e = {}, claveSugerida, conRol = true } = Astro.props;
---

<div class="rejilla">
  <Input
    etiqueta="Correo"
    nombre="email"
    type="email"
    value={v.email ?? ""}
    error={e.email}
    autocomplete="off"
    ayuda="Con este correo iniciará sesión."
  />
  <Input
    etiqueta="Contraseña temporal"
    nombre="password"
    type="text"
    value={v.password ?? claveSugerida}
    error={e.password}
    autocomplete="off"
    ayuda="Mínimo 8 caracteres con letras y números. Entréguela a la persona."
  />
  {conRol && (
    <Select
      etiqueta="Rol"
      nombre="rol"
      valor={v.rol ?? "personal"}
      error={e.rol}
      opciones={ROLES.map((r) => ({ valor: r, texto: NOMBRE_ROL[r] }))}
      ayuda="Personal: solo marca su asistencia. Secretaría y Directiva: acceso al PC de administración."
    />
  )}
</div>

<style>
  .rejilla {
    display: grid;
    gap: var(--esp-4);
  }
  @media (min-width: 768px) {
    .rejilla {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
