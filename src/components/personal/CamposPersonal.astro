---
/**
 * Campos de la ficha de personal en la rejilla de 12 columnas (D-52): cada
 * campo con el ancho de su dato; categoría y vínculo con botones.
 */
import Input from "@/components/ui/Input.astro";
import Select from "@/components/ui/Select.astro";
import type { FilaJornada } from "@/lib/datos/jornadas";
import { resumenDias } from "@/lib/datos/jornadas";
import { horaCorta } from "@/lib/fecha";
import { NOMBRE_VINCULO, VINCULOS, type Categoria } from "@/types";

interface Props {
  valores: Record<string, string | number | null | undefined>;
  errores?: Record<string, string>;
  jornadas: FilaJornada[];
  categorias: Categoria[];
}
const { valores: v, errores: e = {}, jornadas, categorias } = Astro.props;
const val = (k: string) => (v[k] === null || v[k] === undefined ? "" : String(v[k]));
const vinculo = val("vinculo") || "fijo";
---

<fieldset class="seccion">
  <legend>Identificación</legend>
  <div class="campos">
    <Input
      class="c-largo"
      etiqueta="Nombre(s)"
      nombre="nombre"
      value={val("nombre")}
      error={e.nombre}
      required
      maxlength={80}
      autocomplete="off"
    />
    <Input
      class="c-largo"
      etiqueta="Apellido(s)"
      nombre="apellido"
      value={val("apellido")}
      error={e.apellido}
      required
      maxlength={80}
      autocomplete="off"
    />
    <Input
      class="c-medio"
      etiqueta="Cédula"
      nombre="cedula"
      value={val("cedula")}
      error={e.cedula}
      required
      ayuda="Ejemplo: V-12345678"
      autocomplete="off"
      inputmode="text"
      data-formato="cedula"
    />
    <Input
      class="c-medio"
      etiqueta="Teléfono"
      nombre="telefono"
      type="tel"
      inputmode="tel"
      value={val("telefono")}
      error={e.telefono}
      ayuda="Opcional. 0414-1234567"
    />
  </div>
</fieldset>

<fieldset class="seccion">
  <legend>Trabajo</legend>
  <div class="campos">
    <fieldset class="opciones-campo c-completo">
      <legend>
        Categoría{" "}
        <span class="obligatorio" aria-hidden="true">
          *
        </span>
      </legend>
      <div class="v-chips">
        {categorias
          .filter((c) => c.activa || c.id === val("categoria_id"))
          .map((c) => (
            <label>
              <input
                type="radio"
                name="categoria_id"
                value={c.id}
                checked={c.id === val("categoria_id")}
                data-jornada={c.jornada_sugerida_id ?? undefined}
              />
              {c.nombre}
            </label>
          ))}
      </div>
      {e.categoria_id && <small class="error">{e.categoria_id}</small>}
    </fieldset>
    <fieldset class="opciones-campo c-largo">
      <legend>Vínculo</legend>
      <div class="v-chips">
        {VINCULOS.map((x) => (
          <label>
            <input type="radio" name="vinculo" value={x} checked={x === vinculo} />
            {NOMBRE_VINCULO[x]}
          </label>
        ))}
      </div>
      {e.vinculo && <small class="error">{e.vinculo}</small>}
    </fieldset>
    <Input
      class="c-corto"
      etiqueta="Carga semanal (h)"
      nombre="carga_horaria"
      type="number"
      inputmode="numeric"
      min="1"
      max="80"
      value={val("carga_horaria")}
      error={e.carga_horaria}
      ayuda="Sale en la planilla."
    />
    <Input
      class="c-corto"
      etiqueta="Fecha de ingreso"
      nombre="fecha_ingreso"
      type="date"
      value={val("fecha_ingreso")}
      error={e.fecha_ingreso}
      ayuda="Opcional"
    />
    <Select
      class="c-ancho"
      etiqueta="Jornada"
      nombre="jornada_id"
      valor={val("jornada_id")}
      error={e.jornada_id}
      vacia="Sin asignar"
      ayuda="Al elegir la categoría se propone su jornada habitual."
      opciones={jornadas.map((j) => ({
        valor: j.id,
        texto: `${j.nombre} · ${horaCorta(j.hora_entrada)}–${horaCorta(j.hora_salida)}${j.nocturna ? " (nocturna)" : ""} · ${resumenDias(j.dias_laborables)}${j.activa ? "" : " (inactiva)"}`,
      }))}
    />
  </div>
</fieldset>

<style>
  .seccion {
    margin: 0 0 var(--esp-8);
    padding: 0;
    border: 0;
    min-width: 0;
  }
  .seccion:last-of-type {
    margin-bottom: 0;
  }
  .seccion > legend {
    padding: 0;
    margin-bottom: var(--esp-3);
    font-size: var(--texto-base);
    font-weight: var(--peso-fuerte);
    color: var(--color-texto);
  }
  .obligatorio {
    color: var(--color-error);
  }
</style>
