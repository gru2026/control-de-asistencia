---
import Icono from "./Icono.astro";

interface Props {
  tipo?: "exito" | "error" | "info" | "alerta";
}
const { tipo = "info" } = Astro.props;
---

<div class:list={["aviso", `aviso-${tipo}`]} role={tipo === "error" ? "alert" : "status"}>
  <Icono nombre={tipo} tamano={20} class="simbolo" />
  <div class="texto">
    <slot />
  </div>
</div>

<style>
  .aviso {
    display: flex;
    gap: var(--esp-3);
    align-items: flex-start;
    padding: var(--esp-3) var(--esp-4);
    border-radius: var(--radio);
    border: 1px solid;
    font-size: var(--texto-sm);
    line-height: 1.5;
  }
  .aviso :global(.simbolo) {
    margin-top: 1px;
  }
  .texto {
    min-width: 0;
  }
  .aviso-exito {
    background: #f0fdf4;
    border-color: #bbf7d0;
  }
  .aviso-exito :global(.simbolo) {
    color: var(--color-exito);
  }
  .aviso-error {
    background: #fef2f2;
    border-color: #fecaca;
  }
  .aviso-error :global(.simbolo) {
    color: var(--color-error);
  }
  .aviso-info {
    background: var(--color-acento-suave);
    border-color: #bfdbfe;
  }
  .aviso-info :global(.simbolo) {
    color: var(--color-acento);
  }
  .aviso-alerta {
    background: #fffbeb;
    border-color: #fde68a;
  }
  .aviso-alerta :global(.simbolo) {
    color: var(--color-alerta);
  }
</style>
