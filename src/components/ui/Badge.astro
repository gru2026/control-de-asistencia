---
/** Etiqueta de estado. Siempre incluye texto (no depende solo del color). */
export type TipoBadge =
  "presente" | "tarde" | "falta" | "permiso" | "activo" | "inactivo" | "pendiente" | "info";

interface Props {
  tipo: TipoBadge;
}
const { tipo } = Astro.props;
---

<span class:list={["badge", tipo]}>
  <slot />
</span>

<style>
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 2px 10px;
    border-radius: 999px;
    font-size: var(--texto-sm);
    font-weight: 600;
    line-height: 1.6;
    border: 1px solid transparent;
  }
  .presente,
  .activo {
    background: #dcfce7;
    color: var(--color-exito);
  }
  .tarde,
  .pendiente {
    background: #fef3c7;
    color: var(--color-alerta);
  }
  .falta {
    background: #fee2e2;
    color: var(--color-error);
  }
  .permiso,
  .inactivo {
    background: #f1f5f9;
    color: var(--color-info);
    border-color: var(--color-borde);
  }
  .info {
    background: #dbeafe;
    color: #1d4ed8;
  }
</style>
