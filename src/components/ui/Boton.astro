---
import type { HTMLAttributes } from "astro/types";

type Props = (HTMLAttributes<"button"> | HTMLAttributes<"a">) & {
  variante?: "primario" | "secundario" | "peligro" | "fantasma";
  tamano?: "normal" | "pequeno" | "grande";
  href?: string;
  bloque?: boolean;
};

const {
  variante = "primario",
  tamano = "normal",
  href,
  bloque = false,
  class: clase,
  ...resto
} = Astro.props;
const clases = ["boton", variante, tamano, bloque && "bloque", clase];
---

{href ? (
  <a href={href} class:list={clases} {...(resto as HTMLAttributes<"a">)}>
    <slot />
  </a>
) : (
  <button
    class:list={clases}
    {...(resto as HTMLAttributes<"button">)}
    type={(resto as HTMLAttributes<"button">).type ?? "button"}
  >
    <slot />
  </button>
)}

<style>
  .boton {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--esp-2);
    min-height: 44px;
    padding: 0 var(--esp-5);
    border: 1px solid transparent;
    border-radius: var(--radio-sm);
    font-weight: var(--peso-fuerte);
    font-size: var(--texto-sm);
    line-height: 1.2;
    text-decoration: none;
    white-space: nowrap;
    cursor: pointer;
    transition:
      background var(--duracion-rapida) var(--curva),
      border-color var(--duracion-rapida) var(--curva),
      box-shadow var(--duracion-rapida) var(--curva),
      opacity var(--duracion-rapida) var(--curva),
      transform 80ms var(--curva);
  }
  .boton:active:not(:disabled) {
    transform: translateY(1px);
  }
  .boton:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }
  .primario {
    background: var(--color-primario);
    color: var(--color-primario-contraste);
  }
  .primario:hover:not(:disabled) {
    background: var(--color-primario-hover);
  }
  .secundario {
    background: var(--color-superficie);
    color: var(--color-texto);
    border-color: var(--color-borde-fuerte);
  }
  .secundario:hover:not(:disabled) {
    background: var(--color-superficie-hover);
  }
  .peligro {
    background: var(--color-error);
    color: #fff;
  }
  .peligro:hover:not(:disabled) {
    background: #991b1b;
  }
  .fantasma {
    background: transparent;
    color: var(--color-acento);
  }
  .fantasma:hover:not(:disabled) {
    background: var(--color-acento-suave);
  }
  .pequeno {
    min-height: 36px;
    border-radius: 6px;
    padding: 0 var(--esp-3);
    font-size: var(--texto-sm);
  }
  .grande {
    min-height: 52px;
    border-radius: var(--radio);
    font-size: var(--texto-base);
    padding: 0 var(--esp-6);
  }
  .bloque {
    width: 100%;
  }
</style>
