---
/** Etiqueta de categoría con su color (el texto siempre está presente: no depende del color). */
interface Props {
  nombre: string;
  color: string;
}
const { nombre, color } = Astro.props;
---

<span class="chip-cat" style={`--c: ${color}`}>
  <span class="punto" aria-hidden="true"></span>
  {nombre}
</span>

<style>
  .chip-cat {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 2px 10px 2px 8px;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--c) 30%, transparent);
    background: color-mix(in srgb, var(--c) 9%, white);
    color: var(--color-texto);
    font-size: var(--texto-sm);
    font-weight: var(--peso-medio);
    white-space: nowrap;
  }
  .punto {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--c);
  }
</style>
