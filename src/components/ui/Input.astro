---
import type { HTMLAttributes } from "astro/types";

type Props = Omit<HTMLAttributes<"input">, "name"> & {
  etiqueta: string;
  nombre: string;
  error?: string | undefined;
  ayuda?: string;
  /** "mostrar": botón para ver la contraseña · "copiar": botón para copiar el valor. */
  accion?: "mostrar" | "copiar";
};

const {
  etiqueta,
  nombre,
  error,
  ayuda,
  accion,
  id = `campo-${nombre}`,
  class: clase,
  ...resto
} = Astro.props;
const idAyuda = `${id}-ayuda`;
const idError = `${id}-error`;
const describe = [ayuda && idAyuda, error && idError].filter(Boolean).join(" ") || undefined;
---

<div class:list={["campo", clase]}>
  <label for={id}>
    {etiqueta}
    {resto.required && (
      <span class="obligatorio" aria-hidden="true">
        *
      </span>
    )}
  </label>
  <div class:list={["control", accion && "con-accion"]}>
    <input
      id={id}
      name={nombre}
      aria-invalid={error ? "true" : undefined}
      aria-describedby={describe}
      {...resto}
    />
    {accion === "mostrar" && (
      <button
        type="button"
        class="accion"
        data-mostrar-clave={id}
        aria-label="Mostrar contraseña"
        aria-pressed="false"
      >
        <svg
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M2.06 12.35a1 1 0 0 1 0-.7 10.75 10.75 0 0 1 19.88 0 1 1 0 0 1 0 .7 10.75 10.75 0 0 1-19.88 0" />
          <circle cx="12" cy="12" r="3" />
        </svg>
      </button>
    )}
    {accion === "copiar" && (
      <button type="button" class="accion texto" data-copiar={id}>
        Copiar
      </button>
    )}
  </div>
  {ayuda && <small id={idAyuda}>{ayuda}</small>}
  {error && (
    <small id={idError} class="error">
      {error}
    </small>
  )}
</div>

<style>
  .campo {
    display: flex;
    flex-direction: column;
    gap: var(--esp-1);
  }
  label {
    font-weight: var(--peso-medio);
    color: var(--color-texto);
    font-size: var(--texto-sm);
  }
  .obligatorio {
    color: var(--color-error);
    margin-left: 2px;
  }
  .control {
    position: relative;
    display: flex;
  }
  input {
    flex: 1;
    min-width: 0;
    min-height: var(--toque-min);
    padding: var(--esp-2) var(--esp-3);
    border: 1px solid var(--color-borde);
    border-radius: var(--radio-sm);
    background: var(--color-superficie);
    color: var(--color-texto);
    border-color: var(--color-borde-fuerte);
    transition:
      border-color var(--duracion-rapida) var(--curva),
      box-shadow var(--duracion-rapida) var(--curva);
  }
  input:hover:not(:disabled) {
    border-color: var(--color-texto-suave);
  }
  input:focus-visible {
    border-color: var(--color-acento);
    box-shadow: 0 0 0 3px rgb(37 99 235 / 0.2);
    outline: none;
  }
  input:disabled {
    background: var(--color-fondo);
    color: var(--color-texto-suave);
  }
  input[aria-invalid="true"] {
    border-color: var(--color-error);
  }
  .con-accion input {
    padding-right: 4.5rem;
  }
  .accion {
    position: absolute;
    right: 4px;
    top: 50%;
    transform: translateY(-50%);
    display: grid;
    place-items: center;
    min-width: 40px;
    height: 40px;
    padding: 0 var(--esp-2);
    border: 0;
    border-radius: var(--radio-sm);
    background: transparent;
    color: var(--color-texto-suave);
    font-size: var(--texto-sm);
    font-weight: var(--peso-fuerte);
  }
  .accion:hover {
    background: var(--color-superficie-hover);
    color: var(--color-texto);
  }
  .accion.texto {
    color: var(--color-acento);
  }
  small {
    color: var(--color-texto-suave);
  }
  .error {
    color: var(--color-error);
    font-weight: 600;
  }
</style>
