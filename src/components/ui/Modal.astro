---
/**
 * Diálogo nativo (<dialog>). Se abre con cualquier botón que tenga
 * data-abrir-modal="<id>". Contenido y acciones por slots.
 */
interface Props {
  id: string;
  titulo: string;
}
const { id, titulo } = Astro.props;
---

<dialog id={id} class="modal" aria-labelledby={`${id}-titulo`}>
  <h2 id={`${id}-titulo`}>{titulo}</h2>
  <div class="cuerpo">
    <slot />
  </div>
  <div class="acciones">
    <form method="dialog">
      <button class="cancelar" type="submit">
        Cancelar
      </button>
    </form>
    <slot name="acciones" />
  </div>
</dialog>

<script>
  document.addEventListener("click", (ev) => {
    const boton = (ev.target as HTMLElement).closest<HTMLElement>("[data-abrir-modal]");
    if (!boton) return;
    const dialogo = document.getElementById(boton.dataset.abrirModal ?? "");
    if (dialogo instanceof HTMLDialogElement) dialogo.showModal();
  });
</script>

<style>
  /* Lo que flota usa sombra, sin borde. Entrada corta con salida exponencial. */
  .modal {
    width: min(28rem, calc(100vw - 2rem));
    border: 0;
    border-radius: var(--radio-lg);
    padding: var(--esp-6);
    box-shadow: var(--sombra-lg);
    color: var(--color-texto);
  }
  .modal[open] {
    animation: aparecer var(--duracion) var(--curva);
  }
  .modal[open]::backdrop {
    animation: velo var(--duracion) var(--curva);
  }
  .modal::backdrop {
    background: rgb(15 23 42 / 0.45);
    backdrop-filter: blur(2px);
  }
  @keyframes aparecer {
    from {
      opacity: 0;
      transform: translateY(8px) scale(0.98);
    }
  }
  @keyframes velo {
    from {
      opacity: 0;
    }
  }
  h2 {
    margin: 0 0 var(--esp-3);
    font-size: var(--texto-lg);
  }
  .cuerpo {
    color: var(--color-texto-suave);
  }
  .acciones {
    display: flex;
    justify-content: flex-end;
    flex-wrap: wrap;
    gap: var(--esp-2);
    margin-top: var(--esp-6);
  }
  .cancelar {
    min-height: 44px;
    padding: 0 var(--esp-5);
    border-radius: var(--radio-sm);
    border: 1px solid var(--color-borde-fuerte);
    background: var(--color-superficie);
    font-size: var(--texto-sm);
    font-weight: var(--peso-fuerte);
    transition: background var(--duracion-rapida) var(--curva);
  }
  .cancelar:hover {
    background: var(--color-superficie-hover);
  }
</style>
