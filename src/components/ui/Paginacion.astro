---
import Icono from "./Icono.astro";

interface Props {
  pagina: number;
  total: number; // total de registros
  porPagina: number;
}
const { pagina, total, porPagina } = Astro.props;
const totalPaginas = Math.max(1, Math.ceil(total / porPagina));

function url(p: number) {
  const u = new URL(Astro.url);
  if (p <= 1) u.searchParams.delete("pagina");
  else u.searchParams.set("pagina", String(p));
  return u.pathname + u.search;
}
const desde = total === 0 ? 0 : (pagina - 1) * porPagina + 1;
const hasta = Math.min(total, pagina * porPagina);
---

<nav class="paginacion" aria-label="Paginación">
  <span>
    {desde}–{hasta} de {total}
  </span>
  {totalPaginas > 1 && (
    <div class="enlaces">
      {pagina > 1 ? (
        <a href={url(pagina - 1)}>
          <Icono nombre="anterior" tamano={16} />
          Anterior
        </a>
      ) : (
        <span aria-disabled="true">
          <Icono nombre="anterior" tamano={16} />
          Anterior
        </span>
      )}
      <span>
        Página {pagina} de {totalPaginas}
      </span>
      {pagina < totalPaginas ? (
        <a href={url(pagina + 1)}>
          Siguiente
          <Icono nombre="siguiente" tamano={16} />
        </a>
      ) : (
        <span aria-disabled="true">
          Siguiente
          <Icono nombre="siguiente" tamano={16} />
        </span>
      )}
    </div>
  )}
</nav>

<style>
  .paginacion {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: var(--esp-3);
    margin-top: var(--esp-4);
    font-size: var(--texto-sm);
    color: var(--color-texto-suave);
  }
  .enlaces {
    display: flex;
    gap: var(--esp-4);
    align-items: center;
  }
  a,
  [aria-disabled="true"] {
    display: inline-flex;
    align-items: center;
    gap: var(--esp-1);
    min-height: 44px;
    padding: 0 var(--esp-3);
    border-radius: var(--radio-sm);
    font-weight: 600;
    text-decoration: none;
  }
  a {
    color: var(--color-acento);
    transition: background var(--duracion-rapida) var(--curva);
  }
  a:hover {
    background: var(--color-acento-suave);
  }
  [aria-disabled="true"] {
    opacity: 0.4;
  }
</style>
