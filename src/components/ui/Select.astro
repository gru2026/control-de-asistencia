---
import type { HTMLAttributes } from "astro/types";

type Props = Omit<HTMLAttributes<"select">, "name"> & {
  etiqueta: string;
  nombre: string;
  opciones: { valor: string; texto: string; datos?: Record<string, string> }[];
  valor?: string | null | undefined;
  vacia?: string; // texto de la opción vacía (si se permite)
  error?: string | undefined;
  ayuda?: string;
};

const {
  etiqueta,
  nombre,
  opciones,
  valor,
  vacia,
  error,
  ayuda,
  id = `campo-${nombre}`,
  class: clase,
  ...resto
} = Astro.props;
const describe =
  [ayuda && `${id}-ayuda`, error && `${id}-error`].filter(Boolean).join(" ") || undefined;
---

<div class:list={["campo", clase]}>
  <label for={id}>
    {etiqueta}
    {resto.required && (
      <span class="obligatorio" aria-hidden="true">
        *
      </span>
    )}
  </label>
  <select
    id={id}
    name={nombre}
    aria-invalid={error ? "true" : undefined}
    aria-describedby={describe}
    {...resto}
  >
    {vacia !== undefined && <option value="">{vacia}</option>}
    {opciones.map((o) => (
      <option
        value={o.valor}
        selected={o.valor === (valor ?? "")}
        {...Object.fromEntries(Object.entries(o.datos ?? {}).map(([k, v]) => [`data-${k}`, v]))}
      >
        {o.texto}
      </option>
    ))}
  </select>
  {ayuda && <small id={`${id}-ayuda`}>{ayuda}</small>}
  {error && (
    <small id={`${id}-error`} class="error">
      {error}
    </small>
  )}
</div>

<style>
  .campo {
    display: flex;
    flex-direction: column;
    gap: var(--esp-1);
  }
  label {
    font-weight: var(--peso-medio);
    color: var(--color-texto);
    font-size: var(--texto-sm);
  }
  .obligatorio {
    color: var(--color-error);
    margin-left: 2px;
  }
  select {
    min-height: var(--toque-min);
    padding: var(--esp-2) var(--esp-3);
    border: 1px solid var(--color-borde);
    border-radius: var(--radio-sm);
    background: var(--color-superficie);
    color: var(--color-texto);
    border-color: var(--color-borde-fuerte);
    transition:
      border-color var(--duracion-rapida) var(--curva),
      box-shadow var(--duracion-rapida) var(--curva);
  }
  select:hover:not(:disabled) {
    border-color: var(--color-texto-suave);
  }
  select:focus-visible {
    border-color: var(--color-acento);
    box-shadow: 0 0 0 3px rgb(37 99 235 / 0.2);
    outline: none;
  }
  select:disabled {
    background: var(--color-fondo);
    color: var(--color-texto-suave);
  }
  select[aria-invalid="true"] {
    border-color: var(--color-error);
  }
  small {
    color: var(--color-texto-suave);
  }
  .error {
    color: var(--color-error);
    font-weight: 600;
  }
</style>
