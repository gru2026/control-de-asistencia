---
/**
 * Subsecciones en el celular (D-55, D-58): pastillas deslizables. En la PC las
 * mismas subsecciones están en el menú lateral.
 */
interface Props {
  items: { href: string; texto: string }[];
  etiqueta: string;
  /** Rutas que cuentan como la subsección actual (además de su href) */
  actual?: string;
}
const { items, etiqueta, actual } = Astro.props;
const ruta = actual ?? Astro.url.pathname;
---

<nav class="subnav" aria-label={etiqueta}>
  {items.map((s) => (
    <a href={s.href} aria-current={ruta === s.href ? "page" : undefined}>
      {s.texto}
    </a>
  ))}
</nav>

<style>
  .subnav {
    display: flex;
    gap: var(--esp-2);
    margin: calc(var(--esp-2) * -1) calc(var(--esp-4) * -1) var(--esp-5);
    padding: 0 var(--esp-4) var(--esp-1);
    overflow-x: auto;
    scrollbar-width: none;
    scroll-snap-type: x proximity;
  }
  a {
    flex: none;
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    padding: 0 var(--esp-4);
    border: 1px solid var(--color-borde);
    border-radius: 999px;
    background: var(--color-superficie);
    color: var(--color-texto-suave);
    font-size: var(--texto-sm);
    font-weight: var(--peso-medio);
    text-decoration: none;
    white-space: nowrap;
    scroll-snap-align: start;
  }
  a[aria-current="page"] {
    border-color: var(--color-primario);
    background: var(--color-primario);
    color: var(--color-primario-contraste);
  }
  @media (min-width: 900px) {
    .subnav {
      display: none;
    }
  }
</style>

<script>
  import { enCadaPantalla } from "@/scripts/pantalla";
  enCadaPantalla(() => {
    document
      .querySelector<HTMLElement>(".subnav a[aria-current]")
      ?.scrollIntoView({ block: "nearest", inline: "center" });
  });
</script>
