---
/**
 * Tabla responsiva. Con `tarjetas`, en pantallas pequeñas cada fila se muestra
 * como tarjeta (cada <td> debe tener data-etiqueta="Nombre de la columna").
 */
interface Props {
  titulo: string; // descripción accesible
  vacio?: string;
  hayFilas?: boolean;
  tarjetas?: boolean;
}
const { titulo, vacio = "No hay registros.", hayFilas = true, tarjetas = false } = Astro.props;
---

{hayFilas ? (
  <div
    class:list={["contenedor", tarjetas && "tarjetas"]}
    data-datos
    role="region"
    aria-label={titulo}
    tabindex="0"
  >
    <table>
      <slot />
    </table>
  </div>
) : (
  <div class="vacio" data-datos>
    <svg
      width="40"
      height="40"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <circle cx="11" cy="11" r="8" />
      <path d="m21 21-4.3-4.3" />
    </svg>
    <p>{vacio}</p>
    <slot name="vacio" />
  </div>
)}

<style>
  /* Dentro de una tarjeta, la tabla llega a sus bordes (sin caja dentro de la caja). */
  .contenedor {
    overflow: auto;
    max-height: 70vh;
    margin-inline: calc(-1 * var(--tarjeta-pad, 0px));
    border-block: 1px solid var(--color-borde);
    background: var(--color-superficie);
  }
  .contenedor:last-child {
    margin-bottom: calc(-1 * var(--tarjeta-pad, 0px));
    border-bottom: 0;
    border-radius: 0 0 var(--radio) var(--radio);
  }
  table {
    width: 100%;
    border-collapse: separate;
    border-spacing: 0;
    font-size: var(--texto-sm);
  }
  table :global(th),
  table :global(td) {
    padding: var(--esp-3) var(--esp-4);
  }
  table :global(th:first-child),
  table :global(td:first-child) {
    padding-left: max(var(--esp-4), var(--tarjeta-pad, 0px));
  }
  table :global(th:last-child),
  table :global(td:last-child) {
    padding-right: max(var(--esp-4), var(--tarjeta-pad, 0px));
  }
  table :global(th),
  table :global(td) {
    text-align: left;
    border-bottom: 1px solid var(--color-borde);
    white-space: nowrap;
  }
  table :global(th) {
    position: sticky;
    top: 0;
    z-index: 1;
    background: var(--color-hundido);
    font-weight: var(--peso-medio);
    font-size: var(--texto-sm);
    color: var(--color-texto-suave);
  }
  table :global(td.num),
  table :global(th.num) {
    text-align: right;
    font-variant-numeric: tabular-nums;
  }
  table :global(tbody tr:last-child td) {
    border-bottom: 0;
  }
  /* Enlaces en tablas (nombres): texto fuerte, subrayado solo al pasar */
  table :global(td a) {
    color: var(--color-texto);
    font-weight: var(--peso-fuerte);
    text-decoration: none;
  }
  table :global(td a:hover) {
    color: var(--color-acento-texto);
    text-decoration: underline;
  }
  table :global(tbody tr) {
    transition: background var(--duracion-rapida) var(--curva);
  }
  table :global(tbody tr:hover) {
    background: var(--color-superficie-hover);
  }
  .vacio {
    display: grid;
    justify-items: center;
    gap: var(--esp-2);
    padding: var(--esp-8) var(--esp-4);
    text-align: center;
    color: var(--color-texto-suave);
  }
  .vacio svg {
    color: var(--color-texto-tenue);
  }
  .vacio p {
    margin: 0;
  }

  /* Móvil: filas como tarjetas */
  @media (max-width: 700px) {
    .tarjetas {
      max-height: none;
      background: transparent;
    }
    .tarjetas table,
    .tarjetas :global(tbody),
    .tarjetas :global(tr),
    .tarjetas :global(td) {
      display: block;
      width: 100%;
    }
    .tarjetas :global(thead) {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
    }
    /* Cada fila es un bloque de la lista separado por una línea, no otra tarjeta. */
    .tarjetas :global(tbody tr) {
      padding: var(--esp-3) max(var(--esp-4), var(--tarjeta-pad, 0px));
      border-bottom: 1px solid var(--color-borde);
    }
    .tarjetas :global(tbody tr:last-child) {
      border-bottom: 0;
    }
    .tarjetas :global(td:nth-child(n)) {
      padding-inline: 0;
      border-bottom: 0;
    }
    .tarjetas :global(td) {
      display: flex;
      justify-content: space-between;
      gap: var(--esp-3);
      padding-block: 6px;
      white-space: normal;
      text-align: right;
      font-size: var(--texto-sm);
    }
    .tarjetas :global(td[data-etiqueta])::before {
      content: attr(data-etiqueta);
      color: var(--color-texto-suave);
      font-weight: var(--peso-medio);
      text-align: left;
    }
    .tarjetas :global(td.principal) {
      font-size: var(--texto-base);
      text-align: left;
      padding-bottom: var(--esp-2);
    }
  }
</style>
