---
import BaseLayout from "./BaseLayout.astro";

interface Props {
  titulo: string;
}
const { titulo } = Astro.props;
---

<BaseLayout titulo={titulo}>
  <main class="auth">
    <div class="marca">
      <img src="/favicon.svg" alt="" width="56" height="56" />
      <p class="institucion">U.E.E. General Rafael Urdaneta</p>
      <p class="app">Control de Asistencia</p>
    </div>
    <div class="caja">
      <slot />
    </div>
  </main>
</BaseLayout>

<style>
  .auth {
    min-height: 100dvh;
    display: grid;
    place-content: center;
    gap: var(--esp-6);
    padding: var(--esp-6) var(--esp-4);
    background: linear-gradient(160deg, var(--color-primario) 0 45%, var(--color-fondo) 45%);
  }
  .marca {
    text-align: center;
    color: var(--color-primario-contraste);
  }
  .marca img {
    margin: 0 auto var(--esp-3);
    border-radius: 14px;
    box-shadow: 0 0 0 3px rgb(255 255 255 / 0.25);
  }
  .institucion {
    margin: 0;
    font-size: var(--texto-sm);
    opacity: 0.85;
  }
  .app {
    margin: 0;
    font-size: var(--texto-xl);
    font-weight: 700;
  }
  .caja {
    width: min(26rem, calc(100vw - 2rem));
    background: var(--color-superficie);
    border-radius: var(--radio);
    box-shadow: 0 10px 30px rgb(0 0 0 / 0.12);
    padding: var(--esp-6);
  }
</style>
