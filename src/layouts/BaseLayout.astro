---
import "@/styles/global.css";

interface Props {
  titulo: string;
  /** Color de la barra del sistema (móvil / ventana de escritorio). */
  colorTema?: string;
}

const { titulo, colorTema = "#0f172a" } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <!-- Antes del primer pintado: evita que los filtros plegables salten al cargar -->
    <script is:inline>
      document.documentElement.classList.add("js");
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content={colorTema} />
    <meta name="color-scheme" content="light" />
    <meta
      name="description"
      content="GRU-system: control de asistencia del personal de la U.E.E. General Rafael Urdaneta"
    />
    <meta name="robots" content="noindex" />

    <link
      rel="preload"
      href="/fuentes/onest-latin-variable.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <!-- PWA -->
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="application-name" content="GRU-system" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="GRU-system" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="format-detection" content="telephone=no" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />

    <title>{titulo} · GRU-system</title>
  </head>
  <body>
    <div class="progreso" aria-hidden="true"></div>
    <div id="anuncio" class="visualmente-oculto" aria-live="polite" aria-atomic="true"></div>
    <slot />
    <script>
      import "@/scripts/mejoras";
    </script>
    {import.meta.env.PROD && <script is:inline define:vars={{ version: __VERSION_APP__ }}>
      // Cada publicación registra /sw.js?v=<versión>. Si hay una versión nueva esperando,
      // se ofrece actualizar; al aceptar, el service worker nuevo toma el control y se recarga.
      if ("serviceWorker" in navigator) {
        // Solo se recarga si la persona pidió actualizar: la primera instalación también
        // cambia de controlador y no debe recargar la página mientras se escribe.
        let actualizar = false;
        const avisar = (sw) => {
          if (document.querySelector(".aviso-version")) return;
          const aviso = document.createElement("div");
          aviso.className = "aviso-version";
          aviso.setAttribute("role", "status");
          aviso.innerHTML =
            '<span>Hay una versión nueva de GRU-system.</span><button type="button">Actualizar</button>';
          aviso.querySelector("button").addEventListener("click", () => {
            actualizar = true;
            sw.postMessage("activar");
          });
          document.body.append(aviso);
        };
        addEventListener("load", async () => {
          const reg = await navigator.serviceWorker
            .register(`/sw.js?v=${version}`)
            .catch(() => null);
          if (!reg) return;
          if (reg.waiting && navigator.serviceWorker.controller) avisar(reg.waiting);
          reg.addEventListener("updatefound", () => {
            const nuevo = reg.installing;
            nuevo?.addEventListener("statechange", () => {
              if (nuevo.state === "installed" && navigator.serviceWorker.controller) avisar(nuevo);
            });
          });
          // Al volver a la app (instalada), buscar si hay otra publicación.
          document.addEventListener("visibilitychange", () => {
            if (!document.hidden) reg.update().catch(() => {});
          });
        });
        navigator.serviceWorker.addEventListener("controllerchange", () => {
          if (!actualizar) return;
          actualizar = false;
          location.reload();
        });
      }
    </script>}
  </body>
</html>
