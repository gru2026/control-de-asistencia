---
import BaseLayout from "./BaseLayout.astro";
import Alerta from "@/components/ui/Alerta.astro";
import { puedeVer } from "@/lib/auth/acceso";
import { NOMBRE_ROL } from "@/types";

interface Props {
  titulo: string;
  /** Texto bajo el título (opcional). */
  subtitulo?: string;
}

const { titulo, subtitulo } = Astro.props;
const perfil = Astro.locals.perfil!;
const flash = Astro.locals.flash;
const ruta = Astro.url.pathname;

// Ítems de navegación; se muestran solo los que el rol puede ver.
const items = [
  { href: "/panel", texto: "Panel", icono: "▦" },
  { href: "/asistencia", texto: "Mi asistencia", icono: "◷" },
  { href: "/personal", texto: "Personal", icono: "👥" },
  { href: "/jornadas", texto: "Jornadas", icono: "🗓" },
  { href: "/configuracion/usuarios", texto: "Usuarios", icono: "🔑" },
].filter((i) => puedeVer(i.href, perfil.rol));

const activo = (href: string) => ruta === href || ruta.startsWith(href + "/");
const iniciales = (perfil.nombre[0] ?? "") + (perfil.apellido[0] ?? "");
---

<BaseLayout titulo={titulo}>
  <a class="saltar" href="#contenido">
    Saltar al contenido
  </a>
  <header class="barra">
    <a class="logo" href="/">
      <img src="/favicon.svg" alt="" width="32" height="32" />
      <span>
        Asistencia <strong>UEN</strong>
      </span>
    </a>
    <div class="usuario">
      <span class="avatar" aria-hidden="true">
        {iniciales}
      </span>
      <span class="datos">
        <span class="nombre">
          {perfil.nombre} {perfil.apellido}
        </span>
        <span class="rol">{NOMBRE_ROL[perfil.rol]}</span>
      </span>
      <form method="post" action="/api/salir">
        <button type="submit" class="salir">
          Salir
        </button>
      </form>
    </div>
  </header>

  <div class="marco">
    <nav class="nav" aria-label="Principal">
      <ul>
        {items.map((i) => (
          <li>
            <a href={i.href} aria-current={activo(i.href) ? "page" : undefined}>
              <span class="icono" aria-hidden="true">
                {i.icono}
              </span>
              <span>{i.texto}</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <main id="contenido">
      <div class="encabezado">
        <div>
          <h1>{titulo}</h1>
          {subtitulo && <p class="subtitulo">{subtitulo}</p>}
        </div>
        <div class="acciones">
          <slot name="acciones" />
        </div>
      </div>
      {flash && (
        <div class="flash">
          <Alerta tipo={flash.tipo}>{flash.mensaje}</Alerta>
        </div>
      )}
      <slot />
    </main>
  </div>
</BaseLayout>

<style>
  .saltar {
    position: absolute;
    left: -999px;
  }
  .saltar:focus {
    left: var(--esp-2);
    top: var(--esp-2);
    z-index: 10;
    background: #fff;
    padding: var(--esp-2);
  }
  .barra {
    position: sticky;
    top: 0;
    z-index: 5;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--esp-3);
    padding: var(--esp-2) var(--esp-4);
    background: var(--color-primario);
    color: var(--color-primario-contraste);
  }
  .logo {
    display: flex;
    align-items: center;
    gap: var(--esp-2);
    color: inherit;
    text-decoration: none;
  }
  .logo img {
    border-radius: 8px;
  }
  .usuario {
    display: flex;
    align-items: center;
    gap: var(--esp-2);
  }
  .avatar {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.15);
    font-weight: 700;
    font-size: var(--texto-sm);
  }
  .datos {
    display: none;
    flex-direction: column;
    line-height: 1.2;
  }
  .rol {
    font-size: 0.75rem;
    opacity: 0.75;
  }
  .salir {
    min-height: 36px;
    padding: 0 var(--esp-3);
    border: 1px solid rgb(255 255 255 / 0.3);
    border-radius: var(--radio);
    background: transparent;
    color: inherit;
    cursor: pointer;
  }

  .marco {
    display: block;
  }
  main {
    padding: var(--esp-4);
    padding-bottom: calc(var(--esp-8) * 3); /* espacio para la barra inferior */
    max-width: 72rem;
    margin: 0 auto;
  }
  .encabezado {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: var(--esp-3);
    margin-bottom: var(--esp-4);
  }
  h1 {
    margin: 0;
    font-size: var(--texto-xl);
  }
  .subtitulo {
    margin: var(--esp-1) 0 0;
    color: var(--color-texto-suave);
  }
  .acciones {
    display: flex;
    gap: var(--esp-2);
    flex-wrap: wrap;
  }
  .flash {
    margin-bottom: var(--esp-4);
  }

  /* Móvil: barra inferior */
  .nav {
    position: fixed;
    inset: auto 0 0 0;
    z-index: 5;
    background: var(--color-superficie);
    border-top: 1px solid var(--color-borde);
    padding-bottom: env(safe-area-inset-bottom);
  }
  .nav ul {
    display: flex;
    justify-content: space-around;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .nav a {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
    min-width: var(--toque-min);
    padding: var(--esp-2) var(--esp-1);
    color: var(--color-texto-suave);
    text-decoration: none;
    font-size: 0.7rem;
  }
  .nav a[aria-current="page"] {
    color: var(--color-acento);
    font-weight: 700;
  }
  .icono {
    font-size: 1.25rem;
    line-height: 1;
  }

  /* PC: navegación lateral */
  @media (min-width: 900px) {
    .datos {
      display: flex;
    }
    .marco {
      display: grid;
      grid-template-columns: 15rem 1fr;
      min-height: calc(100dvh - 52px);
    }
    .nav {
      position: sticky;
      top: 52px;
      align-self: start;
      height: calc(100dvh - 52px);
      border-top: 0;
      border-right: 1px solid var(--color-borde);
      padding: var(--esp-4) var(--esp-2);
    }
    .nav ul {
      flex-direction: column;
      gap: var(--esp-1);
    }
    .nav a {
      flex-direction: row;
      gap: var(--esp-3);
      padding: var(--esp-3);
      border-radius: var(--radio);
      font-size: var(--texto-base);
    }
    .nav a[aria-current="page"] {
      background: #eff6ff;
    }
    .icono {
      font-size: 1rem;
      width: 1.25rem;
      text-align: center;
    }
    main {
      padding: var(--esp-8);
      margin: 0;
      width: 100%;
    }
  }
</style>
