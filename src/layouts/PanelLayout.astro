---
import BaseLayout from "./BaseLayout.astro";
import { fade } from "astro:transitions";
import Alerta from "@/components/ui/Alerta.astro";
import Icono, { type NombreIcono } from "@/components/ui/Icono.astro";
import { puedeVer } from "@/lib/auth/acceso";
import { NOMBRE_ROL } from "@/types";

interface Props {
  titulo: string;
  /** Texto bajo el título (opcional). */
  subtitulo?: string;
  /** Migas de pan: el último elemento es la página actual (sin href). */
  migas?: { texto: string; href?: string }[];
  /** Contenido más ancho (panel con columna lateral). */
  amplio?: boolean;
}

const { titulo, subtitulo, migas, amplio = false } = Astro.props;
const perfil = Astro.locals.perfil!;
const flash = Astro.locals.flash;
const ruta = Astro.url.pathname;

// Navegación por rol (máximo 5 ítems en la barra inferior del celular).
type Item = {
  href: string;
  texto: string;
  icono: NombreIcono;
  activoEn?: string[];
  /** Solo activo en la ruta exacta (Mi asistencia no se activa en /asistencia/registro). */
  exacto?: boolean;
};
const ASISTENCIA: Item = {
  href: "/asistencia/registro",
  texto: "Asistencia",
  icono: "calendario",
  activoEn: ["/asistencia/revision", "/permisos"],
};
const MI_ASISTENCIA: Item = {
  href: "/asistencia",
  texto: "Mi asistencia",
  icono: "reloj",
  exacto: true,
};
const NAV: Record<typeof perfil.rol, Item[]> = {
  directiva: [
    { href: "/panel", texto: "Panel", icono: "panel" },
    ASISTENCIA,
    { href: "/personal", texto: "Personal", icono: "usuarios" },
    { href: "/reportes", texto: "Reportes", icono: "documento" },
    { href: "/configuracion", texto: "Ajustes", icono: "ajustes", activoEn: ["/jornadas"] },
  ],
  secretaria: [
    { href: "/panel", texto: "Panel", icono: "panel" },
    ASISTENCIA,
    { href: "/personal", texto: "Personal", icono: "usuarios" },
    { href: "/reportes", texto: "Reportes", icono: "documento" },
    MI_ASISTENCIA,
  ],
  personal: [MI_ASISTENCIA, { href: "/historial", texto: "Historial", icono: "calendario" }],
};
const sb = Astro.locals.supabase;
const { count: sinLeer } = await sb
  .from("notificaciones")
  .select("id", { count: "exact", head: true })
  .eq("leida", false);
// La directiva marca su asistencia solo si tiene ficha (acceso en la barra superior).
const fichaDirectiva = perfil.rol === "directiva" && perfil.tiene_ficha;
const visibles = NAV[perfil.rol].filter((i) => puedeVer(i.href, perfil.rol));

const activo = (i: Item) =>
  [i.href, ...(i.activoEn ?? [])].some(
    (h) => ruta === h || (!(i.exacto && h === i.href) && ruta.startsWith(h + "/")),
  );
const iniciales = (perfil.nombre[0] ?? "") + (perfil.apellido[0] ?? "");
---

<BaseLayout titulo={titulo}>
  <a class="saltar" href="#contenido">
    Saltar al contenido
  </a>
  <header class="barra" transition:animate="none">
    <a class="marca" href="/" aria-label="GRU-system, ir al inicio">
      <img src="/icons/icon-192.png" alt="" width="32" height="32" />
      <span class="nombre-app">
        GRU<span class="tenue">-system</span>
      </span>
    </a>
    <div class="usuario">
      <a
        class="avatar"
        href="/cambiar-clave"
        title="Cambiar contraseña"
        aria-label="Cambiar contraseña"
      >
        {iniciales}
      </a>
      <span class="datos">
        <span class="nombre">
          {perfil.nombre} {perfil.apellido}
        </span>
        <span class="rol">{NOMBRE_ROL[perfil.rol]}</span>
      </span>
      {fichaDirectiva && (
        <a
          class="icono-barra"
          href="/asistencia"
          aria-label="Mi asistencia"
          aria-current={ruta === "/asistencia" ? "page" : undefined}
        >
          <Icono nombre="reloj" tamano={20} />
        </a>
      )}
      <a
        class="icono-barra"
        href="/notificaciones"
        aria-label={sinLeer ? `Avisos: ${sinLeer} sin leer` : "Avisos"}
        aria-current={ruta === "/notificaciones" ? "page" : undefined}
      >
        <Icono nombre="campana" tamano={20} />
        {sinLeer ? <span class="contador">{sinLeer > 99 ? "99+" : sinLeer}</span> : null}
      </a>
      <form method="post" action="/api/salir">
        <button type="submit" class="salir" aria-label="Cerrar sesión">
          <Icono nombre="salir" tamano={18} />
          <span class="texto-salir">Salir</span>
        </button>
      </form>
    </div>
  </header>

  <div class="marco">
    <nav
      class:list={["nav", visibles.length < 2 && "solo-escritorio"]}
      aria-label="Principal"
      transition:animate="none"
    >
      <ul style={`--columnas: ${visibles.length}`}>
        {visibles.map((i) => (
          <li>
            <a href={i.href} aria-current={activo(i) ? "page" : undefined}>
              <Icono nombre={i.icono} tamano={22} />
              <span>{i.texto}</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <main
      id="contenido"
      class:list={[visibles.length < 2 && "sin-barra", amplio && "amplio"]}
      transition:animate={fade({ duration: "0.12s" })}
    >
      {migas && migas.length > 1 && (
        <nav class="migas" aria-label="Ruta">
          <ol>
            {migas.map((m, i) => (
              <li>
                {m.href && i < migas.length - 1 ? (
                  <a href={m.href}>{m.texto}</a>
                ) : (
                  <span aria-current="page">{m.texto}</span>
                )}
              </li>
            ))}
          </ol>
        </nav>
      )}
      <div class="encabezado">
        <div>
          <h1>{titulo}</h1>
          {subtitulo && <p class="subtitulo">{subtitulo}</p>}
        </div>
        <div class="acciones">
          <slot name="acciones" />
        </div>
      </div>
      {flash && (
        <div class="flash">
          <Alerta tipo={flash.tipo}>{flash.mensaje}</Alerta>
        </div>
      )}
      <slot />
    </main>
  </div>
</BaseLayout>

<style>
  .saltar {
    position: absolute;
    left: -999px;
  }
  .saltar:focus {
    left: var(--esp-2);
    top: calc(var(--seguro-arriba) + var(--esp-2));
    z-index: 20;
    background: #fff;
    padding: var(--esp-2) var(--esp-3);
    border-radius: var(--radio-sm);
  }

  /* ── Barra superior ─────────────────────────────────── */
  .barra {
    position: sticky;
    top: 0;
    z-index: 10;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--esp-3);
    min-height: calc(56px + var(--seguro-arriba));
    padding: var(--seguro-arriba) calc(var(--esp-4) + var(--seguro-der)) 0
      calc(var(--esp-4) + var(--seguro-izq));
    background: var(--color-primario);
    color: var(--color-primario-contraste);
  }
  .marca {
    display: flex;
    align-items: center;
    gap: var(--esp-2);
    color: inherit;
    text-decoration: none;
    min-height: 44px;
  }
  .marca img {
    border-radius: var(--radio-sm);
  }
  .nombre-app {
    white-space: nowrap;
    font-weight: var(--peso-titulo);
    font-size: var(--texto-lg);
    letter-spacing: -0.01em;
  }
  .tenue {
    font-weight: var(--peso-medio);
    opacity: 0.7;
  }
  .usuario {
    display: flex;
    align-items: center;
    gap: var(--esp-2);
  }
  .icono-barra {
    position: relative;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: var(--radio);
    color: inherit;
    transition: background var(--duracion-rapida) var(--curva);
  }
  .icono-barra:hover,
  .icono-barra[aria-current="page"] {
    background: rgb(255 255 255 / 0.12);
  }
  .icono-barra:focus-visible {
    outline-color: #fff;
  }
  .contador {
    position: absolute;
    top: 4px;
    right: 2px;
    min-width: 18px;
    height: 18px;
    padding: 0 5px;
    border-radius: 999px;
    background: #ef4444;
    color: #fff;
    font-size: 0.6875rem;
    font-weight: var(--peso-fuerte);
    line-height: 18px;
    text-align: center;
    font-variant-numeric: tabular-nums;
  }
  .avatar {
    color: inherit;
    text-decoration: none;
    display: none;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.12);
    font-weight: var(--peso-fuerte);
    font-size: var(--texto-sm);
  }
  .datos {
    display: none;
    flex-direction: column;
    line-height: 1.25;
  }
  .nombre {
    font-weight: var(--peso-medio);
    font-size: var(--texto-sm);
  }
  .rol {
    font-size: var(--texto-xs);
    opacity: 0.7;
  }
  .salir {
    display: inline-flex;
    align-items: center;
    gap: var(--esp-2);
    min-height: 44px;
    min-width: 44px;
    justify-content: center;
    padding: 0 var(--esp-3);
    border: 1px solid rgb(255 255 255 / 0.25);
    border-radius: var(--radio);
    background: transparent;
    font-size: var(--texto-sm);
    transition: background var(--duracion-rapida) var(--curva);
  }
  .salir:hover {
    background: rgb(255 255 255 / 0.1);
  }
  .salir:focus-visible {
    outline-color: #fff;
  }
  .texto-salir {
    display: none;
  }

  /* ── Contenido ──────────────────────────────────────── */
  main {
    width: 100%;
    max-width: 72rem;
    margin: 0 auto;
    padding: var(--esp-5) calc(var(--esp-4) + var(--seguro-der)) calc(88px + var(--seguro-abajo))
      calc(var(--esp-4) + var(--seguro-izq));
  }
  main.amplio {
    max-width: 96rem;
  }
  .encabezado {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: var(--esp-4);
    margin-bottom: var(--separacion-bloques);
  }
  h1 {
    font-size: 1.625rem;
  }
  .subtitulo {
    margin: 6px 0 0;
    color: var(--color-texto-suave);
  }
  .subtitulo::first-letter {
    text-transform: uppercase;
  }
  .acciones {
    display: flex;
    gap: var(--esp-2);
    flex-wrap: wrap;
    align-items: center;
  }
  .flash {
    margin-bottom: var(--esp-4);
  }
  .migas ol {
    display: flex;
    flex-wrap: wrap;
    gap: var(--esp-1);
    margin: 0 0 var(--esp-2);
    padding: 0;
    list-style: none;
    font-size: var(--texto-sm);
    color: var(--color-texto-suave);
  }
  .migas li + li::before {
    content: "/";
    margin-right: var(--esp-1);
    opacity: 0.5;
  }
  .migas a {
    color: var(--color-texto-suave);
    text-decoration: none;
  }
  .migas a:hover {
    color: var(--color-acento);
    text-decoration: underline;
  }
  .migas [aria-current] {
    color: var(--color-texto);
    font-weight: var(--peso-medio);
  }
  @media (max-width: 899px) {
    .solo-escritorio {
      display: none;
    }
    main.sin-barra {
      padding-bottom: calc(var(--esp-8) + var(--seguro-abajo));
    }
  }

  /* ── Navegación móvil: barra inferior ───────────────── */
  .nav {
    position: fixed;
    inset: auto 0 0 0;
    z-index: 10;
    background: rgb(255 255 255 / 0.92);
    backdrop-filter: saturate(1.6) blur(12px);
    box-shadow:
      0 -1px 0 var(--color-borde),
      0 -8px 24px -16px rgb(15 23 42 / 0.25);
    padding: var(--esp-1) var(--seguro-der) var(--seguro-abajo) var(--seguro-izq);
  }
  .nav ul {
    display: grid;
    grid-template-columns: repeat(var(--columnas), 1fr);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .nav a {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2px;
    min-height: 56px;
    padding: var(--esp-1);
    color: var(--color-texto-suave);
    text-decoration: none;
    font-size: var(--texto-xs);
    font-weight: var(--peso-medio);
    border-radius: var(--radio);
    transition:
      color var(--duracion-rapida) var(--curva),
      background var(--duracion-rapida) var(--curva);
  }
  .nav a span {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 100%;
  }
  .nav a:hover {
    color: var(--color-texto);
  }
  .nav a[aria-current="page"] {
    color: var(--color-acento-texto);
    font-weight: var(--peso-fuerte);
  }

  @media (min-width: 480px) {
    .texto-salir {
      display: inline;
    }
    .avatar {
      display: grid;
    }
  }

  /* ── PC: navegación lateral ─────────────────────────── */
  @media (min-width: 900px) {
    .datos {
      display: flex;
    }
    .marco {
      display: grid;
      grid-template-columns: 15rem 1fr;
      min-height: calc(100dvh - 56px);
      /* la capa lateral llega hasta el final aunque la página sea larga */
      background: linear-gradient(to right, var(--color-lateral) 15rem, transparent 15rem);
    }
    .nav {
      position: sticky;
      top: 56px;
      align-self: start;
      height: calc(100dvh - 56px);
      /* Segunda capa neutra, algo más fría que el contenido */
      background: var(--color-lateral);
      backdrop-filter: none;
      box-shadow: inset -1px 0 0 var(--color-borde);
      padding: var(--esp-5) var(--esp-3);
    }
    .nav ul {
      display: flex;
      flex-direction: column;
      gap: var(--esp-1);
    }
    .nav a {
      flex-direction: row;
      justify-content: flex-start;
      gap: var(--esp-3);
      min-height: 44px;
      padding: 0 var(--esp-3);
      font-size: var(--texto-sm);
      border-radius: var(--radio-sm);
    }
    .nav a:hover {
      background: rgb(255 255 255 / 0.6);
      color: var(--color-texto);
    }
    /* Ítem actual: superficie blanca que «flota» sobre la capa lateral */
    .nav a[aria-current="page"] {
      background: var(--color-superficie);
      box-shadow: var(--sombra-sm);
    }
    .nav a :global(.icono) {
      width: var(--icono-md);
      height: var(--icono-md);
    }
    main {
      padding: var(--esp-10) var(--esp-10) var(--esp-12);
      margin: 0;
    }
    h1 {
      font-size: var(--texto-2xl);
    }
  }
</style>
