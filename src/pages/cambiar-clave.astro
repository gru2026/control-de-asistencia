---
import AuthLayout from "@/layouts/AuthLayout.astro";
import Input from "@/components/ui/Input.astro";
import Boton from "@/components/ui/Boton.astro";
import Alerta from "@/components/ui/Alerta.astro";
import { texto, validarClave } from "@/lib/validacion";
import { claveInterna, esCuentaCedula, validarClavePropia } from "@/lib/auth/cedula";
import { establecerClavePropia } from "@/lib/servicios/cuentas";
import { inicioPorRol } from "@/lib/auth/acceso";
import { ponerFlash } from "@/lib/flash";

const perfil = Astro.locals.perfil!;
const sb = Astro.locals.supabase;
const obligatorio = !!perfil.debe_cambiar_clave;
const porCedula = esCuentaCedula(perfil.email);
let errores: Record<string, string> = {};
let error: string | null = null;

if (Astro.request.method === "POST") {
  const f = await Astro.request.formData();
  const actual = texto(f, "actual");
  const nueva = texto(f, "nueva");
  const repetir = texto(f, "repetir");

  const { data: ficha } = await sb
    .from("personal")
    .select("cedula")
    .eq("usuario_id", perfil.id)
    .maybeSingle<{ cedula: string }>();
  const errNueva = porCedula
    ? validarClavePropia(nueva, ficha?.cedula ?? null)
    : validarClave(nueva);
  if (errNueva) errores.nueva = errNueva;
  else if (nueva !== repetir) errores.repetir = "Las contraseñas no coinciden.";

  // Fuera del primer ingreso se confirma la contraseña actual.
  if (!obligatorio && !Object.keys(errores).length) {
    const { error: e } = await sb.auth.signInWithPassword({
      email: perfil.email,
      password: claveInterna(actual, perfil.email),
    });
    if (e) errores.actual = "La contraseña actual no es correcta.";
  }

  if (!Object.keys(errores).length) {
    const r = await establecerClavePropia(perfil.id, perfil.email, nueva);
    if (r.ok) {
      ponerFlash(
        Astro.cookies,
        "exito",
        "Listo: ya tiene su propia contraseña. Úsela desde ahora.",
      );
      return Astro.redirect(inicioPorRol(perfil.rol), 303);
    }
    error = r.mensaje;
  } else error = "Revise los campos marcados.";
  Astro.response.status = 400;
}
---

<AuthLayout titulo="Crear contraseña">
  <h1>{obligatorio ? `Hola, ${perfil.nombre}` : "Cambiar contraseña"}</h1>
  <p class="intro">
    {obligatorio
      ? "Es su primer ingreso: cree una contraseña propia para reemplazar la inicial (0000)."
      : "Escriba su contraseña actual y la nueva."}
  </p>
  {error && (
    <div class="espacio">
      <Alerta tipo="error">{error}</Alerta>
    </div>
  )}
  <form method="post" class="formulario" novalidate>
    {!obligatorio && (
      <Input
        etiqueta="Contraseña actual"
        nombre="actual"
        type="password"
        autocomplete="current-password"
        accion="mostrar"
        error={errores.actual}
        required
      />
    )}
    <Input
      etiqueta="Nueva contraseña"
      nombre="nueva"
      type="password"
      autocomplete="new-password"
      accion="mostrar"
      error={errores.nueva}
      ayuda={
        porCedula
          ? "Al menos 6 caracteres. Puede ser solo de números, pero no su cédula ni 111111."
          : "Al menos 8 caracteres con letras y números."
      }
      required
      autofocus
    />
    <Input
      etiqueta="Repita la contraseña"
      nombre="repetir"
      type="password"
      autocomplete="new-password"
      accion="mostrar"
      error={errores.repetir}
      required
    />
    <Boton type="submit" bloque tamano="grande" data-texto-cargando="Guardando…">
      Guardar contraseña
    </Boton>
  </form>
  <form method="post" action="/api/salir" class="salir">
    <button type="submit">Salir sin cambiarla</button>
  </form>
</AuthLayout>

<style>
  h1 {
    margin: 0 0 var(--esp-2);
    font-size: var(--texto-lg);
  }
  .intro {
    margin: 0 0 var(--esp-4);
    color: var(--color-texto-suave);
    font-size: var(--texto-sm);
  }
  .espacio {
    margin-bottom: var(--esp-4);
  }
  .formulario {
    display: grid;
    gap: var(--esp-4);
  }
  .salir {
    margin-top: var(--esp-4);
    text-align: center;
  }
  .salir button {
    min-height: 44px;
    border: 0;
    background: none;
    color: var(--color-texto-suave);
    font: inherit;
    font-size: var(--texto-sm);
    text-decoration: underline;
    cursor: pointer;
  }
</style>
