---
import PanelLayout from "@/layouts/PanelLayout.astro";
import Tarjeta from "@/components/ui/Tarjeta.astro";
import Boton from "@/components/ui/Boton.astro";
import Alerta from "@/components/ui/Alerta.astro";
import Input from "@/components/ui/Input.astro";
import Modal from "@/components/ui/Modal.astro";
import Icono from "@/components/ui/Icono.astro";
import { texto, type Errores } from "@/lib/validacion";
import { ponerFlash } from "@/lib/flash";
import { eliminarDemo, eliminarImportados, generarDemo } from "@/lib/servicios/mantenimiento";

const sb = Astro.locals.supabase;
const perfil = Astro.locals.perfil!;
let errores: Errores = {};
let mensaje: string | null = null;
let accion: string | null = null;
let valores: Record<string, string> = {};

if (Astro.request.method === "POST") {
  const f = await Astro.request.formData();
  accion = texto(f, "accion");
  valores = Object.fromEntries([...f.entries()].map(([k, v]) => [k, String(v)]));
  let exito: string | null = null;
  const confirmar = texto(f, "confirmar").toUpperCase() === "ELIMINAR";

  try {
    if (accion === "institucion") {
      const datos = {
        encabezado: texto(f, "encabezado").slice(0, 400),
        nombre_planilla: texto(f, "nombre_planilla").slice(0, 120),
        ubicacion: texto(f, "ubicacion").slice(0, 120),
        cod_dea: texto(f, "cod_dea").slice(0, 30) || null,
        firmante_nombre: texto(f, "firmante_nombre").slice(0, 80) || null,
        firmante_cedula: texto(f, "firmante_cedula").slice(0, 20) || null,
        firmante_cargo: texto(f, "firmante_cargo").slice(0, 60) || null,
        actualizado_por: perfil.id,
      };
      if (!datos.nombre_planilla) errores.nombre_planilla = "Obligatorio.";
      else {
        const { error } = await sb.from("configuracion").update(datos).eq("id", 1);
        if (error) mensaje = "No se pudo guardar.";
        else exito = "Datos de la institución guardados.";
      }
    } else if (accion === "geocerca") {
      const lat = Number(texto(f, "colegio_lat").replace(",", "."));
      const lng = Number(texto(f, "colegio_lng").replace(",", "."));
      const radio = Number(texto(f, "radio_m"));
      const precision = Number(texto(f, "precision_max_m"));
      if (!Number.isFinite(lat) || Math.abs(lat) > 90)
        errores.colegio_lat = "Latitud no válida (ej. 10.1656).";
      if (!Number.isFinite(lng) || Math.abs(lng) > 180)
        errores.colegio_lng = "Longitud no válida (ej. -66.8856).";
      if (!Number.isInteger(radio) || radio < 30 || radio > 2000)
        errores.radio_m = "Entre 30 y 2000 metros.";
      if (!Number.isInteger(precision) || precision < 10 || precision > 1000)
        errores.precision_max_m = "Entre 10 y 1000 metros.";
      if (!Object.keys(errores).length) {
        const { error } = await sb
          .from("configuracion")
          .update({
            colegio_lat: lat,
            colegio_lng: lng,
            radio_m: radio,
            precision_max_m: precision,
            actualizado_por: perfil.id,
          })
          .eq("id", 1);
        if (error) mensaje = "No se pudo guardar.";
        else exito = "Ubicación del colegio guardada.";
      }
    } else if (accion === "demo_generar") {
      const r = await generarDemo(perfil.id);
      exito = `Datos de demostración generados: ${r.registros} registros de asistencia y ${r.permisos} permisos para ${r.personas} personas.`;
    } else if (accion === "demo_eliminar") {
      if (!confirmar) mensaje = "Escriba ELIMINAR para confirmar.";
      else {
        const r = await eliminarDemo();
        exito = `Se eliminaron ${r.registros} registros y ${r.permisos} permisos de demostración.`;
      }
    } else if (accion === "importados_eliminar") {
      if (!confirmar) mensaje = "Escriba ELIMINAR para confirmar.";
      else {
        const n = await eliminarImportados();
        exito = `Se eliminaron ${n} personas importadas y su asistencia.`;
      }
    } else mensaje = "Acción no reconocida.";
  } catch (e) {
    console.error("[configuracion]", e);
    mensaje = "Ocurrió un error al procesar la operación. Intente de nuevo.";
  }

  if (exito) {
    ponerFlash(Astro.cookies, "exito", exito);
    return Astro.redirect("/configuracion", 303);
  }
  mensaje ??= "Revise los campos marcados.";
  Astro.response.status = 400;
}

const [{ data: cfg }, { count: demo }, { count: importados }] = await Promise.all([
  sb
    .from("configuracion")
    .select(
      "encabezado, nombre_planilla, ubicacion, cod_dea, firmante_nombre, firmante_cedula, firmante_cargo, colegio_lat, colegio_lng, radio_m, precision_max_m",
    )
    .eq("id", 1)
    .single(),
  sb.from("registros_asistencia").select("id", { count: "exact", head: true }).eq("es_demo", true),
  sb.from("personal").select("id", { count: "exact", head: true }).eq("origen", "importado"),
]);
const v = (k: string) =>
  accion && valores[k] !== undefined
    ? valores[k]
    : String((cfg as Record<string, unknown> | null)?.[k] ?? "");
const e = (a: string) => (accion === a ? errores : {});
---

<PanelLayout titulo="Ajustes" subtitulo="Configuración de la institución y mantenimiento de datos.">
  <div class="pila">
    {mensaje && <Alerta tipo="error">{mensaje}</Alerta>}

    <nav class="accesos" aria-label="Secciones de ajustes">
      <a href="/configuracion/usuarios">
        <Icono nombre="escudo" />{" "}
        <span>
          <strong>Usuarios</strong>
          <small>Cuentas de acceso y roles</small>
        </span>
      </a>
      <a href="/jornadas#categorias">
        <Icono nombre="usuarios" />{" "}
        <span>
          <strong>Categorías</strong>
          <small>Oficios del personal</small>
        </span>
      </a>
      <a href="/personal/importar">
        <Icono nombre="subir" />{" "}
        <span>
          <strong>Importar personal</strong>
          <small>Desde una hoja de cálculo (CSV)</small>
        </span>
      </a>
      <a href="#demo">
        <Icono nombre="datos" />{" "}
        <span>
          <strong>Datos de demostración</strong>
          <small>Generar o limpiar</small>
        </span>
      </a>
    </nav>

    <Tarjeta
      titulo="Institución y planilla oficial"
      descripcion="Estos datos aparecen en el encabezado y el pie de las planillas PDF y Excel."
      id="institucion"
    >
      <form method="post" class="rejilla" novalidate data-avisar-cambios>
        <input type="hidden" name="accion" value="institucion" />
        <div class="campo ancho">
          <label for="encabezado">Encabezado (una línea por renglón)</label>
          <textarea id="encabezado" name="encabezado" rows="3">{v("encabezado")}</textarea>
        </div>
        <Input
          etiqueta="Nombre del plantel"
          nombre="nombre_planilla"
          value={v("nombre_planilla")}
          error={e("institucion").nombre_planilla}
          required
        />
        <Input etiqueta="Ubicación" nombre="ubicacion" value={v("ubicacion")} />
        <Input etiqueta="Código DEA" nombre="cod_dea" value={v("cod_dea")} />
        <span></span>
        <Input
          etiqueta="Firma: nombre"
          nombre="firmante_nombre"
          value={v("firmante_nombre")}
          placeholder="Prof. Nombre Apellido"
        />
        <Input
          etiqueta="Firma: cédula"
          nombre="firmante_cedula"
          value={v("firmante_cedula")}
          placeholder="V-12345678"
        />
        <Input
          etiqueta="Firma: cargo"
          nombre="firmante_cargo"
          value={v("firmante_cargo")}
          placeholder="Directora (E)"
        />
        <p class="nota ancho">
          Pendiente: logo del colegio y escudo del estado en buena calidad para el encabezado.
        </p>
        <div class="final ancho">
          <Boton type="submit">Guardar</Boton>
        </div>
      </form>
    </Tarjeta>

    <Tarjeta
      titulo="Ubicación del colegio"
      descripcion="Centro y radio de la zona donde se permite marcar con GPS."
      id="geocerca"
    >
      <form method="post" class="rejilla" novalidate>
        <input type="hidden" name="accion" value="geocerca" />
        <Input
          etiqueta="Latitud"
          nombre="colegio_lat"
          inputmode="decimal"
          value={v("colegio_lat")}
          error={e("geocerca").colegio_lat}
          required
          placeholder="10.1656"
        />
        <Input
          etiqueta="Longitud"
          nombre="colegio_lng"
          inputmode="decimal"
          value={v("colegio_lng")}
          error={e("geocerca").colegio_lng}
          required
          placeholder="-66.8856"
        />
        <Input
          etiqueta="Radio permitido (m)"
          nombre="radio_m"
          type="number"
          min="30"
          max="2000"
          value={v("radio_m")}
          error={e("geocerca").radio_m}
        />
        <Input
          etiqueta="Precisión máxima del GPS (m)"
          nombre="precision_max_m"
          type="number"
          min="10"
          max="1000"
          value={v("precision_max_m")}
          error={e("geocerca").precision_max_m}
          ayuda="Si el GPS es menos preciso, la marcación queda señalada para revisión."
        />
        <p class="nota ancho">
          Para obtener las coordenadas: en Google Maps, mantenga presionada la entrada del colegio y
          copie los dos números que aparecen.
          {v("colegio_lat") && (
            <a
              href={`https://www.google.com/maps?q=${v("colegio_lat")},${v("colegio_lng")}`}
              target="_blank"
              rel="noopener"
            >
              Ver la ubicación actual en el mapa
            </a>
          )}
        </p>
        <div class="final ancho">
          <Boton type="submit">Guardar ubicación</Boton>
        </div>
      </form>
    </Tarjeta>

    <Tarjeta
      id="demo"
      titulo="Datos de demostración"
      descripcion="Asistencia simulada de las últimas 5 semanas para el personal activo, para mostrar el panel y los reportes."
    >
      <p class="estado-demo">
        {demo ? (
          <>
            <strong>{demo}</strong> registros de demostración cargados.
          </>
        ) : (
          "No hay datos de demostración cargados."
        )}
      </p>
      <div class="botones">
        <form method="post">
          <input type="hidden" name="accion" value="demo_generar" />
          <Boton type="submit" variante="secundario" data-texto-cargando="Generando…">
            <Icono nombre="datos" tamano={18} />
            {demo ? "Volver a generar" : "Generar datos de demostración"}
          </Boton>
        </form>
        {demo ? (
          <Boton variante="peligro" data-abrir-modal="modal-demo">
            <Icono nombre="papelera" tamano={18} />
            Eliminar datos de demostración
          </Boton>
        ) : null}
      </div>
    </Tarjeta>

    <Tarjeta
      titulo="Personal importado"
      descripcion="Personas cargadas desde un archivo (por ejemplo, la nómina inicial)."
      id="importados"
    >
      <p class="estado-demo">
        {importados ? (
          <>
            <strong>{importados}</strong> personas importadas.
          </>
        ) : (
          "No hay personal importado."
        )}
      </p>
      {importados ? (
        <Boton variante="peligro" data-abrir-modal="modal-importados">
          <Icono nombre="papelera" tamano={18} />
          Eliminar personal importado
        </Boton>
      ) : null}
    </Tarjeta>
  </div>

  <Modal id="modal-demo" titulo="¿Eliminar los datos de demostración?">
    <p>
      Se borrarán todos los registros de asistencia y permisos marcados como demostración. Los
      registros reales no se tocan.
    </p>
    <form method="post" slot="acciones" class="confirmar">
      <input type="hidden" name="accion" value="demo_eliminar" />
      <label for="conf-demo">
        Escriba <strong>ELIMINAR</strong> para confirmar
      </label>
      <input
        id="conf-demo"
        name="confirmar"
        autocomplete="off"
        required
        pattern="[Ee][Ll][Ii][Mm][Ii][Nn][Aa][Rr]"
      />
      <Boton type="submit" variante="peligro">
        Eliminar
      </Boton>
    </form>
  </Modal>

  <Modal id="modal-importados" titulo="¿Eliminar el personal importado?">
    <p>
      Se borrarán las {importados} personas importadas junto con su asistencia y permisos. Las
      cuentas de acceso que se les hayan creado se conservan.
    </p>
    <form method="post" slot="acciones" class="confirmar">
      <input type="hidden" name="accion" value="importados_eliminar" />
      <label for="conf-imp">
        Escriba <strong>ELIMINAR</strong> para confirmar
      </label>
      <input
        id="conf-imp"
        name="confirmar"
        autocomplete="off"
        required
        pattern="[Ee][Ll][Ii][Mm][Ii][Nn][Aa][Rr]"
      />
      <Boton type="submit" variante="peligro">
        Eliminar
      </Boton>
    </form>
  </Modal>
</PanelLayout>

<style>
  .pila {
    display: grid;
    gap: var(--esp-4);
  }
  .accesos {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: var(--esp-3);
  }
  .accesos a {
    display: flex;
    gap: var(--esp-3);
    align-items: center;
    padding: var(--esp-4);
    background: var(--color-superficie);
    border: 1px solid var(--color-borde);
    border-radius: var(--radio);
    color: var(--color-acento);
    text-decoration: none;
    transition: border-color var(--duracion-rapida) var(--curva);
  }
  .accesos a:hover {
    border-color: var(--color-acento);
  }
  .accesos span {
    display: grid;
  }
  .accesos strong {
    color: var(--color-texto);
  }
  .accesos small {
    color: var(--color-texto-suave);
  }
  .rejilla {
    display: grid;
    gap: var(--esp-4);
  }
  @media (min-width: 768px) {
    .rejilla {
      grid-template-columns: 1fr 1fr;
    }
    .ancho {
      grid-column: 1 / -1;
    }
  }
  .campo {
    display: grid;
    gap: var(--esp-1);
  }
  .campo label {
    font-weight: var(--peso-medio);
    font-size: var(--texto-sm);
  }
  textarea {
    padding: var(--esp-3);
    border: 1px solid var(--color-borde-fuerte);
    border-radius: var(--radio-sm);
    resize: vertical;
    font-family: inherit;
  }
  .nota {
    margin: 0;
    font-size: var(--texto-sm);
    color: var(--color-texto-suave);
  }
  .final {
    display: flex;
    justify-content: flex-end;
  }
  .estado-demo {
    margin: 0 0 var(--esp-4);
  }
  .botones {
    display: flex;
    flex-wrap: wrap;
    gap: var(--esp-2);
  }
  .confirmar {
    display: grid;
    gap: var(--esp-2);
    width: 100%;
  }
  .confirmar input {
    min-height: 44px;
    padding: 0 var(--esp-3);
    border: 1px solid var(--color-borde-fuerte);
    border-radius: var(--radio-sm);
  }
</style>
