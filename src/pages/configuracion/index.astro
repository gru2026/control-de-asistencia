---
/**
 * Ajustes · Resumen (D-58): el estado de cada área en palabras, con su lectura.
 * Cada recuadro lleva a su sección; las mismas secciones están en el menú.
 */
import PanelLayout from "@/layouts/PanelLayout.astro";
import Subnav from "@/components/ui/Subnav.astro";
import Modulo from "@/components/panel/Modulo.astro";
import Anillo from "@/components/panel/Anillo.astro";
import { cargarPuestaEnMarcha, SECCIONES_AJUSTES } from "@/lib/ajustes";
import { fechaCorta, hoyEnZona } from "@/lib/fecha";
import { numero, plural } from "@/lib/formato";
import type { Lectura } from "@/lib/reglas/estadisticas";

const sb = Astro.locals.supabase;
const hoy = hoyEnZona();

const [
  { data: cfg },
  { data: qr },
  { count: ubicacionesPrueba },
  { count: jornadas },
  { count: categorias },
  { count: feriados },
  { data: cuentas },
  { count: demo },
  { count: importados },
  puesta,
] = await Promise.all([
  sb
    .from("configuracion")
    .select(
      "nombre_planilla, firmante_nombre, cod_dea, colegio_lat, colegio_lng, radio_m, geocerca_activa, inicio_control",
    )
    .eq("id", 1)
    .single(),
  sb
    .from("codigos_qr")
    .select("descripcion, creado_en, vigente_hasta")
    .eq("activo", true)
    .maybeSingle(),
  sb
    .from("ubicaciones")
    .select("id", { count: "exact", head: true })
    .eq("activa", true)
    .eq("es_prueba", true),
  sb.from("jornadas").select("id", { count: "exact", head: true }).eq("activa", true),
  sb.from("categorias").select("id", { count: "exact", head: true }).eq("activa", true),
  sb.from("feriados").select("id", { count: "exact", head: true }).gte("fecha", hoy),
  sb.from("usuarios").select("rol").eq("estado", "activo"),
  sb.from("registros_asistencia").select("id", { count: "exact", head: true }).eq("es_demo", true),
  sb.from("personal").select("id", { count: "exact", head: true }).eq("origen", "importado"),
  cargarPuestaEnMarcha(sb),
]);

// Institución
const faltaPlanilla = [
  !cfg?.firmante_nombre && "quién firma",
  !cfg?.cod_dea && "código DEA",
].filter(Boolean) as string[];
// Marcación
const hayUbicacion = cfg?.colegio_lat != null && cfg?.colegio_lng != null;
const lecturaMarcacion: Lectura = !hayUbicacion
  ? "bajo"
  : !cfg?.geocerca_activa || ubicacionesPrueba
    ? "atencion"
    : "bien";
const fraseMarcacion = !hayUbicacion
  ? "Falta la ubicación del colegio"
  : !cfg?.geocerca_activa
    ? "No se verifica la ubicación"
    : "Solo se marca en el colegio";
const detalleMarcacion = [
  hayUbicacion && `Radio de ${numero(cfg!.radio_m)} m`,
  ubicacionesPrueba &&
    plural(ubicacionesPrueba, "ubicación de prueba activa", "ubicaciones de prueba activas"),
  cfg?.inicio_control
    ? `Cierre diario desde el ${fechaCorta(cfg.inicio_control)}`
    : "Cierre diario en pausa",
]
  .filter(Boolean)
  .join(" · ");
// Código QR
const qrVencido = !!qr?.vigente_hasta && qr.vigente_hasta < hoy;
const qrDePrueba = !!qr?.descripcion && /prueba/i.test(qr.descripcion);
const lecturaQr: Lectura = !qr || qrVencido ? "bajo" : qrDePrueba ? "atencion" : "bien";
const fraseQr = !qr
  ? "No hay un QR activo"
  : qrVencido
    ? "El QR venció"
    : qrDePrueba
      ? "El QR activo es de prueba"
      : "QR vigente";
const detalleQr = qr
  ? `Desde el ${fechaCorta(qr.creado_en.slice(0, 10))} · ${qr.vigente_hasta ? `vence el ${fechaCorta(qr.vigente_hasta)}` : "sin vencimiento"}`
  : "Nadie puede marcar con el teléfono hasta generarlo";
// Usuarios
const roles = (cuentas ?? []) as { rol: string }[];
const deRol = (r: string) => roles.filter((x) => x.rol === r).length;
// Puesta en marcha
const totalPasos = puesta.pasos.length;
const pctPuesta = totalPasos ? (puesta.listos / totalPasos) * 100 : 0;
const siguiente = puesta.pasos.find((p) => !p.listo);
---

<PanelLayout titulo="Ajustes" subtitulo="Configuración de la institución y mantenimiento de datos.">
  <Subnav items={SECCIONES_AJUSTES} etiqueta="Secciones de Ajustes" />

  <div class="modulos">
    <Modulo
      titulo="Institución"
      icono="documento"
      frase={faltaPlanilla.length ? "Faltan datos de la planilla" : "Planilla completa"}
      detalle={
        faltaPlanilla.length
          ? `Falta: ${faltaPlanilla.join(" y ")}`
          : (cfg?.nombre_planilla ?? undefined)
      }
      lectura={faltaPlanilla.length ? "atencion" : "bien"}
      href="/configuracion/institucion"
      tono="azul"
      orden={0}
    />
    <Modulo
      titulo="Marcación"
      icono="ubicacion"
      frase={fraseMarcacion}
      detalle={detalleMarcacion}
      lectura={lecturaMarcacion}
      href="/configuracion/marcacion"
      tono="verde"
      orden={1}
    />
    <Modulo
      titulo="Código QR"
      icono="qr"
      frase={fraseQr}
      detalle={detalleQr}
      lectura={lecturaQr}
      href="/configuracion/qr"
      tono="violeta"
      orden={2}
    />
    <Modulo
      titulo="Jornadas y categorías"
      icono="calendario"
      frase={`${plural(jornadas ?? 0, "jornada", "jornadas")} · ${plural(categorias ?? 0, "categoría", "categorías")}`}
      detalle={
        feriados ? `${plural(feriados, "feriado", "feriados")} por venir` : "Sin feriados por venir"
      }
      href="/jornadas"
      tono="cian"
      orden={3}
    />
    <Modulo
      titulo="Usuarios"
      icono="escudo"
      frase={plural(roles.length, "cuenta activa", "cuentas activas")}
      detalle={`${deRol("directiva")} de directiva · ${deRol("secretaria")} de secretaría · ${deRol("personal")} del personal`}
      href="/configuracion/usuarios"
      tono="ambar"
      orden={4}
    />
    <Modulo
      titulo="Datos"
      icono="datos"
      frase={demo ? "Hay datos de demostración" : "Sin datos de prueba"}
      detalle={
        [
          demo && `${numero(demo)} registros simulados`,
          importados && `${plural(importados, "persona importada", "personas importadas")}`,
        ]
          .filter(Boolean)
          .join(" · ") || "Importar personal desde un archivo"
      }
      lectura={demo ? "atencion" : "bien"}
      href="/configuracion/datos"
      tono="rosa"
      orden={5}
    />
    <Modulo
      titulo="Puesta en marcha"
      icono="exito"
      frase={`${puesta.listos} de ${totalPasos} pasos listos`}
      detalle={
        siguiente ? `Siguiente: ${siguiente.titulo.toLowerCase()}` : "Todo listo para el uso real"
      }
      lectura={puesta.listos === totalPasos ? "bien" : "atencion"}
      href="/configuracion/puesta-en-marcha"
      tono="verde"
      orden={6}
    >
      <Anillo valor={pctPuesta} texto="listo" />
    </Modulo>
  </div>
  <p class="pie">
    Toque un recuadro para abrir esa sección. También están en el menú, dentro de{" "}
    <strong>Ajustes</strong>.
  </p>
</PanelLayout>

<style>
  .modulos {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 19rem), 1fr));
    gap: var(--esp-4);
  }
  .pie {
    margin: var(--esp-6) 0 0;
    color: var(--color-texto-suave);
    font-size: var(--texto-sm);
  }
</style>
