---
import PanelLayout from "@/layouts/PanelLayout.astro";
import Tarjeta from "@/components/ui/Tarjeta.astro";
import Icono from "@/components/ui/Icono.astro";
import { cargarPuestaEnMarcha, SECCIONES_AJUSTES } from "@/lib/ajustes";
import Subnav from "@/components/ui/Subnav.astro";

/**
 * Lista de verificación para pasar de pruebas a uso real (D-44). Solo informa
 * y lleva a cada pantalla: ningún paso se ejecuta desde aquí.
 */
const { pasos, listos } = await cargarPuestaEnMarcha(Astro.locals.supabase);
---

<PanelLayout
  titulo="Puesta en marcha"
  subtitulo="Lo que falta para pasar de las pruebas al uso real. Esta página solo revisa; cada paso se hace en su pantalla."
  migas={[{ texto: "Ajustes", href: "/configuracion" }, { texto: "Puesta en marcha" }]}
>
  <Subnav items={SECCIONES_AJUSTES} etiqueta="Secciones de Ajustes" />
  <div class="dos-zonas">
    <div class="zona-principal">
      <Tarjeta>
        <ol class="pasos">
          {pasos.map((p) => (
            <li class:list={[p.listo && "listo"]}>
              <span class="marca" aria-hidden="true">
                <Icono nombre={p.listo ? "exito" : "reloj"} tamano={22} />
              </span>
              <div class="texto">
                <strong>{p.titulo}</strong>
                <span class="visualmente-oculto">{p.listo ? "Listo." : "Pendiente."}</span>
                <span class="detalle">{p.detalle}</span>
              </div>
              {!p.listo && (
                <a href={p.enlace} class="ir">
                  {p.accion}
                </a>
              )}
            </li>
          ))}
        </ol>
      </Tarjeta>
    </div>
    <aside class="zona-lateral" aria-label="Avance">
      <Tarjeta titulo="Avance">
        <p class="progreso-texto">
          <strong>
            {listos} de {pasos.length}
          </strong>{" "}
          pasos listos.
        </p>
        <div
          class="barra-avance"
          role="progressbar"
          aria-label="Pasos listos"
          aria-valuemin="0"
          aria-valuemax={pasos.length}
          aria-valuenow={listos}
        >
          <span style={`width: ${Math.round((listos / Math.max(pasos.length, 1)) * 100)}%`}></span>
        </div>
      </Tarjeta>
      <Tarjeta titulo="Antes de empezar">
        <p class="nota">
          Guarde un respaldo de la base de datos (<code>npm run db:respaldo</code>). El orden
          sugerido y los detalles están en la guía de puesta en marcha de la documentación.
        </p>
      </Tarjeta>
    </aside>
  </div>
</PanelLayout>

<style>
  .barra-avance {
    height: 8px;
    margin-top: var(--esp-3);
    overflow: hidden;
    border-radius: 999px;
    background: var(--color-borde);
  }
  .barra-avance span {
    display: block;
    height: 100%;
    border-radius: inherit;
    background: var(--color-exito);
  }
  .progreso-texto,
  .nota {
    margin: 0;
  }
  .nota {
    font-size: var(--texto-sm);
    color: var(--color-texto-suave);
  }
  .pasos {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .pasos li {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: var(--esp-3);
    padding: var(--esp-4) 0;
    border-top: 1px solid var(--color-borde);
  }
  .pasos li:first-child {
    border-top: 0;
    padding-top: 0;
  }
  .marca {
    display: grid;
    color: var(--color-alerta);
  }
  .listo .marca {
    color: var(--color-exito);
  }
  .texto {
    display: grid;
    gap: 2px;
    flex: 1;
    min-width: 14rem;
  }
  .listo strong {
    color: var(--color-texto-suave);
    font-weight: var(--peso-medio);
  }
  .detalle {
    font-size: var(--texto-sm);
    color: var(--color-texto-suave);
  }
  .ir {
    align-self: center;
    font-size: var(--texto-sm);
    font-weight: var(--peso-medio);
  }
</style>
