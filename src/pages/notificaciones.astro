---
import PanelLayout from "@/layouts/PanelLayout.astro";
import Tarjeta from "@/components/ui/Tarjeta.astro";
import Boton from "@/components/ui/Boton.astro";
import Icono from "@/components/ui/Icono.astro";
import { cuandoAviso, ICONO_AVISO, NOMBRE_AVISO, type Aviso } from "@/lib/avisos";
import Paginacion from "@/components/ui/Paginacion.astro";
import Pestanas from "@/components/ui/Pestanas.astro";
import { esUuid, texto } from "@/lib/validacion";
import { plural } from "@/lib/formato";
import { ponerFlash } from "@/lib/flash";

const sb = Astro.locals.supabase;
const perfil = Astro.locals.perfil!;
const p = Astro.url.searchParams;

// La política de RLS solo permite leer y marcar las propias.
if (Astro.request.method === "POST") {
  const f = await Astro.request.formData();
  const accion = texto(f, "accion");
  const id = texto(f, "id");
  // Desde el panel de la campana se vuelve a la pantalla donde se estaba.
  const volverTexto = texto(f, "volver");
  const volver =
    volverTexto.startsWith("/") && !volverTexto.startsWith("//")
      ? volverTexto
      : Astro.url.pathname + Astro.url.search;
  if (accion === "abrir" && esUuid(id)) {
    const { data } = await sb
      .from("notificaciones")
      .update({ leida: true })
      .eq("id", id)
      .select("enlace")
      .maybeSingle();
    const enlace = data?.enlace as string | null | undefined;
    const seguro = enlace && enlace.startsWith("/") && !enlace.startsWith("//");
    return Astro.redirect(seguro ? enlace : volver, 303);
  }
  if (accion === "no_leer") {
    const ids = texto(f, "ids").split(",").filter(esUuid).slice(0, 200);
    if (ids.length) await sb.from("notificaciones").update({ leida: false }).in("id", ids);
  } else if (accion === "leer" && esUuid(id)) {
    await sb.from("notificaciones").update({ leida: true }).eq("id", id);
    ponerFlash(Astro.cookies, "exito", "Aviso marcado como leído.", {
      accion: "no_leer",
      datos: { ids: id, volver },
      ruta: "/notificaciones",
    });
  } else if (accion === "leer_todas") {
    const { data } = await sb
      .from("notificaciones")
      .update({ leida: true })
      .eq("usuario_destino", perfil.id)
      .eq("leida", false)
      .select("id");
    ponerFlash(
      Astro.cookies,
      "exito",
      data?.length
        ? `${plural(data.length, "aviso marcado", "avisos marcados")} como leído${data.length === 1 ? "" : "s"}.`
        : "No había avisos sin leer.",
      data?.length
        ? {
            accion: "no_leer",
            datos: { ids: data.map((x) => x.id as string).join(","), volver },
            ruta: "/notificaciones",
          }
        : undefined,
    );
  }
  return Astro.redirect(volver, 303);
}

const vista = p.get("ver") === "todas" ? "todas" : "sin_leer";
const tipo = p.get("tipo") && p.get("tipo")! in NOMBRE_AVISO ? p.get("tipo")! : null;
const porPagina = 30;
const pagina = Math.max(1, Number.parseInt(p.get("pagina") ?? "1", 10) || 1);
let consulta = sb
  .from("notificaciones")
  .select("id, tipo, mensaje, enlace, leida, fecha", { count: "exact" })
  .order("fecha", { ascending: false })
  .range((pagina - 1) * porPagina, pagina * porPagina - 1);
if (vista === "sin_leer") consulta = consulta.eq("leida", false);
if (tipo) consulta = consulta.eq("tipo", tipo);

const [{ data, count }, { data: tiposSinLeer }] = await Promise.all([
  consulta,
  sb.from("notificaciones").select("tipo").eq("leida", false).limit(1000),
]);
// Resumen de lo que falta por leer, por tipo (zona lateral)
const porTipo = new Map<string, number>();
for (const x of tiposSinLeer ?? []) porTipo.set(x.tipo, (porTipo.get(x.tipo) ?? 0) + 1);
const sinLeer = tiposSinLeer?.length ?? 0;
const resumenTipos = [...porTipo].sort((a, b) => b[1] - a[1]);
const conTipo = (t: string | null) => {
  const u = new URLSearchParams();
  if (vista === "todas") u.set("ver", "todas");
  if (t) u.set("tipo", t);
  return `/notificaciones${u.size ? `?${u}` : ""}`;
};
const avisos = (data ?? []) as Aviso[];
const total = count ?? 0;
---

<PanelLayout
  titulo="Avisos"
  subtitulo="Lo que el sistema le informa: faltas, salidas sin marcar, teléfonos y el QR."
>
  <Fragment slot="acciones">
    {sinLeer ? (
      <form method="post">
        <input type="hidden" name="accion" value="leer_todas" />
        <Boton type="submit" variante="secundario">
          Marcar todos como leídos
        </Boton>
      </form>
    ) : null}
  </Fragment>

  <Pestanas
    etiqueta="Filtrar avisos"
    items={[
      { href: "/notificaciones", texto: "Sin leer", contador: sinLeer },
      { href: "/notificaciones?ver=todas", texto: "Todos" },
    ]}
  />

  <div class="dos-zonas">
    <div class="zona-principal">
      <Tarjeta>
        {avisos.length === 0 ? (
          <p class="vacio">
            <Icono nombre="campana" tamano={22} />
            {vista === "sin_leer" ? "No tiene avisos sin leer." : "Aún no tiene avisos."}
          </p>
        ) : (
          <ul class="avisos">
            {avisos.map((a) => (
              <li class:list={[!a.leida && "nuevo"]}>
                <span class="icono-aviso" aria-hidden="true">
                  <Icono nombre={ICONO_AVISO[a.tipo] ?? "info"} tamano={18} />
                </span>
                <div class="texto">
                  {a.enlace ? (
                    <form method="post">
                      <input type="hidden" name="accion" value="abrir" />
                      <input type="hidden" name="id" value={a.id} />
                      <button type="submit" class="mensaje enlace">
                        {a.mensaje}
                      </button>
                    </form>
                  ) : (
                    <p class="mensaje">{a.mensaje}</p>
                  )}
                  <span class="cuando">
                    {!a.leida && <span class="visualmente-oculto">Sin leer. </span>}
                    {cuandoAviso(a.fecha)}
                  </span>
                </div>
                {!a.leida && (
                  <form method="post">
                    <input type="hidden" name="accion" value="leer" />
                    <input type="hidden" name="id" value={a.id} />
                    <Boton type="submit" variante="fantasma" tamano="pequeno">
                      Leído
                    </Boton>
                  </form>
                )}
              </li>
            ))}
          </ul>
        )}
        {total > porPagina && <Paginacion pagina={pagina} total={total} porPagina={porPagina} />}
      </Tarjeta>
    </div>

    <aside class="zona-lateral" aria-label="Resumen de avisos">
      <Tarjeta
        titulo="Sin leer"
        descripcion={resumenTipos.length ? "Toque un tipo para ver solo esos avisos." : undefined}
      >
        {resumenTipos.length ? (
          <ul class="tipos">
            <li>
              <a href={conTipo(null)} aria-current={!tipo ? "true" : undefined}>
                <span>Todos los tipos</span>
                <strong>{sinLeer}</strong>
              </a>
            </li>
            {resumenTipos.map(([t, n]) => (
              <li>
                <a href={conTipo(t)} aria-current={tipo === t ? "true" : undefined}>
                  <span class="tipo">
                    <Icono nombre={ICONO_AVISO[t] ?? "info"} tamano={16} />
                    {(NOMBRE_AVISO[t] ?? ["aviso", "avisos"])[n === 1 ? 0 : 1]}
                  </span>
                  <strong>{n}</strong>
                </a>
              </li>
            ))}
          </ul>
        ) : (
          <p class="nota">Está al día: no hay avisos sin leer.</p>
        )}
      </Tarjeta>
    </aside>
  </div>
</PanelLayout>

<style>
  .tipos {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .tipos a {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--esp-3);
    min-height: 44px;
    padding: 0 var(--esp-3);
    border-radius: var(--radio-sm);
    color: var(--color-texto);
    font-size: var(--texto-sm);
    text-decoration: none;
  }
  .tipos a:hover {
    background: var(--color-superficie-hover);
  }
  .tipos a[aria-current] {
    background: var(--color-fondo);
    font-weight: var(--peso-medio);
  }
  .tipo {
    display: inline-flex;
    align-items: center;
    gap: var(--esp-2);
    color: var(--color-texto-suave);
  }
  .tipos strong {
    font-variant-numeric: tabular-nums;
  }
  .nota {
    margin: 0;
    color: var(--color-texto-suave);
    font-size: var(--texto-sm);
  }
  .pila-x {
    display: grid;
    gap: var(--esp-4);
  }
  .vacio {
    display: flex;
    align-items: center;
    gap: var(--esp-3);
    margin: 0;
    color: var(--color-texto-suave);
  }
  .avisos {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .avisos li {
    display: flex;
    align-items: flex-start;
    gap: var(--esp-3);
    padding: var(--esp-4) 0;
    border-top: 1px solid var(--color-borde);
  }
  .avisos li:first-child {
    border-top: 0;
    padding-top: 0;
  }
  .icono-aviso {
    display: grid;
    place-items: center;
    flex: none;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--color-hundido);
    color: var(--color-texto-suave);
  }
  .nuevo .icono-aviso {
    background: var(--color-acento-suave);
    color: var(--color-acento-texto);
  }
  .texto {
    display: grid;
    gap: 2px;
    flex: 1;
    min-width: 0;
  }
  .mensaje {
    margin: 0;
    color: var(--color-texto-suave);
  }
  .nuevo .mensaje {
    color: var(--color-texto);
    font-weight: var(--peso-medio);
  }
  .enlace {
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    text-align: left;
    cursor: pointer;
  }
  .enlace:hover {
    color: var(--color-acento-texto);
    text-decoration: underline;
  }
  .cuando {
    font-size: var(--texto-xs);
    color: var(--color-texto-tenue);
  }
</style>
