    box-shadow: inset 0 1px 0 var(--color-borde);
  }
  .kpi:nth-child(4) {
    box-shadow:
      inset 1px 0 0 var(--color-borde),
      inset 0 1px 0 var(--color-borde);
  }
  .kpi dt {
