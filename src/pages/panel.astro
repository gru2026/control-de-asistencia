---
import PanelLayout from "@/layouts/PanelLayout.astro";
import Boton from "@/components/ui/Boton.astro";
import Icono, { type NombreIcono } from "@/components/ui/Icono.astro";
import Seccion from "@/components/ui/Seccion.astro";
import Tarjeta from "@/components/ui/Tarjeta.astro";
import CalendarioPeriodo from "@/components/panel/CalendarioPeriodo.astro";
import HoyPorCategoria from "@/components/panel/HoyPorCategoria.astro";
import ListaAusentes from "@/components/panel/ListaAusentes.astro";
import { sumarDias } from "@/lib/reglas/tiempo";
import Figura from "@/components/graficas/Figura.astro";
import GraficaLinea from "@/components/graficas/GraficaLinea.astro";
import BarrasHorizontales from "@/components/graficas/BarrasHorizontales.astro";
import DistribucionLlegadas from "@/components/graficas/DistribucionLlegadas.astro";
import BarraApilada from "@/components/graficas/BarraApilada.astro";
import { fechaCorta, fechaLarga, hoyEnZona } from "@/lib/fecha";
import { listarCategorias } from "@/lib/datos/categorias";
import { cargarRegistros, rangoPeriodo, type Periodo } from "@/lib/datos/asistencia";
import { aExcepcion, aJornada, type FilaHorario, type FilaJornada } from "@/lib/datos/jornadas";
import { resolverJornada } from "@/lib/reglas/jornada";
import {
  contar,
  calendarioPeriodo,
  conclusiones,
  hoyPorCategoria,
  histogramaLlegadas,
  personasCriticas,
  porCategoria,
  porDiaSemana,
  resumir,
  serieDiaria,
  serieRepresentativa,
} from "@/lib/reglas/estadisticas";
import { NOMBRE_DIA, type DiaSemana } from "@/types";
import { numero, plural, porcentaje, variacionPuntos } from "@/lib/formato";

const sb = Astro.locals.supabase;
const perfil = Astro.locals.perfil!;
const hoy = hoyEnZona();
const p = Astro.url.searchParams;

const categorias = await listarCategorias(sb);
const catPorId = new Map(categorias.map((c) => [c.id, c]));
const periodo: Periodo =
  (["mes", "anterior", "30d"] as const).find((x) => x === p.get("periodo")) ?? "mes";
const categoriaId = catPorId.has(p.get("categoria") ?? "") ? p.get("categoria") : null;
const rango = rangoPeriodo(periodo, hoy);

// ── Datos ──
interface FilaPersona {
  id: string;
  nombre: string;
  apellido: string;
  categoria_id: string;
  usuario_id: string | null;
  jornada_id: string | null;
  jornadas: FilaJornada | null;
  horarios: FilaHorario[];
}
let qPersonal = sb
  .from("personal")
  .select(
    "id, nombre, apellido, categoria_id, usuario_id, jornada_id, jornadas(id, nombre, hora_entrada, hora_salida, tolerancia_min, pausa_min, dias_laborables, activa, nocturna), horarios(dia_semana, hora_entrada, hora_salida, tolerancia_min, libre)",
  )
  .eq("estado", "activo");
if (categoriaId) qPersonal = qPersonal.eq("categoria_id", categoriaId);

const [
  registros,
  anteriores,
  { data: personalData },
  { data: feriadoHoy },
  { data: feriadosPeriodo },
  { data: proximoFeriado },
  { data: permisosData, count: totalAusentes },
  { data: primerTelefono, count: telefonosPendientes },
] = await Promise.all([
  cargarRegistros(sb, rango.desde, rango.hasta, categoriaId),
  cargarRegistros(sb, rango.anterior.desde, rango.anterior.hasta, categoriaId),
  qPersonal.limit(1000),
  sb.from("feriados").select("descripcion").eq("fecha", hoy).maybeSingle(),
  sb.from("feriados").select("fecha").gte("fecha", rango.desde).lte("fecha", rango.hasta),
  sb
    .from("feriados")
    .select("fecha, descripcion")
    .gt("fecha", hoy)
    .order("fecha")
    .limit(1)
    .maybeSingle(),
  (() => {
    let q = sb
      .from("permisos")
      .select(
        "personal_id, motivo, fecha_desde, fecha_hasta, personal!inner(nombre, apellido, categoria_id, estado)",
        {
          count: "exact",
        },
      )
      .lte("fecha_desde", sumarDias(hoy, 7))
      .gte("fecha_hasta", hoy)
      .eq("personal.estado", "activo")
      .order("fecha_desde")
      .limit(5);
    if (categoriaId) q = q.eq("personal.categoria_id", categoriaId);
    return q;
  })(),
  sb
    .from("dispositivos")
    .select("usuario_id", { count: "exact" })
    .eq("estado", "pendiente")
    .order("creado_en")
    .limit(1),
]);
const personas = (personalData ?? []) as unknown as FilaPersona[];
const personaPorId = new Map(personas.map((x) => [x.id, x]));

const resumen = resumir(registros);
const resumenAnt = anteriores.length ? resumir(anteriores) : null;
const esDemo = registros.some((r) => r.esDemo);
const porRevisar = registros.filter((r) => r.senaladoPendiente).length;

// Hoy
const deHoy = registros.filter((r) => r.fecha === hoy);
const hoyConteo = contar(deHoy);
const laborablesHoy = feriadoHoy
  ? 0
  : personas.filter((x) =>
      resolverJornada({
        fecha: hoy,
        jornada: x.jornadas ? aJornada(x.jornadas) : null,
        excepciones: x.horarios.map(aExcepcion),
      }),
    ).length;
const pendientesHoy = Math.max(0, laborablesHoy - hoyConteo.total);

// ── Columna lateral ──
const semanas = calendarioPeriodo(
  rango.desde,
  rango.hasta,
  serieDiaria(registros),
  ((feriadosPeriodo ?? []) as { fecha: string }[]).map((f) => f.fecha),
  hoy,
);
const esperadosHoy = feriadoHoy
  ? []
  : personas
      .filter((x) =>
        resolverJornada({
          fecha: hoy,
          jornada: x.jornadas ? aJornada(x.jornadas) : null,
          excepciones: x.horarios.map(aExcepcion),
        }),
      )
      .map((x) => ({ personalId: x.id, categoriaId: x.categoria_id }));
const progresoHoy = hoyPorCategoria(esperadosHoy, deHoy)
  .map((p) => ({ ...p, cat: catPorId.get(p.categoriaId) }))
  .sort((a, b) => (a.cat?.orden ?? 99) - (b.cat?.orden ?? 99))
  .map((p) => ({
    nombre: p.cat?.nombre ?? "—",
    color: p.cat?.color ?? "#64748b",
    llegaron: p.llegaron,
    esperados: p.esperados,
  }));
interface FilaPermiso {
  personal_id: string;
  motivo: string;
  fecha_desde: string;
  fecha_hasta: string;
  personal: { nombre: string; apellido: string; categoria_id: string };
}
const ausentes = ((permisosData ?? []) as unknown as FilaPermiso[]).map((p) => ({
  personalId: p.personal_id,
  nombre: `${p.personal.nombre} ${p.personal.apellido}`,
  color: catPorId.get(p.personal.categoria_id)?.color ?? "#64748b",
  motivo: p.motivo,
  desde: p.fecha_desde,
  hasta: p.fecha_hasta,
}));
const mostrarHoy = rango.hasta === hoy;

// Gráficas
const serie = serieDiaria(registros);
// Tendencia sin días de personal mínimo (fines de semana con solo vigilancia)
const serieTendencia = serieRepresentativa(serie);
const omitidosTendencia = serie.length - serieTendencia.length;
const dias = porDiaSemana(registros);
const peorDia = dias.length ? Math.min(...dias.map((d) => d.asistencia)) : null;
const llegadas = histogramaLlegadas(registros);
const totalLlegadas = llegadas.reduce((s, l) => s + l.valor, 0);
const cats = porCategoria(registros)
  .map((c) => ({ ...c, cat: catPorId.get(c.categoriaId) }))
  .sort((a, b) => (a.cat?.orden ?? 99) - (b.cat?.orden ?? 99));
const criticas = personasCriticas(registros, 6);
const UMBRAL_FALTAS = 3;
const conFaltas = personasCriticas(registros, 1000).filter((c) => c.faltas >= UMBRAL_FALTAS);
const concl = conclusiones(
  registros,
  (id) => catPorId.get(id)?.nombre ?? "Una categoría",
  UMBRAL_FALTAS,
);

// Nómina
const sinCuenta = personas.filter((x) => !x.usuario_id).length;
const sinJornada = personas.filter((x) => !x.jornada_id).length;

// ── Nivel 1: cuatro indicadores (el detalle se descubre al pasar el mouse o tocar) ──
type Var = { texto: string; mejora: boolean; sube: boolean } | null;
const varPuntos = (actual: number, anterior: number | undefined): Var => {
  if (anterior === undefined) return null;
  const t = variacionPuntos(actual - anterior);
  return t === "0" ? null : { texto: t, mejora: actual > anterior, sube: actual > anterior };
};
const varCantidad = (actual: number, anterior: number | undefined, menosEsMejor = true): Var => {
  if (anterior === undefined || actual === anterior) return null;
  const d = actual - anterior;
  return {
    texto: `${d > 0 ? "+" : "−"}${numero(Math.abs(d))}`,
    mejora: menosEsMejor ? d < 0 : d > 0,
    sube: d > 0,
  };
};
const comparado = resumenAnt ? ` · período anterior: ` : "";
const kpis: {
  titulo: string;
  valor: string;
  icono: NombreIcono;
  variacion: Var;
  detalle: string;
}[] = [
  {
    titulo: "Asistencia",
    valor: resumen.conteo.total ? porcentaje(resumen.asistencia) : "—",
    icono: "tendencia",
    variacion: varPuntos(resumen.asistencia, resumenAnt?.asistencia),
    detalle: `${numero(resumen.conteo.presente + resumen.conteo.tarde + resumen.conteo.permiso)} de ${numero(resumen.conteo.total)} jornadas cumplidas (${porcentaje(resumen.asistencia, 2)})${comparado}${resumenAnt ? porcentaje(resumenAnt.asistencia, 2) : ""}`,
  },
  {
    titulo: "Puntualidad",
    valor: resumen.conteo.total ? porcentaje(resumen.puntualidad) : "—",
    icono: "reloj",
    variacion: varPuntos(resumen.puntualidad, resumenAnt?.puntualidad),
    detalle: `${plural(resumen.conteo.tarde, "llegada tarde", "llegadas tarde")} · retraso promedio ${resumen.retrasoPromedioMin} min${comparado}${resumenAnt ? porcentaje(resumenAnt.puntualidad, 2) : ""}`,
  },
  {
    titulo: "Faltas",
    valor: numero(resumen.conteo.falta),
    icono: "alerta",
    variacion: varCantidad(resumen.conteo.falta, resumenAnt?.conteo.falta),
    detalle: `Días laborables sin marcación ni permiso${comparado}${resumenAnt ? numero(resumenAnt.conteo.falta) : ""}`,
  },
  {
    titulo: "Permisos",
    valor: numero(resumen.conteo.permiso),
    icono: "documento",
    variacion: null,
    detalle: `Ausencias justificadas: no cuentan como falta${comparado}${resumenAnt ? numero(resumenAnt.conteo.permiso) : ""}`,
  },
];

// El aviso de teléfonos lleva a la ficha del primero pendiente.
const usuarioTelefono = (primerTelefono as { usuario_id: string }[] | null)?.[0]?.usuario_id;
const { data: fichaTelefono } = usuarioTelefono
  ? await sb.from("personal").select("id").eq("usuario_id", usuarioTelefono).maybeSingle()
  : { data: null };

// ── Nivel 2: requiere atención (solo lo que tenga pendientes) ──
const atencion = [
  porRevisar && {
    texto: plural(porRevisar, "marcación por revisar", "marcaciones por revisar"),
    enlace: "/asistencia/revision",
    icono: "escudo" as NombreIcono,
  },
  telefonosPendientes && {
    texto: plural(telefonosPendientes, "teléfono por aprobar", "teléfonos por aprobar"),
    enlace: fichaTelefono ? `/personal/${fichaTelefono.id}#dispositivo` : "/personal",
    icono: "usuarios" as NombreIcono,
  },
  conFaltas.length && {
    texto: `${plural(conFaltas.length, "persona", "personas")} con ${UMBRAL_FALTAS} o más faltas`,
    enlace: "#seccion-personas",
    icono: "alerta" as NombreIcono,
  },
  sinJornada && {
    texto: `${plural(sinJornada, "persona", "personas")} sin jornada asignada`,
    enlace: "/personal?jornada=no",
    icono: "calendario" as NombreIcono,
  },
  sinCuenta && {
    texto: `${plural(sinCuenta, "persona", "personas")} sin cuenta de acceso`,
    enlace: "/personal?cuenta=no",
    icono: "escudo" as NombreIcono,
  },
].filter((x): x is { texto: string; enlace: string; icono: NombreIcono } => Boolean(x));

// ── Formato ──
const DIAS_CORTOS = ["dom", "lun", "mar", "mié", "jue", "vie", "sáb"];
const MESES_CORTOS = [
  "ene",
  "feb",
  "mar",
  "abr",
  "may",
  "jun",
  "jul",
  "ago",
  "sep",
  "oct",
  "nov",
  "dic",
];
const dd = (f: string) => `${Number(f.slice(8, 10))} ${MESES_CORTOS[Number(f.slice(5, 7)) - 1]}`;
const diaTexto = (f: string) => `${DIAS_CORTOS[new Date(`${f}T00:00:00Z`).getUTCDay()]} ${dd(f)}`;
const enlacePeriodo = (per: Periodo) => {
  const u = new URL(Astro.url);
  u.searchParams.set("periodo", per);
  return u.pathname + u.search;
};
const hoySegmentos = [
  { etiqueta: "Presentes", valor: hoyConteo.presente, clase: "presente" as const },
  { etiqueta: "Tarde", valor: hoyConteo.tarde, clase: "tarde" as const },
  { etiqueta: "Permiso", valor: hoyConteo.permiso, clase: "permiso" as const },
  { etiqueta: "Falta", valor: hoyConteo.falta, clase: "falta" as const },
  { etiqueta: "Sin marcar", valor: pendientesHoy, clase: "pendiente" as const },
];
---

<PanelLayout titulo="Panel" subtitulo={fechaLarga(hoy)} amplio>
  <Fragment slot="acciones">
    <Boton href={`/reportes?fecha=${hoy}`} variante="secundario">
      <Icono nombre="documento" tamano={18} />
      Planilla de hoy
    </Boton>
    {perfil.rol === "directiva" && (
      <Boton href="/personal/nuevo">
        <Icono nombre="mas" tamano={18} />
        Nuevo personal
      </Boton>
    )}
  </Fragment>

  {esDemo && (
    <p class="demo">
      <Icono nombre="info" tamano={16} />
      <span>Datos de demostración: no corresponden a marcaciones reales.</span>
      {perfil.rol === "directiva" && <a href="/configuracion#demo">Eliminar</a>}
    </p>
  )}

  <!-- Filtros -->
  <div class="controles">
    <nav class="segmentado" aria-label="Período">
      {(
        [
          ["mes", "Este mes"],
          ["30d", "30 días"],
          ["anterior", "Mes anterior"],
        ] as [Periodo, string][]
      ).map(([v, t]) => (
        <a href={enlacePeriodo(v)} aria-current={periodo === v ? "true" : undefined}>
          {t}
        </a>
      ))}
    </nav>
    <form method="get" class="filtro-cat" data-autoenviar>
      <input type="hidden" name="periodo" value={periodo} />
      <label for="panel-cat" class="visualmente-oculto">
        Categoría
      </label>
      <select id="panel-cat" name="categoria">
        <option value="">Todas las categorías</option>
        {categorias.map((c) => (
          <option value={c.id} selected={c.id === categoriaId}>
            {c.nombre}
          </option>
        ))}
      </select>
      <noscript>
        <button type="submit">Aplicar</button>
      </noscript>
    </form>
    <span
      class="rango"
      title={
        resumenAnt
          ? `Comparado con ${fechaCorta(rango.anterior.desde)} – ${fechaCorta(rango.anterior.hasta)}`
          : undefined
      }
    >
      {fechaCorta(rango.desde)} – {fechaCorta(rango.hasta)}
    </span>
  </div>

  <div class="tablero">
    <!-- Nivel 1 · Hoy -->
    {mostrarHoy && (
      <section class="hoy" aria-labelledby="titulo-hoy" data-datos>
        <div class="hoy-cabeza">
          <h2 id="titulo-hoy">Hoy</h2>
          <p>
            {feriadoHoy
              ? `Feriado: ${feriadoHoy.descripcion}`
              : `${numero(hoyConteo.presente + hoyConteo.tarde)} de ${numero(laborablesHoy)} han llegado`}
          </p>
        </div>
        <BarraApilada segmentos={hoySegmentos} soloConValor />
      </section>
    )}

    <!-- Nivel 1 · Indicadores del período -->
    <dl class="kpis" aria-label="Indicadores del período" data-datos>
      {kpis.map((k) => (
        <div class="kpi" tabindex="0" aria-describedby={`kpi-${k.titulo}`}>
          <dt>
            <Icono nombre={k.icono} tamano={16} class="kpi-icono" />
            {k.titulo}
          </dt>
          <dd class="valor">
            {k.valor}
            {k.variacion && (
              <span
                class:list={["variacion", k.variacion.mejora ? "mejora" : "empeora"]}
                title="Frente al período anterior"
              >
                <Icono nombre={k.variacion.sube ? "tendencia" : "tendenciaBaja"} tamano={14} />
                {k.variacion.texto}
              </span>
            )}
          </dd>
          <dd class="detalle" id={`kpi-${k.titulo}`} role="tooltip">
            {k.detalle}
          </dd>
        </div>
      ))}
    </dl>

    <!-- Nivel 2 · Requiere atención -->
    <section class="atencion" aria-labelledby="titulo-atencion" data-datos>
      <h2 id="titulo-atencion">Requiere atención</h2>
      {atencion.length ? (
        <ul>
          {atencion.map((a) => (
            <li>
              <a href={a.enlace}>
                <Icono nombre={a.icono} tamano={18} />
                <span>{a.texto}</span>
                <Icono nombre="siguiente" tamano={16} class="ir" />
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <p class="al-dia">
          <Icono nombre="exito" tamano={18} />
          Todo al día.
        </p>
      )}
    </section>

    <!-- Columna lateral (en laptops y celular: entre «Requiere atención» y el análisis) -->
    <aside class="lateral" aria-label="Resumen complementario">
      <Tarjeta
        titulo={periodo === "30d" ? "Últimos 30 días" : `Calendario · ${rango.etiqueta}`}
        datos
      >
        <CalendarioPeriodo semanas={semanas} />
      </Tarjeta>
      {mostrarHoy && !feriadoHoy && (
        <Tarjeta titulo="Llegadas de hoy" descripcion="Por categoría" datos>
          <HoyPorCategoria filas={progresoHoy} />
        </Tarjeta>
      )}
      <Tarjeta
        titulo="Ausentes esta semana"
        descripcion="Permisos de hoy y de los próximos 7 días"
        datos
      >
        <ListaAusentes
          ausentes={ausentes}
          total={totalAusentes ?? ausentes.length}
          hoy={hoy}
          feriado={proximoFeriado}
        />
      </Tarjeta>
    </aside>

    <!-- Nivel 3 · Análisis bajo demanda -->
    <section class="analisis" aria-labelledby="titulo-analisis">
      <h2 id="titulo-analisis">Análisis del período</h2>
      {registros.length === 0 ? (
        <p class="vacio" data-datos>
          No hay registros de asistencia en este período. El análisis aparecerá cuando el personal
          empiece a marcar.
        </p>
      ) : (
        <div class="secciones">
          <Seccion
            id="seccion-tendencia"
            titulo="Tendencia de asistencia"
            resumen={concl.tendencia}
            abierta
          >
            <Figura
              plana
              titulo="Tendencia de asistencia"
              descripcion={`Porcentaje diario de jornadas cumplidas · ${rango.etiqueta} · ${numero(Math.round(resumen.horasTotales))} horas trabajadas${omitidosTendencia ? ` · ${plural(omitidosTendencia, "día", "días")} con poco personal programado no se grafica${omitidosTendencia === 1 ? "" : "n"}` : ""}`}
              columnas={["Fecha", "Asistencia", "Presentes", "Tarde", "Faltas", "Permisos"]}
              filas={serie.map((s) => [
                fechaCorta(s.clave),
                porcentaje(s.valor, 2),
                s.conteo.presente,
                s.conteo.tarde,
                s.conteo.falta,
                s.conteo.permiso,
              ])}
            >
              <GraficaLinea
                puntos={serieTendencia.map((s) => ({
                  etiqueta: dd(s.clave),
                  fecha: s.clave,
                  valor: s.valor,
                  detalle: `${diaTexto(s.clave)} · ${plural(s.conteo.falta, "falta", "faltas")}, ${s.conteo.tarde} tarde`,
                }))}
                referencia={{
                  valor: resumen.asistencia,
                  etiqueta: `Prom. ${porcentaje(resumen.asistencia)}`,
                }}
              />
            </Figura>
          </Seccion>

          <Seccion id="seccion-dias" titulo="Por día de la semana" resumen={concl.dias}>
            <Figura
              plana
              titulo="Asistencia por día de la semana"
              descripcion="Rayado: el día con la asistencia más baja."
              columnas={["Día", "Asistencia", "Tardanza", "Faltas"]}
              filas={dias.map((d) => [
                NOMBRE_DIA[d.dia as DiaSemana],
                porcentaje(d.asistencia, 2),
                porcentaje(d.tardanza, 2),
                d.faltas,
              ])}
            >
              <BarrasHorizontales
                maximo={100}
                items={dias.map((d) => ({
                  etiqueta: NOMBRE_DIA[d.dia as DiaSemana],
                  valor: d.asistencia,
                  texto: porcentaje(d.asistencia),
                  detalle: `${plural(d.faltas, "falta", "faltas")} · ${porcentaje(d.tardanza)} tarde`,
                  resaltar: d.asistencia === peorDia && dias.length > 1,
                }))}
              />
            </Figura>
          </Seccion>

          <Seccion id="seccion-llegadas" titulo="Hora de llegada" resumen={concl.llegadas}>
            <Figura
              plana
              titulo="Hora de llegada"
              descripcion={`Minutos después de la hora de entrada. Retraso promedio de quienes llegan tarde: ${resumen.retrasoPromedioMin} min.`}
              columnas={["Tramo", "Llegadas", "Porcentaje"]}
              filas={llegadas.map((l) => [
                l.etiqueta,
                l.valor,
                porcentaje(totalLlegadas ? (l.valor / totalLlegadas) * 100 : 0),
              ])}
            >
              <DistribucionLlegadas tramos={llegadas} />
            </Figura>
          </Seccion>

          <Seccion id="seccion-categorias" titulo="Por categoría" resumen={concl.categorias}>
            <Figura
              plana
              titulo="Asistencia por categoría"
              descripcion="Asistencia y puntualidad de cada grupo del personal."
              columnas={["Categoría", "Personas", "Asistencia", "Puntualidad", "Faltas"]}
              filas={cats.map((c) => [
                c.cat?.nombre ?? "—",
                c.personas,
                porcentaje(c.asistencia, 2),
                porcentaje(c.puntualidad, 2),
                c.conteo.falta,
              ])}
            >
              <BarrasHorizontales
                maximo={100}
                items={cats.map((c) => ({
                  etiqueta: c.cat?.nombre ?? "—",
                  valor: c.asistencia,
                  texto: porcentaje(c.asistencia),
                  color: c.cat?.color,
                  detalle: `${c.personas} pers. · puntualidad ${porcentaje(c.puntualidad)}`,
                }))}
              />
            </Figura>
          </Seccion>

          <Seccion
            id="seccion-personas"
            titulo="Seguimiento individual"
            resumen={concl.personas}
            tono={conFaltas.length ? "alerta" : "normal"}
          >
            <Figura
              plana
              titulo="Seguimiento individual"
              descripcion="Personas con más faltas y tardanzas en el período."
              columnas={["Persona", "Faltas", "Tardanzas", "Asistencia"]}
              filas={criticas.map((c) => {
                const x = personaPorId.get(c.personalId);
                return [
                  x ? `${x.nombre} ${x.apellido}` : "—",
                  c.faltas,
                  c.tardanzas,
                  porcentaje(c.asistencia, 2),
                ];
              })}
            >
              {criticas.length ? (
                <ol class="criticas">
                  {criticas.map((c) => {
                    const x = personaPorId.get(c.personalId);
                    const cat = x ? catPorId.get(x.categoria_id) : undefined;
                    return (
                      <li>
                        <span
                          class="ini"
                          style={`--c: ${cat?.color ?? "#64748b"}`}
                          aria-hidden="true"
                        >
                          {(x?.nombre[0] ?? "") + (x?.apellido[0] ?? "")}
                        </span>
                        <span class="quien">
                          {x ? (
                            <a href={`/personal/${x.id}`}>
                              {x.nombre} {x.apellido}
                            </a>
                          ) : (
                            "—"
                          )}
                          <small>{cat?.nombre}</small>
                        </span>
                        <span class="cifras">
                          <strong>{c.faltas}</strong> {c.faltas === 1 ? "falta" : "faltas"} ·{" "}
                          <strong>{c.tardanzas}</strong> tarde
                        </span>
                      </li>
                    );
                  })}
                </ol>
              ) : (
                <p class="vacio">Nadie acumula faltas ni tardanzas en el período.</p>
              )}
            </Figura>
          </Seccion>
        </div>
      )}
    </section>
  </div>
</PanelLayout>

<style>
  /* ── Cuadrícula del panel ──
   * Orden en el DOM: hoy · indicadores · atención · lateral · análisis.
   * Pantalla ancha: la lateral ocupa su propia columna, fija al desplazarse. */
  .tablero {
    display: flex;
    flex-direction: column;
  }
  .lateral {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 19rem), 1fr));
    gap: var(--esp-4);
    align-items: start;
    margin-bottom: var(--separacion-bloques);
  }
  @media (min-width: 1400px) {
    .tablero {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 21rem;
      grid-template-rows: auto auto auto auto 1fr;
      column-gap: var(--esp-6);
    }
    .tablero > :not(.lateral) {
      grid-column: 1;
    }
    .lateral {
      grid-column: 2;
      grid-row: 1 / span 5;
      grid-template-columns: 1fr;
      position: sticky;
      top: calc(56px + var(--esp-6));
      align-self: start;
      margin-bottom: 0;
    }
  }
  /* Aviso de demostración en una línea */
  .demo {
    display: flex;
    align-items: baseline;
    gap: var(--esp-2);
    margin: 0 0 var(--esp-5);
    font-size: var(--texto-sm);
    color: var(--color-alerta);
  }
  .demo :global(.icono) {
    align-self: center;
    flex: none;
  }
  .demo a {
    font-weight: var(--peso-medio);
    white-space: nowrap;
  }

  /* Filtros */
  .controles {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--esp-3);
    margin-bottom: var(--esp-6);
  }
  .segmentado {
    display: inline-flex;
    padding: 4px;
    gap: 2px;
    background: var(--color-lateral);
    border-radius: var(--radio);
  }
  .segmentado a {
    display: inline-flex;
    align-items: center;
    min-height: 36px;
    padding: 0 var(--esp-3);
    border-radius: var(--radio-sm);
