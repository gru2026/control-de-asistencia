  /* Detalle: aparece al pasar el mouse o al enfocar/tocar el indicador */
  .detalle {
    position: absolute;
    left: var(--esp-4);
    right: var(--esp-4);
    top: calc(100% - var(--esp-2));
    z-index: 5;
    padding: var(--esp-3) var(--esp-4);
