---
import PanelLayout from "@/layouts/PanelLayout.astro";
import Tarjeta from "@/components/ui/Tarjeta.astro";
import Boton from "@/components/ui/Boton.astro";
import Alerta from "@/components/ui/Alerta.astro";
import Icono, { type NombreIcono } from "@/components/ui/Icono.astro";
import Figura from "@/components/graficas/Figura.astro";
import GraficaLinea from "@/components/graficas/GraficaLinea.astro";
import BarrasHorizontales from "@/components/graficas/BarrasHorizontales.astro";
import Histograma from "@/components/graficas/Histograma.astro";
import BarraApilada from "@/components/graficas/BarraApilada.astro";
import { fechaCorta, fechaLarga, hoyEnZona } from "@/lib/fecha";
import { listarCategorias } from "@/lib/datos/categorias";
import { cargarRegistros, rangoPeriodo, type Periodo } from "@/lib/datos/asistencia";
import { aExcepcion, aJornada, type FilaHorario, type FilaJornada } from "@/lib/datos/jornadas";
import { resolverJornada } from "@/lib/reglas/jornada";
import {
  contar,
  hallazgos,
  histogramaLlegadas,
  personasCriticas,
  porCategoria,
  porDiaSemana,
  resumir,
  serieDiaria,
  variacion,
} from "@/lib/reglas/estadisticas";
import { NOMBRE_DIA, type DiaSemana } from "@/types";

const sb = Astro.locals.supabase;
const perfil = Astro.locals.perfil!;
const hoy = hoyEnZona();
const p = Astro.url.searchParams;

const categorias = await listarCategorias(sb);
const catPorId = new Map(categorias.map((c) => [c.id, c]));
const periodo: Periodo =
  (["mes", "anterior", "30d"] as const).find((x) => x === p.get("periodo")) ?? "mes";
const categoriaId = catPorId.has(p.get("categoria") ?? "") ? p.get("categoria") : null;
const rango = rangoPeriodo(periodo, hoy);

// ── Datos ──
interface FilaPersona {
  id: string;
  nombre: string;
  apellido: string;
  categoria_id: string;
  usuario_id: string | null;
  jornada_id: string | null;
  jornadas: FilaJornada | null;
  horarios: FilaHorario[];
}
let qPersonal = sb
  .from("personal")
  .select(
    "id, nombre, apellido, categoria_id, usuario_id, jornada_id, jornadas(id, nombre, hora_entrada, hora_salida, tolerancia_min, pausa_min, dias_laborables, activa, nocturna), horarios(dia_semana, hora_entrada, hora_salida, tolerancia_min, libre)",
  )
  .eq("estado", "activo");
if (categoriaId) qPersonal = qPersonal.eq("categoria_id", categoriaId);

const [
  registros,
  anteriores,
  { data: personalData },
  { data: feriadoHoy },
  { count: telefonosPendientes },
] = await Promise.all([
  cargarRegistros(sb, rango.desde, rango.hasta, categoriaId),
  cargarRegistros(sb, rango.anterior.desde, rango.anterior.hasta, categoriaId),
  qPersonal.limit(1000),
  sb.from("feriados").select("descripcion").eq("fecha", hoy).maybeSingle(),
  sb.from("dispositivos").select("id", { count: "exact", head: true }).eq("estado", "pendiente"),
]);
const personas = (personalData ?? []) as unknown as FilaPersona[];
const personaPorId = new Map(personas.map((x) => [x.id, x]));

const resumen = resumir(registros);
const resumenAnt = anteriores.length ? resumir(anteriores) : null;
const esDemo = registros.some((r) => r.esDemo);
const porRevisar = registros.filter((r) => r.senaladoPendiente).length;

// Hoy
const deHoy = registros.filter((r) => r.fecha === hoy);
const hoyConteo = contar(deHoy);
const laborablesHoy = feriadoHoy
  ? 0
  : personas.filter((x) =>
      resolverJornada({
        fecha: hoy,
        jornada: x.jornadas ? aJornada(x.jornadas) : null,
        excepciones: x.horarios.map(aExcepcion),
      }),
    ).length;
const pendientesHoy = Math.max(0, laborablesHoy - hoyConteo.total);
const mostrarHoy = rango.hasta === hoy;

// Gráficas
const serie = serieDiaria(registros);
const dias = porDiaSemana(registros);
const peorDia = dias.length ? Math.min(...dias.map((d) => d.asistencia)) : null;
const llegadas = histogramaLlegadas(registros);
const cats = porCategoria(registros)
  .map((c) => ({ ...c, cat: catPorId.get(c.categoriaId) }))
  .sort((a, b) => (a.cat?.orden ?? 99) - (b.cat?.orden ?? 99));
const criticas = personasCriticas(registros, 6);
const lectura = hallazgos(registros, (id) => catPorId.get(id)?.nombre ?? "Una categoría");

// Nómina
const sinCuenta = personas.filter((x) => !x.usuario_id).length;
const sinJornada = personas.filter((x) => !x.jornada_id).length;

// ── Formato ──
const fmtVar = (
  v: number | null,
  inverso = false,
  unidad: [string, string] = ["punto", "puntos"],
) => {
  if (v === null || v === 0) return null;
  const mejora = inverso ? v < 0 : v > 0;
  return { texto: `${v > 0 ? "+" : ""}${v} ${Math.abs(v) === 1 ? unidad[0] : unidad[1]}`, mejora };
};
const pl = (n: number, uno: string, varios: string) => `${n} ${n === 1 ? uno : varios}`;
const kpis: {
  titulo: string;
  valor: string;
  detalle?: string;
  icono: NombreIcono;
  var?: ReturnType<typeof fmtVar>;
  enlace?: string;
}[] = [
  {
    titulo: "Asistencia del período",
    valor: resumen.conteo.total ? `${resumen.asistencia}%` : "—",
    detalle: `${resumen.conteo.presente + resumen.conteo.tarde + resumen.conteo.permiso} de ${resumen.conteo.total} jornadas`,
    icono: "tendencia",
    var: fmtVar(variacion(resumen.asistencia, resumenAnt?.asistencia ?? null)),
  },
  {
    titulo: "Puntualidad",
    valor: resumen.conteo.total ? `${resumen.puntualidad}%` : "—",
    detalle: pl(resumen.conteo.tarde, "llegada tarde", "llegadas tarde"),
    icono: "reloj",
    var: fmtVar(variacion(resumen.puntualidad, resumenAnt?.puntualidad ?? null)),
  },
  {
    titulo: "Faltas",
    valor: String(resumen.conteo.falta),
    detalle: pl(resumen.conteo.permiso, "permiso justificado", "permisos justificados"),
    icono: "alerta",
    var: resumenAnt
      ? fmtVar(resumen.conteo.falta - resumenAnt.conteo.falta, true, ["falta", "faltas"])
      : null,
  },
  {
    titulo: "Retraso promedio",
    valor: resumen.conteo.tarde ? `${resumen.retrasoPromedioMin} min` : "—",
    detalle: "en las llegadas tarde",
    icono: "tendenciaBaja",
    var: resumenAnt?.conteo.tarde
      ? fmtVar(resumen.retrasoPromedioMin - resumenAnt.retrasoPromedioMin, true, ["min", "min"])
      : null,
  },
  {
    titulo: "Horas trabajadas",
    valor: Math.round(resumen.horasTotales).toLocaleString("es-VE"),
    detalle: `${resumen.personas} personas con registros`,
    icono: "calendario",
  },
  {
    titulo: "Por revisar",
    valor: String(porRevisar + (telefonosPendientes ?? 0)),
    detalle: `${porRevisar} marcaciones señaladas · ${telefonosPendientes ?? 0} teléfonos`,
    icono: "escudo",
  },
];

const dd = (f: string) => fechaCorta(f).slice(0, 5);
const enlacePeriodo = (per: Periodo) => {
  const u = new URL(Astro.url);
  u.searchParams.set("periodo", per);
  return u.pathname + u.search;
};
const enlaceCategoria = (id: string | null) => {
  const u = new URL(Astro.url);
  if (id) u.searchParams.set("categoria", id);
  else u.searchParams.delete("categoria");
  return u.pathname + u.search;
};
---

<PanelLayout titulo="Panel" subtitulo={fechaLarga(hoy)}>
  <Fragment slot="acciones">
    <Boton href={`/reportes?fecha=${hoy}`} variante="secundario">
      <Icono nombre="documento" tamano={18} />
      Planilla de hoy
    </Boton>
    {perfil.rol === "directiva" && (
      <Boton href="/personal/nuevo">
        <Icono nombre="mas" tamano={18} />
        Nuevo personal
      </Boton>
    )}
  </Fragment>

  {esDemo && (
    <div class="aviso">
      <Alerta tipo="alerta">
        <strong>Datos de demostración.</strong> La asistencia mostrada fue generada para probar el
        sistema y no corresponde a marcaciones reales.{" "}
        {perfil.rol === "directiva" && (
          <a href="/configuracion#demo">Eliminar datos de demostración</a>
        )}
      </Alerta>
    </div>
  )}

  <!-- Filtros del panel -->
  <div class="controles">
    <nav class="segmentado" aria-label="Período">
      {(
        [
          ["mes", "Este mes"],
          ["30d", "Últimos 30 días"],
          ["anterior", "Mes anterior"],
        ] as [Periodo, string][]
      ).map(([v, t]) => (
        <a href={enlacePeriodo(v)} aria-current={periodo === v ? "true" : undefined}>
          {t}
        </a>
      ))}
    </nav>
    <form method="get" class="filtro-cat" data-autoenviar>
      <input type="hidden" name="periodo" value={periodo} />
      <label for="panel-cat" class="visualmente-oculto">
        Categoría
      </label>
      <select id="panel-cat" name="categoria">
        <option value="">Todas las categorías</option>
        {categorias.map((c) => (
          <option value={c.id} selected={c.id === categoriaId}>
            {c.nombre}
          </option>
        ))}
      </select>
      <noscript>
        <button type="submit">Aplicar</button>
      </noscript>
    </form>
    <p class="rango">
      {fechaCorta(rango.desde)} – {fechaCorta(rango.hasta)}
      {resumenAnt && (
        <span>
          {" "}
          · comparado con {fechaCorta(rango.anterior.desde)} – {fechaCorta(rango.anterior.hasta)}
        </span>
      )}
    </p>
  </div>

  <!-- Hoy -->
  {mostrarHoy && (
    <section class="hoy" aria-labelledby="titulo-hoy" data-datos>
      <div class="hoy-cabeza">
        <h2 id="titulo-hoy">Hoy</h2>
        <p>
          {feriadoHoy
            ? `Feriado: ${feriadoHoy.descripcion}`
            : `${hoyConteo.presente + hoyConteo.tarde} de ${laborablesHoy} personas han llegado`}
        </p>
      </div>
      <BarraApilada
        segmentos={[
          { etiqueta: "Presentes", valor: hoyConteo.presente, clase: "presente" },
          { etiqueta: "Tarde", valor: hoyConteo.tarde, clase: "tarde" },
          { etiqueta: "Permiso", valor: hoyConteo.permiso, clase: "permiso" },
          { etiqueta: "Falta", valor: hoyConteo.falta, clase: "falta" },
          { etiqueta: "Sin marcar", valor: pendientesHoy, clase: "pendiente" },
        ]}
      />
    </section>
  )}

  <!-- Indicadores: una cifra principal y una fila de cifras secundarias en una sola superficie -->
  <section class="resumen" aria-label="Indicadores del período" data-datos>
    {(() => {
      const [principal, ...resto] = kpis;
      return (
        <>
          <div class="principal">
            <span class="titulo">{principal!.titulo}</span>
            <span class="valor-principal">{principal!.valor}</span>
            <span class="detalle">{principal!.detalle}</span>
            {principal!.var && (
              <span class:list={["variacion", principal!.var.mejora ? "mejora" : "empeora"]}>
                <Icono nombre={principal!.var.mejora ? "tendencia" : "tendenciaBaja"} tamano={16} />
                {principal!.var.texto} frente al período anterior
              </span>
            )}
          </div>
          <dl class="secundarios">
            {resto.map((k) => (
              <div class="kpi">
                <dt class="titulo">
                  <Icono nombre={k.icono} tamano={16} class="kpi-icono" />
                  {k.titulo}
                </dt>
                <dd class="valor">{k.valor}</dd>
                <dd class="detalle">{k.detalle}</dd>
                {k.var && (
                  <dd class:list={["variacion", k.var.mejora ? "mejora" : "empeora"]}>
                    <Icono nombre={k.var.mejora ? "tendencia" : "tendenciaBaja"} tamano={14} />
                    {k.var.texto}
                  </dd>
                )}
              </div>
            ))}
          </dl>
        </>
      );
    })()}
  </section>

  {lectura.length > 0 && (
    <section class="lectura" aria-labelledby="titulo-lectura" data-datos>
      <Icono nombre="info" tamano={20} class="lectura-icono" />
      <div>
        <h2 id="titulo-lectura">Lectura rápida</h2>
        <ul>
          {lectura.map((t) => (
            <li>{t}</li>
          ))}
        </ul>
      </div>
    </section>
  )}

  {registros.length === 0 ? (
    <Tarjeta datos>
      <p class="vacio">
        No hay registros de asistencia en este período. Las gráficas aparecerán cuando el personal
        empiece a marcar.
      </p>
    </Tarjeta>
  ) : (
    <div class="graficas">
      <Figura
        class="ancha"
        titulo="Tendencia de asistencia"
        descripcion={`Porcentaje diario de jornadas cumplidas (presente, tarde o permiso) · ${rango.etiqueta}`}
        columnas={["Fecha", "Asistencia", "Presentes", "Tarde", "Faltas", "Permisos"]}
        filas={serie.map((s) => [
          fechaCorta(s.clave),
          `${s.valor}%`,
          s.conteo.presente,
          s.conteo.tarde,
          s.conteo.falta,
          s.conteo.permiso,
        ])}
      >
        <GraficaLinea
          puntos={serie.map((s) => ({
            etiqueta: dd(s.clave),
            valor: s.valor,
            detalle: `${fechaCorta(s.clave)}: ${s.valor}% · ${s.conteo.falta} faltas, ${s.conteo.tarde} tarde`,
          }))}
          referencia={{ valor: resumen.asistencia, etiqueta: `Promedio ${resumen.asistencia}%` }}
        />
      </Figura>

      <Figura
        titulo="Asistencia por día de la semana"
        descripcion="Ayuda a detectar días críticos. Rayado: el día más bajo."
        columnas={["Día", "Asistencia", "Tardanza", "Faltas"]}
        filas={dias.map((d) => [
          NOMBRE_DIA[d.dia as DiaSemana],
          `${d.asistencia}%`,
          `${d.tardanza}%`,
          d.faltas,
        ])}
      >
        <BarrasHorizontales
          maximo={100}
          items={dias.map((d) => ({
            etiqueta: NOMBRE_DIA[d.dia as DiaSemana],
            valor: d.asistencia,
            detalle: `${pl(d.faltas, "falta", "faltas")} · ${d.tardanza}% tarde`,
            resaltar: d.asistencia === peorDia && dias.length > 1,
          }))}
        />
      </Figura>

      <Figura
        titulo="Hora de llegada"
        descripcion="Minutos respecto a la hora de entrada. Sirve para evaluar la tolerancia."
        columnas={["Tramo", "Llegadas"]}
        filas={llegadas.map((l) => [l.etiqueta, l.valor])}
      >
        <Histograma
          columnas={llegadas.map((l) => ({
            etiqueta: l.etiqueta,
            valor: l.valor,
            tipo:
              l.clave === "antes" || l.clave === "0-5" || l.clave === "6-15"
                ? "bien"
                : l.clave === "16-30"
                  ? "alerta"
                  : "mal",
          }))}
        />
      </Figura>

      <Figura
        titulo="Asistencia por categoría"
        descripcion="Comparación entre docentes, secretaría, cocina, obreros y vigilancia."
        columnas={["Categoría", "Personas", "Asistencia", "Puntualidad", "Faltas"]}
        filas={cats.map((c) => [
          c.cat?.nombre ?? "—",
          c.personas,
          `${c.asistencia}%`,
          `${c.puntualidad}%`,
          c.conteo.falta,
        ])}
      >
        <BarrasHorizontales
          maximo={100}
          items={cats.map((c) => ({
            etiqueta: c.cat?.nombre ?? "—",
            valor: c.asistencia,
            color: c.cat?.color,
            detalle: `${c.personas} pers. · puntualidad ${c.puntualidad}%`,
          }))}
        />
      </Figura>

      <Figura
        titulo="Seguimiento individual"
        descripcion="Personas con más faltas y tardanzas en el período."
        columnas={["Persona", "Faltas", "Tardanzas", "Asistencia"]}
        filas={criticas.map((c) => {
          const x = personaPorId.get(c.personalId);
          return [x ? `${x.nombre} ${x.apellido}` : "—", c.faltas, c.tardanzas, `${c.asistencia}%`];
        })}
      >
        {criticas.length ? (
          <ol class="criticas">
            {criticas.map((c) => {
              const x = personaPorId.get(c.personalId);
              const cat = x ? catPorId.get(x.categoria_id) : undefined;
              return (
                <li>
                  <span class="ini" style={`--c: ${cat?.color ?? "#64748b"}`} aria-hidden="true">
                    {(x?.nombre[0] ?? "") + (x?.apellido[0] ?? "")}
                  </span>
                  <span class="quien">
                    {x ? (
                      <a href={`/personal/${x.id}`}>
                        {x.nombre} {x.apellido}
                      </a>
                    ) : (
                      "—"
                    )}
                    <small>{cat?.nombre}</small>
                  </span>
                  <span class="cifras">
                    <strong>{c.faltas}</strong> {c.faltas === 1 ? "falta" : "faltas"} ·{" "}
                    <strong>{c.tardanzas}</strong> tarde
                  </span>
                </li>
              );
            })}
          </ol>
        ) : (
          <p class="vacio">Nadie acumula faltas ni tardanzas en el período.</p>
        )}
      </Figura>
    </div>
  )}

  <!-- Nómina -->
  <section class="nomina" aria-labelledby="titulo-nomina" data-datos>
    <h2 id="titulo-nomina">Nómina{categoriaId ? ` · ${catPorId.get(categoriaId)?.nombre}` : ""}</h2>
    <ul>
      <li>
        <a href={`/personal${categoriaId ? `?categoria=${categoriaId}` : ""}`}>
          <strong>{personas.length}</strong> personas activas
        </a>
      </li>
      <li class:list={[sinCuenta > 0 && "atencion"]}>
        <a href="/personal?cuenta=no">
          <strong>{sinCuenta}</strong> sin cuenta de acceso
        </a>
      </li>
      <li class:list={[sinJornada > 0 && "atencion"]}>
        <a href="/personal?jornada=no">
          <strong>{sinJornada}</strong> sin jornada asignada
        </a>
      </li>
      <li>
        <a href={enlaceCategoria(null)}>
          <strong>{categorias.filter((c) => c.activa).length}</strong> categorías
        </a>
      </li>
    </ul>
  </section>
</PanelLayout>

<style>
  .aviso {
    margin-bottom: var(--esp-4);
  }
  .controles {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--esp-3) var(--esp-4);
    margin-bottom: var(--esp-6);
  }
  .segmentado {
    display: inline-flex;
    padding: 4px;
    gap: 2px;
    background: var(--color-lateral);
    border-radius: var(--radio);
  }
  .segmentado a {
    display: inline-flex;
    align-items: center;
    min-height: 36px;
    padding: 0 var(--esp-3);
    border-radius: var(--radio-sm);
    color: var(--color-texto-suave);
    font-size: var(--texto-sm);
    font-weight: var(--peso-medio);
    text-decoration: none;
    white-space: nowrap;
  }
  .segmentado a:hover:not([aria-current]) {
    color: var(--color-texto);
  }
  .segmentado a[aria-current] {
    background: var(--color-superficie);
    color: var(--color-texto);
    box-shadow: var(--sombra-sm);
  }
  .filtro-cat select {
    min-height: 44px;
    padding: 0 var(--esp-3);
    border: 1px solid var(--color-borde-fuerte);
    border-radius: var(--radio-sm);
    background: var(--color-superficie);
  }
  .rango {
    margin: 0;
    font-size: var(--texto-sm);
    color: var(--color-texto-suave);
  }
  .hoy {
    margin-bottom: var(--esp-4);
    padding: var(--esp-5) var(--esp-6);
    background: var(--color-superficie);
    border: 1px solid var(--color-borde);
    border-radius: var(--radio);
  }
  .hoy-cabeza {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--esp-2);
    margin-bottom: var(--esp-4);
  }
  .hoy h2,
  .nomina h2 {
    font-size: var(--texto-lg);
  }
  .hoy-cabeza p {
    margin: 0;
    color: var(--color-texto-suave);
    font-size: var(--texto-sm);
  }
  /* ── Resumen de indicadores ── */
  .resumen {
    display: grid;
    gap: var(--esp-6);
    margin-bottom: var(--esp-6);
    padding: var(--esp-6);
    background: var(--color-superficie);
    border: 1px solid var(--color-borde);
    border-radius: var(--radio);
  }
  .principal {
    display: flex;
    flex-direction: column;
    gap: var(--esp-2);
  }
  .titulo {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: var(--texto-sm);
    font-weight: var(--peso-medio);
    color: var(--color-texto-suave);
  }
  .valor-principal {
    font-size: var(--texto-3xl);
    font-weight: var(--peso-titulo);
    letter-spacing: var(--tracking-cifra);
    line-height: 1.05;
    font-variant-numeric: tabular-nums;
  }
  .secundarios {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--esp-5) var(--esp-4);
    margin: 0;
    padding-top: var(--esp-6);
    border-top: 1px solid var(--color-borde);
  }
  .kpi {
    display: flex;
    flex-direction: column;
    gap: 6px;
    min-width: 0;
  }
  .kpi dd {
    margin: 0;
