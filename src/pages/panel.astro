  .atencion a {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: var(--esp-3);
    min-height: 52px;
    padding: var(--esp-3) var(--esp-6);
    color: var(--color-texto);
    text-decoration: none;
    transition: background var(--duracion-rapida) var(--curva);
  }
  .atencion a > :global(.icono:first-child) {
    color: var(--color-alerta);
  }
  .atencion a:hover {
    background: var(--color-superficie-hover);
  }
  .atencion a :global(.ir) {
    color: var(--color-texto-tenue);
  }
  .al-dia {
    display: flex;
    align-items: center;
    gap: var(--esp-2);
    margin: 0;
    padding: var(--esp-4) var(--esp-6);
