    transform: translateY(-4px);
    pointer-events: none;
    transition:
      opacity var(--duracion-rapida) var(--curva),
      transform var(--duracion-rapida) var(--curva);
  }
  .kpi:hover .detalle,
  .kpi:focus-visible .detalle,
  .kpi:focus-within .detalle {
    opacity: 1;
    transform: none;
  }
  @media (min-width: 900px) {
    .kpis {
      grid-template-columns: repeat(4, minmax(0, 1fr));
