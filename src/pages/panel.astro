---
import PanelLayout from "@/layouts/PanelLayout.astro";
import Icono, { type NombreIcono } from "@/components/ui/Icono.astro";
import CalendarioPeriodo from "@/components/panel/CalendarioPeriodo.astro";
import HoyPorCategoria from "@/components/panel/HoyPorCategoria.astro";
import ListaAusentes from "@/components/panel/ListaAusentes.astro";
import { sumarDias } from "@/lib/reglas/tiempo";
import Figura from "@/components/graficas/Figura.astro";
import GraficaLinea from "@/components/graficas/GraficaLinea.astro";
import BarrasHorizontales from "@/components/graficas/BarrasHorizontales.astro";
import DistribucionLlegadas from "@/components/graficas/DistribucionLlegadas.astro";
import BarraApilada from "@/components/graficas/BarraApilada.astro";
import { fechaCorta, fechaLarga, hoyEnZona } from "@/lib/fecha";
import { listarCategorias } from "@/lib/datos/categorias";
import { cargarRegistros, rangoPeriodo, type Periodo } from "@/lib/datos/asistencia";
import { aExcepcion, aJornada, type FilaHorario, type FilaJornada } from "@/lib/datos/jornadas";
import { resolverJornada } from "@/lib/reglas/jornada";
import {
  contar,
  calendarioPeriodo,
  conclusiones,
  hoyPorCategoria,
  histogramaLlegadas,
  personasCriticas,
  porCategoria,
  porDiaSemana,
  resumir,
  serieDiaria,
  serieRepresentativa,
} from "@/lib/reglas/estadisticas";
import { NOMBRE_DIA, type DiaSemana } from "@/types";
import Modulo from "@/components/panel/Modulo.astro";
import MiniLinea from "@/components/panel/MiniLinea.astro";
import Anillo from "@/components/panel/Anillo.astro";
import Contador from "@/components/panel/Contador.astro";
import { lecturaPorcentaje } from "@/lib/reglas/estadisticas";
import { numero, plural, porcentaje } from "@/lib/formato";

const sb = Astro.locals.supabase;
const perfil = Astro.locals.perfil!;
const hoy = hoyEnZona();
const p = Astro.url.searchParams;

const categorias = await listarCategorias(sb);
const catPorId = new Map(categorias.map((c) => [c.id, c]));
const periodo: Periodo =
  (["mes", "anterior", "30d"] as const).find((x) => x === p.get("periodo")) ?? "mes";
const categoriaId = catPorId.has(p.get("categoria") ?? "") ? p.get("categoria") : null;
const rango = rangoPeriodo(periodo, hoy);

// ── Datos ──
interface FilaPersona {
  id: string;
  nombre: string;
  apellido: string;
  cedula: string;
  categoria_id: string;
  usuario_id: string | null;
  marca_en_pc: boolean;
  jornada_id: string | null;
  jornadas: FilaJornada | null;
  horarios: FilaHorario[];
}
let qPersonal = sb
  .from("personal")
  .select(
    "id, nombre, apellido, cedula, categoria_id, usuario_id, marca_en_pc, jornada_id, jornadas(id, nombre, hora_entrada, hora_salida, tolerancia_min, pausa_min, dias_laborables, activa, nocturna), horarios(dia_semana, hora_entrada, hora_salida, tolerancia_min, libre)",
  )
  .eq("estado", "activo");
if (categoriaId) qPersonal = qPersonal.eq("categoria_id", categoriaId);

const [
  registros,
  anteriores,
  semanaReciente,
  { data: personalData },
  { data: feriadoHoy },
  { data: feriadosPeriodo },
  { data: proximoFeriado },
  { data: permisosData, count: totalAusentes },
  { data: primerTelefono },
] = await Promise.all([
  cargarRegistros(sb, rango.desde, rango.hasta, categoriaId),
  cargarRegistros(sb, rango.anterior.desde, rango.anterior.hasta, categoriaId),
  cargarRegistros(sb, sumarDias(hoy, -7), hoy, categoriaId),
  qPersonal.limit(1000),
  sb.from("feriados").select("descripcion").eq("fecha", hoy).maybeSingle(),
  sb.from("feriados").select("fecha").gte("fecha", rango.desde).lte("fecha", rango.hasta),
  sb
    .from("feriados")
    .select("fecha, descripcion")
    .gt("fecha", hoy)
    .order("fecha")
    .limit(1)
    .maybeSingle(),
  (() => {
    let q = sb
      .from("permisos")
      .select(
        "personal_id, motivo, fecha_desde, fecha_hasta, personal!inner(nombre, apellido, categoria_id, estado)",
        {
          count: "exact",
        },
      )
      .lte("fecha_desde", sumarDias(hoy, 7))
      .gte("fecha_hasta", hoy)
      .eq("personal.estado", "activo")
      .order("fecha_desde")
      .limit(50);
    if (categoriaId) q = q.eq("personal.categoria_id", categoriaId);
    return q;
  })(),
  sb
    .from("dispositivos")
    .select("id, usuario_id, descripcion")
    .eq("estado", "pendiente")
    .order("creado_en")
    .limit(5),
]);
const personas = (personalData ?? []) as unknown as FilaPersona[];
const personaPorId = new Map(personas.map((x) => [x.id, x]));

const resumen = resumir(registros);
const resumenAnt = anteriores.length ? resumir(anteriores) : null;
const esDemo = registros.some((r) => r.esDemo);
const porRevisar = registros.filter((r) => r.senaladoPendiente).length;

// Hoy
const deHoy = registros.filter((r) => r.fecha === hoy);
const hoyConteo = contar(deHoy);
const laborablesHoy = feriadoHoy
  ? 0
  : personas.filter((x) =>
      resolverJornada({
        fecha: hoy,
        jornada: x.jornadas ? aJornada(x.jornadas) : null,
        excepciones: x.horarios.map(aExcepcion),
      }),
    ).length;
const pendientesHoy = Math.max(0, laborablesHoy - hoyConteo.total);

// ── Columna lateral ──
const semanas = calendarioPeriodo(
  rango.desde,
  rango.hasta,
  serieDiaria(registros),
  ((feriadosPeriodo ?? []) as { fecha: string }[]).map((f) => f.fecha),
  hoy,
);
const esperadosHoy = feriadoHoy
  ? []
  : personas
      .filter((x) =>
        resolverJornada({
          fecha: hoy,
          jornada: x.jornadas ? aJornada(x.jornadas) : null,
          excepciones: x.horarios.map(aExcepcion),
        }),
      )
      .map((x) => ({ personalId: x.id, categoriaId: x.categoria_id }));
const progresoHoy = hoyPorCategoria(esperadosHoy, deHoy)
  .map((p) => ({ ...p, cat: catPorId.get(p.categoriaId) }))
  .sort((a, b) => (a.cat?.orden ?? 99) - (b.cat?.orden ?? 99))
  .map((p) => ({
    nombre: p.cat?.nombre ?? "—",
    color: p.cat?.color ?? "#64748b",
    llegaron: p.llegaron,
    esperados: p.esperados,
  }));
interface FilaPermiso {
  personal_id: string;
  motivo: string;
  fecha_desde: string;
  fecha_hasta: string;
  personal: { nombre: string; apellido: string; categoria_id: string };
}
const ausentes = ((permisosData ?? []) as unknown as FilaPermiso[]).map((p) => ({
  personalId: p.personal_id,
  nombre: `${p.personal.nombre} ${p.personal.apellido}`,
  color: catPorId.get(p.personal.categoria_id)?.color ?? "#64748b",
  motivo: p.motivo,
  desde: p.fecha_desde,
  hasta: p.fecha_hasta,
}));
const mostrarHoy = rango.hasta === hoy;

// Gráficas
const serie = serieDiaria(registros);
// Tendencia sin días de personal mínimo (fines de semana con solo vigilancia)
const serieTendencia = serieRepresentativa(serie);
const omitidosTendencia = serie.length - serieTendencia.length;
const dias = porDiaSemana(registros);
const peorDia = dias.length ? Math.min(...dias.map((d) => d.asistencia)) : null;
const llegadas = histogramaLlegadas(registros);
const totalLlegadas = llegadas.reduce((s, l) => s + l.valor, 0);
const cats = porCategoria(registros)
  .map((c) => ({ ...c, cat: catPorId.get(c.categoriaId) }))
  .sort((a, b) => (a.cat?.orden ?? 99) - (b.cat?.orden ?? 99));
const criticas = personasCriticas(registros, 6);
const masTarde = personasCriticas(registros, 1000)
  .filter((c) => c.tardanzas > 0)
  .sort((a, b) => b.tardanzas - a.tardanzas)
  .slice(0, 6);
const UMBRAL_FALTAS = 3;
const concl = conclusiones(
  registros,
  (id) => catPorId.get(id)?.nombre ?? "Una categoría",
  UMBRAL_FALTAS,
);

// Nómina
// Quien marca en secretaría no necesita cuenta.
const sinCuenta = personas.filter((x) => !x.usuario_id && !x.marca_en_pc).length;
const sinJornada = personas.filter((x) => !x.jornada_id).length;

// Teléfonos por aprobar (se aprueban desde aquí mismo)
const pedidos = (primerTelefono ?? []) as {
  id: string;
  usuario_id: string;
  descripcion: string | null;
}[];
const { data: fichasTelefono } = pedidos.length
  ? await sb
      .from("personal")
      .select("id, nombre, apellido, usuario_id")
      .in(
        "usuario_id",
        pedidos.map((x) => x.usuario_id),
      )
  : { data: [] };
const telefonos = pedidos
  .map((d) => ({
    dispositivo: d,
    ficha: (fichasTelefono ?? []).find((f) => f.usuario_id === d.usuario_id) as
      { id: string; nombre: string; apellido: string } | undefined,
  }))
  .filter((x) => x.ficha);
const esDirectiva = perfil.rol === "directiva";

// ── Formato ──
const DIAS_CORTOS = ["dom", "lun", "mar", "mié", "jue", "vie", "sáb"];
const MESES_CORTOS = [
  "ene",
  "feb",
  "mar",
  "abr",
  "may",
  "jun",
  "jul",
  "ago",
  "sep",
  "oct",
  "nov",
  "dic",
];
const dd = (f: string) => `${Number(f.slice(8, 10))} ${MESES_CORTOS[Number(f.slice(5, 7)) - 1]}`;
const diaTexto = (f: string) => `${DIAS_CORTOS[new Date(`${f}T00:00:00Z`).getUTCDay()]} ${dd(f)}`;
const hoySegmentos = [
  { etiqueta: "Presentes", valor: hoyConteo.presente, clase: "presente" as const },
  { etiqueta: "Tarde", valor: hoyConteo.tarde, clase: "tarde" as const },
  { etiqueta: "Permiso", valor: hoyConteo.permiso, clase: "permiso" as const },
  { etiqueta: "Falta", valor: hoyConteo.falta, clase: "falta" as const },
  { etiqueta: "Sin marcar", valor: pendientesHoy, clase: "pendiente" as const },
];

// ── Vista: Resumen (gráfica) o Acción rápida (compacta). D-53 ──
type Vista = "resumen" | "rapida";
const esVista = (v: string | null | undefined): v is Vista => v === "resumen" || v === "rapida";
const vistaPedida = p.get("vista");
const vista: Vista = esVista(vistaPedida)
  ? vistaPedida
  : esVista(Astro.cookies.get("panel_vista")?.value)
    ? (Astro.cookies.get("panel_vista")!.value as Vista)
    : esDirectiva
      ? "resumen"
      : "rapida";
if (esVista(vistaPedida) && !Astro.request.headers.get("X-Precarga")) {
  Astro.cookies.set("panel_vista", vistaPedida, {
    path: "/",
    maxAge: 60 * 60 * 24 * 365,
    sameSite: "lax",
  });
}

// ── Tareas pendientes (cada una con su botón) ──
const nombreDe = (id: string) => {
  const x = personaPorId.get(id);
  return x ? `${x.nombre} ${x.apellido}` : "Alguien";
};
const salidasPendientes = semanaReciente.filter(
  (r) => r.fecha < hoy && r.horaEntrada && !r.horaSalida,
);
const faltasRecientes = semanaReciente
  .filter((r) => r.estado === "falta")
  .sort((a, b) => b.fecha.localeCompare(a.fecha));
interface Tarea {
  icono: NombreIcono;
  texto: string;
  boton: string;
  /** Acción en ventana, enlace o aprobación directa */
  ventana?: string;
  persona?: string;
  href?: string;
  aprobar?: { personalId: string; dispositivoId: string };
}
const tareas: Tarea[] = [
  ...telefonos.map(({ dispositivo, ficha }) => ({
    icono: "telefono" as NombreIcono,
    texto: `${ficha!.nombre} ${ficha!.apellido} pide aprobar su teléfono${dispositivo.descripcion ? ` (${dispositivo.descripcion})` : ""}`,
    boton: "Aprobar",
    aprobar: { personalId: ficha!.id, dispositivoId: dispositivo.id },
  })),
  ...(porRevisar
    ? [
        {
          icono: "escudo" as NombreIcono,
          texto: plural(porRevisar, "marcación por revisar", "marcaciones por revisar"),
          boton: "Revisar",
          href: "/asistencia/revision",
        },
      ]
    : []),
  ...salidasPendientes.slice(0, 3).map((r) => ({
    icono: "reloj" as NombreIcono,
    texto: `${nombreDe(r.personalId)} no marcó la salida el ${diaTexto(r.fecha)}`,
    boton: "Ver",
    persona: r.personalId,
  })),
  ...faltasRecientes.slice(0, 4).map((r) => ({
    icono: "alerta" as NombreIcono,
    texto: `${nombreDe(r.personalId)} faltó el ${diaTexto(r.fecha)}`,
    boton: "Cargar permiso",
    ventana: `/ventanas/permiso?persona=${r.personalId}&desde=${r.fecha}`,
  })),
  ...(sinJornada
    ? [
        {
          icono: "calendario" as NombreIcono,
          texto: `${plural(sinJornada, "persona", "personas")} sin jornada asignada`,
          boton: "Ver",
          href: "/personal?jornada=no",
        },
      ]
    : []),
  ...(sinCuenta
    ? [
        {
          icono: "usuarios" as NombreIcono,
          texto: `${plural(sinCuenta, "persona", "personas")} sin cuenta de acceso`,
          boton: esDirectiva ? "Crear" : "Ver",
          href: esDirectiva ? "/personal/cuentas" : "/personal?cuenta=no",
        },
      ]
    : []),
];
const masTareas =
  Math.max(0, salidasPendientes.length - 3) + Math.max(0, faltasRecientes.length - 4);
const totalTareas = tareas.length + masTareas;

// ── Frases de la vista Resumen (primera capa: palabras, no tablas) ──
const NOMBRE_PERIODO: Record<Periodo, string> = {
  mes: "Este mes",
  anterior: "Mes anterior",
  "30d": "Últimos 30 días",
};
const hayDatos = resumen.conteo.total > 0;
const llegaronHoy = hoyConteo.presente + hoyConteo.tarde;
const conRegistroHoy = new Set(deHoy.map((r) => r.personalId));
const porApellido = (a: FilaPersona, b: FilaPersona) =>
  a.apellido.localeCompare(b.apellido, "es") || a.nombre.localeCompare(b.nombre, "es");
const sinMarcarHoy = esperadosHoy
  .filter((e) => !conRegistroHoy.has(e.personalId))
  .map((e) => personaPorId.get(e.personalId))
  .filter((x): x is FilaPersona => Boolean(x))
  .sort(porApellido);
const deHoyCon = (estados: string[]) =>
  deHoy
    .filter((r) => estados.includes(r.estado))
    .map((r) => ({ persona: personaPorId.get(r.personalId), hora: r.horaEntrada }))
    .filter((x): x is { persona: FilaPersona; hora: string | null } => Boolean(x.persona))
    .sort((a, b) => (a.hora ?? "").localeCompare(b.hora ?? ""));
const gruposHoy = [
  { titulo: "Aún sin marcar", filas: sinMarcarHoy.map((persona) => ({ persona, hora: null })) },
  { titulo: "Llegaron tarde", filas: deHoyCon(["tarde"]) },
  { titulo: "Llegaron a tiempo", filas: deHoyCon(["presente"]) },
  { titulo: "Con permiso", filas: deHoyCon(["permiso"]) },
  { titulo: "Faltaron", filas: deHoyCon(["falta"]) },
].filter((g) => g.filas.length);

const fraseHoy = feriadoHoy
  ? `Hoy es feriado`
  : !mostrarHoy || laborablesHoy === 0
    ? "Hoy no hay jornada"
    : `${numero(llegaronHoy)} de ${numero(laborablesHoy)} ya llegaron`;
const detalleHoy = feriadoHoy
  ? feriadoHoy.descripcion
  : laborablesHoy === 0
    ? undefined
    : pendientesHoy
      ? `${plural(pendientesHoy, "persona aún sin marcar", "personas aún sin marcar")}${hoyConteo.tarde ? ` · ${numero(hoyConteo.tarde)} tarde` : ""}`
      : "Todos marcaron";

const difMes =
  hayDatos && resumenAnt?.conteo.total ? resumen.asistencia - resumenAnt.asistencia : null;
const comparacionMes =
  difMes === null
    ? undefined
    : Math.abs(difMes) < 1
      ? "Igual que el período anterior"
      : difMes > 0
        ? "Mejor que el período anterior"
        : "Más baja que el período anterior";

const difPunt =
  hayDatos && resumenAnt?.conteo.total ? resumen.puntualidad - resumenAnt.puntualidad : null;
const frasePunt = !hayDatos
  ? "Sin registros todavía"
  : difPunt === null
    ? plural(resumen.conteo.tarde, "llegada tarde", "llegadas tarde")
    : Math.abs(difPunt) < 1
      ? "Las tardanzas se mantienen"
      : difPunt > 0
        ? "Las tardanzas bajaron"
        : "Las tardanzas subieron";
const maxLlegada = Math.max(1, ...llegadas.map((l) => l.valor));
const TONO_TRAMO: Record<string, string> = {
  antes: "puntual",
  "0-5": "puntual",
  "6-15": "tolerancia",
  "16-30": "tarde",
  "31-60": "muy-tarde",
  "60+": "muy-tarde",
};
const hayJornadaHoy = mostrarHoy && laborablesHoy > 0 && !feriadoHoy;

const catsOrden = [...cats].sort((a, b) => a.asistencia - b.asistencia);
const peorCat = catsOrden[0];
const fraseCat = !peorCat
  ? "Sin registros todavía"
  : cats.length > 1
    ? `Más baja: ${peorCat.cat?.nombre ?? "—"}`
    : `${peorCat.cat?.nombre ?? "—"}: ${porcentaje(peorCat.asistencia)}`;

const totalAus = totalAusentes ?? ausentes.length;
const iniciales = (n: string) =>
  n
    .split(" ")
    .slice(0, 2)
    .map((x) => x[0] ?? "")
    .join("");

// Enlaces de la segunda capa (filtros que conservan la ventana abierta)
const enlace = (cambios: Record<string, string | null>) => {
  const u = new URL(Astro.url);
  u.searchParams.delete("vista");
  for (const [k, v] of Object.entries(cambios)) {
    if (v === null) u.searchParams.delete(k);
    else u.searchParams.set(k, v);
  }
  return u.pathname + u.search;
};
const filtrado = periodo !== "mes" || categoriaId;

// Vista Acción rápida
const opcionesBuscador = JSON.stringify(
  [...personas]
    .sort(porApellido)
    .map((x) => ({ v: x.id, t: `${x.apellido}, ${x.nombre}`, c: x.cedula })),
);
const estadoHoy = [
  { texto: `${numero(llegaronHoy)} llegaron`, href: "/asistencia/registro?ver=llegaron" },
  { texto: `${numero(hoyConteo.tarde)} tarde`, href: "/asistencia/registro?ver=llegaron" },
  { texto: `${numero(pendientesHoy)} por llegar`, href: "/asistencia/registro?ver=pendientes" },
  { texto: `${numero(hoyConteo.permiso)} de permiso`, href: "/asistencia/registro?ver=permisos" },
];
---

<PanelLayout titulo="Panel" subtitulo={fechaLarga(hoy)} amplio>
  <Fragment slot="acciones">
    <nav class="segmentado vistas" aria-label="Vista del panel">
      <a href="/panel?vista=resumen" aria-current={vista === "resumen" ? "page" : undefined}>
        <Icono nombre="panel" tamano={18} />
        Resumen
      </a>
      <a href="/panel?vista=rapida" aria-current={vista === "rapida" ? "page" : undefined}>
        <Icono nombre="reloj" tamano={18} />
        Acción rápida
      </a>
    </nav>
  </Fragment>

  {esDemo && (
    <p class="demo">
      <Icono nombre="info" tamano={16} />
      <span>Datos de demostración: no corresponden a marcaciones reales.</span>
      {perfil.rol === "directiva" && <a href="/configuracion#demo">Eliminar</a>}
    </p>
  )}

  {vista === "resumen" ? (
    <>
      {filtrado && (
        <p class="filtro-activo">
          Viendo: <strong>{NOMBRE_PERIODO[periodo]}</strong>
          {categoriaId && (
            <>
              {" · "}
              <strong>{catPorId.get(categoriaId)?.nombre}</strong>
            </>
          )}
          <a href="/panel">Quitar filtro</a>
        </p>
      )}
      <div class:list={["modulos", p.get("abrir") && "quieto"]}>
        <Modulo
          titulo="Hoy"
          icono="reloj"
          frase={fraseHoy}
          detalle={detalleHoy}
          capa="capa-hoy"
          tono="azul"
          orden={0}
        >
          {hayJornadaHoy && (
            <Fragment slot="frase">
              <Contador valor={llegaronHoy} /> de {numero(laborablesHoy)} ya llegaron
            </Fragment>
          )}
          {hayJornadaHoy && <Anillo valor={(llegaronHoy / laborablesHoy) * 100} texto="llegaron" />}
        </Modulo>

        <Modulo
          titulo="Pendientes"
          icono="campana"
          frase={
            totalTareas
              ? plural(totalTareas, "cosa por resolver", "cosas por resolver")
              : "Todo al día"
          }
          detalle={totalTareas ? undefined : "No hay nada pendiente."}
          lectura={totalTareas ? "atencion" : "bien"}
          href="/panel?vista=rapida"
          tono="ambar"
          orden={1}
        >
          {totalTareas > 0 && (
            <Fragment slot="frase">
              <Contador valor={totalTareas} />{" "}
              {totalTareas === 1 ? "cosa por resolver" : "cosas por resolver"}
            </Fragment>
          )}
          {tareas.length > 0 && (
            <span class="mini-tareas">
              {tareas.slice(0, 3).map((t, i) => (
                <span style={`--i: ${i}`}>
                  <Icono nombre={t.icono} tamano={16} />
                  {t.texto}
                </span>
              ))}
            </span>
          )}
        </Modulo>

        <Modulo
          titulo={NOMBRE_PERIODO[periodo]}
          icono="tendencia"
          frase={
            hayDatos ? `${porcentaje(resumen.asistencia)} de asistencia` : "Sin registros todavía"
          }
          detalle={comparacionMes}
          lectura={hayDatos ? lecturaPorcentaje(resumen.asistencia) : undefined}
          capa="capa-mes"
          tono="verde"
          orden={2}
        >
          {hayDatos && (
            <Fragment slot="frase">
              <Contador valor={resumen.asistencia} sufijo=" %" /> de asistencia
            </Fragment>
          )}
          <MiniLinea
            valores={serieTendencia.map((s) => s.valor)}
            final={hayDatos ? porcentaje(serieTendencia.at(-1)?.valor ?? 0) : undefined}
          />
        </Modulo>

        <Modulo
          titulo="Puntualidad"
          icono="reloj"
          frase={frasePunt}
          detalle={hayDatos ? `${porcentaje(resumen.puntualidad)} llegó a tiempo` : undefined}
          lectura={hayDatos ? lecturaPorcentaje(resumen.puntualidad) : undefined}
          capa="capa-puntualidad"
          tono="violeta"
          orden={3}
        >
          {hayDatos && (
            <span class="mini-barras">
              {llegadas.map((l, i) => (
                <span
                  class={TONO_TRAMO[l.clave] ?? "puntual"}
                  style={`height: ${Math.max(4, (l.valor / maxLlegada) * 100)}%; --i: ${i}`}
                />
              ))}
            </span>
          )}
        </Modulo>

        <Modulo
          titulo="Ausentes esta semana"
          icono="permiso"
          frase={
            totalAus
              ? plural(totalAus, "persona con permiso", "personas con permiso")
              : "Nadie tiene permiso"
          }
          detalle={
            proximoFeriado
              ? `Próximo feriado: ${diaTexto(proximoFeriado.fecha)}`
              : "Hoy y los próximos 7 días"
          }
          capa="capa-ausentes"
          tono="rosa"
          orden={4}
        >
          {totalAus > 0 && (
            <Fragment slot="frase">
              <Contador valor={totalAus} />{" "}
              {totalAus === 1 ? "persona con permiso" : "personas con permiso"}
            </Fragment>
          )}
          {ausentes.length > 0 && (
            <span class="caras">
              {ausentes.slice(0, 6).map((a, i) => (
                <span style={`--c: ${a.color}; --i: ${i}`}>{iniciales(a.nombre)}</span>
              ))}
              {totalAus > 6 && (
                <span class="mas" style={`--i: ${Math.min(6, ausentes.length)}`}>
                  +{totalAus - 6}
                </span>
              )}
            </span>
          )}
        </Modulo>

        <Modulo
          titulo="Por categoría"
          icono="usuarios"
          frase={fraseCat}
          detalle={
            peorCat && cats.length > 1
              ? `${peorCat.cat?.nombre}: ${porcentaje(peorCat.asistencia)} de asistencia`
              : undefined
          }
          lectura={peorCat ? lecturaPorcentaje(peorCat.asistencia) : undefined}
          capa="capa-categorias"
          tono="cian"
          orden={5}
        >
          {cats.length > 0 && (
            <span class="mini-cats">
              {catsOrden.slice(0, 4).map((c, i) => (
                <span class="fila-cat" style={`--i: ${i}`}>
                  <span class="nombre-cat">
                    <span class="punto-cat" style={`background: ${c.cat?.color ?? "#64748b"}`} />
                    {c.cat?.nombre ?? "—"}
                  </span>
                  <span class="barra-cat">
                    <span
                      class={lecturaPorcentaje(c.asistencia)}
                      style={`width: ${Math.max(4, c.asistencia)}%`}
                    />
                  </span>
                  <span class="pct-cat">{porcentaje(c.asistencia)}</span>
                </span>
              ))}
            </span>
          )}
        </Modulo>
      </div>
      <p class="pie-panel">
        Toque un módulo para ver el detalle. El análisis completo y las descargas están en{" "}
        <a href="/reportes">Reportes</a>.
      </p>
    </>
  ) : (
    <div class="rapida">
      <div
        class="v-campo v-buscador buscar"
        data-buscador
        data-abrir-persona
        data-opciones={opcionesBuscador}
      >
        <label for="panel-buscar">Buscar a una persona</label>
        <input
          id="panel-buscar"
          type="search"
          placeholder="Nombre o cédula"
          autocomplete="off"
          role="combobox"
          aria-expanded="false"
          aria-controls="panel-buscar-lista"
          aria-autocomplete="list"
        />
        <input type="hidden" />
        <ul id="panel-buscar-lista" role="listbox" hidden></ul>
      </div>

      {mostrarHoy && !feriadoHoy && laborablesHoy > 0 && (
        <nav class="estado-hoy" aria-label="Hoy">
          <span>Hoy:</span>
          {estadoHoy.map((e) => (
            <a href={e.href}>{e.texto}</a>
          ))}
        </nav>
      )}

      <ul class="accesos">
        <li>
          <a href="/asistencia/registro">
            <Icono nombre="reloj" tamano={18} />
            Registro del día
          </a>
        </li>
        <li>
          <button type="button" data-ventana="/ventanas/permiso" data-ventana-modo="centro">
            <Icono nombre="permiso" tamano={18} />
            Permiso
          </button>
        </li>
        <li>
          <a
            href={`/api/reportes/planilla?fecha=${hoy}&tipo=docentes&formato=pdf&ver=1`}
            target="_blank"
            rel="noopener"
            data-astro-reload
          >
            <Icono nombre="descargar" tamano={18} />
            Planilla PDF
          </a>
        </li>
        <li>
          <a href="/api/reportes/resumen?formato=xlsx" download data-astro-reload>
            <Icono nombre="documento" tamano={18} />
            Resumen Excel
          </a>
        </li>
        {esDirectiva && (
          <li>
            <button
              type="button"
              data-ventana="/ventanas/personal-nuevo"
              data-ventana-modo="centro"
            >
              <Icono nombre="mas" tamano={18} />
              Nuevo personal
            </button>
          </li>
        )}
      </ul>

      <section class="tareas" aria-labelledby="titulo-tareas">
        <h2 id="titulo-tareas">
          Pendientes
          {totalTareas > 0 && <span class="contador">{totalTareas}</span>}
        </h2>
        {tareas.length ? (
          <ul>
            {tareas.map((t) => (
              <li>
                <Icono nombre={t.icono} tamano={18} />
                <span class="texto">{t.texto}</span>
                {t.aprobar ? (
                  <form method="post" action="/api/acciones" data-api>
                    <input type="hidden" name="accion" value="disp_aprobar" />
                    <input type="hidden" name="personal_id" value={t.aprobar.personalId} />
                    <input type="hidden" name="dispositivo_id" value={t.aprobar.dispositivoId} />
                    <button
                      type="submit"
                      class="v-boton v-secundario"
                      data-texto-cargando="Aprobando…"
                    >
                      {t.boton}
                    </button>
                  </form>
                ) : t.ventana ? (
                  <button
                    type="button"
                    class="v-boton v-secundario"
                    data-ventana={t.ventana}
                    data-ventana-modo="centro"
                  >
                    {t.boton}
                  </button>
                ) : t.persona ? (
                  <a
                    class="v-boton v-secundario"
                    href={`/personal/${t.persona}`}
                    data-persona={t.persona}
                  >
                    {t.boton}
                  </a>
                ) : (
                  <a class="v-boton v-secundario" href={t.href}>
                    {t.boton}
                  </a>
                )}
              </li>
            ))}
          </ul>
        ) : (
          <p class="al-dia">
            <Icono nombre="exito" tamano={18} />
            Todo al día.
          </p>
        )}
        {masTareas > 0 && (
          <p class="nota">
            Y {plural(masTareas, "pendiente más", "pendientes más")} de la última semana en el{" "}
            <a href="/asistencia/registro">Registro del día</a>.
          </p>
        )}
      </section>
    </div>
  )}

  <!-- Segunda capa: se abre en el panel lateral sin pedir nada al servidor -->
  {vista === "resumen" && (
    <>
      <template id="capa-hoy">
        <header class="v-cabecera" tabindex="-1">
          <div>
            <h2 class="v-titulo" id="capa-hoy-titulo" data-ventana-titulo>
              Hoy
            </h2>
            <p class="v-sub">{fraseHoy}</p>
          </div>
          <button type="button" class="v-cerrar" aria-label="Cerrar" data-cerrar-ventana>
            <Icono nombre="error" tamano={22} />
          </button>
        </header>
        <div class="v-contenido capa">
          {mostrarHoy && !feriadoHoy && laborablesHoy > 0 && (
            <BarraApilada segmentos={hoySegmentos} soloConValor />
          )}
          {gruposHoy.length > 0 && (
            <>
              <div class="v-campo">
                <label for="filtro-hoy">Buscar en la lista</label>
                <input
                  id="filtro-hoy"
                  type="search"
                  data-filtrar="hoy"
                  placeholder="Nombre o categoría"
                  autocomplete="off"
                />
              </div>
              <div data-filtrable="hoy">
                {gruposHoy.map((g) => (
                  <section class="grupo">
                    <h3>
                      {g.titulo} <span class="contador">{g.filas.length}</span>
                    </h3>
                    <ul class="lista-capa">
                      {g.filas.map(({ persona, hora }) => (
                        <li>
                          <a href={`/personal/${persona.id}`} data-persona={persona.id}>
                            {persona.apellido}, {persona.nombre}
                          </a>
                          <span class="suave">{catPorId.get(persona.categoria_id)?.nombre}</span>
                          <span class="hora">{hora ?? ""}</span>
                        </li>
                      ))}
                    </ul>
                  </section>
                ))}
              </div>
            </>
          )}
          {!feriadoHoy && progresoHoy.length > 0 && (
            <section class="grupo">
              <h3>Llegadas por categoría</h3>
              <HoyPorCategoria filas={progresoHoy} />
            </section>
          )}
        </div>
        <footer class="v-pie">
          <a href="/asistencia/registro" class="v-boton v-secundario v-bloque-ancho">
            Abrir el Registro del día
          </a>
        </footer>
      </template>

      <template id="capa-mes">
        <header class="v-cabecera" tabindex="-1">
          <div>
            <h2 class="v-titulo" id="capa-mes-titulo" data-ventana-titulo>
              Asistencia · {NOMBRE_PERIODO[periodo]}
            </h2>
            <p class="v-sub">
              {fechaCorta(rango.desde)} – {fechaCorta(rango.hasta)}
            </p>
          </div>
          <button type="button" class="v-cerrar" aria-label="Cerrar" data-cerrar-ventana>
            <Icono nombre="error" tamano={22} />
          </button>
        </header>
        <div class="v-contenido capa">
          <nav class="segmentado" aria-label="Período">
            {(["mes", "30d", "anterior"] as Periodo[]).map((v) => (
              <a
                href={enlace({ periodo: v, abrir: "mes" })}
                aria-current={periodo === v ? "true" : undefined}
              >
                {NOMBRE_PERIODO[v]}
              </a>
            ))}
          </nav>
          <form method="get" action="/panel" class="filtro-cat" data-autoenviar>
            <input type="hidden" name="periodo" value={periodo} />
            <input type="hidden" name="abrir" value="mes" />
            <label for="capa-cat">Categoría</label>
            <select id="capa-cat" name="categoria">
              <option value="">Todas las categorías</option>
              {categorias.map((c) => (
                <option value={c.id} selected={c.id === categoriaId}>
                  {c.nombre}
                </option>
              ))}
            </select>
            <noscript>
              <button type="submit">Aplicar</button>
            </noscript>
          </form>
          <dl class="cifras-capa">
            <div>
              <dt>Asistencia</dt>
              <dd>{hayDatos ? porcentaje(resumen.asistencia) : "—"}</dd>
            </div>
            <div>
              <dt>Faltas</dt>
              <dd>{numero(resumen.conteo.falta)}</dd>
            </div>
            <div>
              <dt>Permisos</dt>
              <dd>{numero(resumen.conteo.permiso)}</dd>
            </div>
            <div>
              <dt>Horas</dt>
              <dd>{numero(Math.round(resumen.horasTotales))}</dd>
            </div>
          </dl>
          {concl.tendencia && <p class="conclusion">{concl.tendencia}</p>}
          {hayDatos && (
            <>
              <h3 class="titulo-grafica">Tendencia de asistencia</h3>
              <Figura
                plana
                titulo="Tendencia de asistencia"
                descripcion={`Porcentaje diario de jornadas cumplidas${omitidosTendencia ? ` · ${plural(omitidosTendencia, "día", "días")} con poco personal no se grafica${omitidosTendencia === 1 ? "" : "n"}` : ""}`}
                columnas={["Fecha", "Asistencia", "Presentes", "Tarde", "Faltas", "Permisos"]}
                filas={serie.map((s) => [
                  fechaCorta(s.clave),
                  porcentaje(s.valor, 2),
                  s.conteo.presente,
                  s.conteo.tarde,
                  s.conteo.falta,
                  s.conteo.permiso,
                ])}
              >
                <GraficaLinea
                  puntos={serieTendencia.map((s) => ({
                    etiqueta: dd(s.clave),
                    fecha: s.clave,
                    valor: s.valor,
                    detalle: `${diaTexto(s.clave)} · ${plural(s.conteo.falta, "falta", "faltas")}, ${s.conteo.tarde} tarde`,
                  }))}
                  referencia={{
                    valor: resumen.asistencia,
                    etiqueta: `Prom. ${porcentaje(resumen.asistencia)}`,
                  }}
                />
              </Figura>
            </>
          )}
          <section class="grupo">
            <h3>Día por día</h3>
            <CalendarioPeriodo semanas={semanas} />
          </section>
        </div>
        <footer class="v-pie">
          <a href="/reportes/resumen" class="v-boton v-secundario v-bloque-ancho">
            Ver el resumen por persona
          </a>
        </footer>
      </template>

      <template id="capa-puntualidad">
        <header class="v-cabecera" tabindex="-1">
          <div>
            <h2 class="v-titulo" id="capa-punt-titulo" data-ventana-titulo>
              Puntualidad
            </h2>
            <p class="v-sub">{frasePunt}</p>
          </div>
          <button type="button" class="v-cerrar" aria-label="Cerrar" data-cerrar-ventana>
            <Icono nombre="error" tamano={22} />
          </button>
        </header>
        <div class="v-contenido capa">
          {concl.llegadas && <p class="conclusion">{concl.llegadas}</p>}
          {hayDatos ? (
            <>
              <h3 class="titulo-grafica">Hora de llegada</h3>
              <Figura
                plana
                titulo="Hora de llegada"
                descripcion={`Minutos después de la hora de entrada. Quien llega tarde, llega en promedio ${resumen.retrasoPromedioMin} min después.`}
                columnas={["Tramo", "Llegadas", "Porcentaje"]}
                filas={llegadas.map((l) => [
                  l.etiqueta,
                  l.valor,
                  porcentaje(totalLlegadas ? (l.valor / totalLlegadas) * 100 : 0),
                ])}
              >
                <DistribucionLlegadas tramos={llegadas} />
              </Figura>
              <h3 class="titulo-grafica">Por día de la semana</h3>
              <Figura
                plana
                titulo="Por día de la semana"
                descripcion="Rayado: el día con la asistencia más baja."
                columnas={["Día", "Asistencia", "Tardanza", "Faltas"]}
                filas={dias.map((d) => [
                  NOMBRE_DIA[d.dia as DiaSemana],
                  porcentaje(d.asistencia, 2),
                  porcentaje(d.tardanza, 2),
                  d.faltas,
                ])}
              >
                <BarrasHorizontales
                  maximo={100}
                  lectura
                  items={dias.map((d) => ({
                    etiqueta: NOMBRE_DIA[d.dia as DiaSemana],
                    valor: d.asistencia,
                    texto: porcentaje(d.asistencia),
                    detalle: `${plural(d.faltas, "falta", "faltas")} · ${porcentaje(d.tardanza)} tarde`,
                    resaltar: d.asistencia === peorDia && dias.length > 1,
                  }))}
                />
              </Figura>
            </>
          ) : (
            <p class="nota">Aún no hay llegadas registradas en este período.</p>
          )}
          {masTarde.length > 0 && (
            <section class="grupo">
              <h3>Quiénes llegan tarde más seguido</h3>
              <ol class="criticas">
                {masTarde.map((c) => {
                  const x = personaPorId.get(c.personalId);
                  const cat = x ? catPorId.get(x.categoria_id) : undefined;
                  return (
                    <li>
                      <span
                        class="ini"
                        style={`--c: ${cat?.color ?? "#64748b"}`}
                        aria-hidden="true"
                      >
                        {(x?.nombre[0] ?? "") + (x?.apellido[0] ?? "")}
                      </span>
                      <span class="quien">
                        {x ? (
                          <a href={`/personal/${x.id}`} data-persona={x.id}>
                            {x.nombre} {x.apellido}
                          </a>
                        ) : (
                          "—"
                        )}
                        <small>{cat?.nombre}</small>
                      </span>
                      <span class="cifras">
                        <strong>{c.tardanzas}</strong>{" "}
                        {c.tardanzas === 1 ? "vez tarde" : "veces tarde"}
                      </span>
                    </li>
                  );
                })}
              </ol>
            </section>
          )}
        </div>
      </template>

      <template id="capa-ausentes">
        <header class="v-cabecera" tabindex="-1">
          <div>
            <h2 class="v-titulo" id="capa-aus-titulo" data-ventana-titulo>
              Ausentes esta semana
            </h2>
            <p class="v-sub">Permisos de hoy y de los próximos 7 días</p>
          </div>
          <button type="button" class="v-cerrar" aria-label="Cerrar" data-cerrar-ventana>
            <Icono nombre="error" tamano={22} />
          </button>
        </header>
        <div class="v-contenido capa">
          {ausentes.length > 5 && (
            <div class="v-campo">
              <label for="filtro-aus">Buscar en la lista</label>
              <input
                id="filtro-aus"
                type="search"
                data-filtrar="aus"
                placeholder="Nombre o motivo"
                autocomplete="off"
              />
            </div>
          )}
          <div data-filtrable="aus">
            <ListaAusentes
              ausentes={ausentes}
              total={totalAus}
              hoy={hoy}
              feriado={proximoFeriado}
            />
          </div>
        </div>
        <footer class="v-pie">
          <button
            type="button"
            class="v-boton v-primario v-bloque-ancho"
            data-ventana="/ventanas/permiso"
            data-ventana-modo="centro"
          >
            Cargar un permiso
          </button>
        </footer>
      </template>

      <template id="capa-categorias">
        <header class="v-cabecera" tabindex="-1">
          <div>
            <h2 class="v-titulo" id="capa-cat-titulo" data-ventana-titulo>
              Por categoría
            </h2>
            <p class="v-sub">{NOMBRE_PERIODO[periodo]}</p>
          </div>
          <button type="button" class="v-cerrar" aria-label="Cerrar" data-cerrar-ventana>
            <Icono nombre="error" tamano={22} />
          </button>
        </header>
        <div class="v-contenido capa">
          {concl.categorias && <p class="conclusion">{concl.categorias}</p>}
          {cats.length > 0 && (
            <>
              <h3 class="titulo-grafica">Asistencia por categoría</h3>
              <Figura
                plana
                titulo="Asistencia por categoría"
                descripcion="Asistencia y puntualidad de cada grupo del personal."
                columnas={["Categoría", "Personas", "Asistencia", "Puntualidad", "Faltas"]}
                filas={cats.map((c) => [
                  c.cat?.nombre ?? "—",
                  c.personas,
                  porcentaje(c.asistencia, 2),
                  porcentaje(c.puntualidad, 2),
                  c.conteo.falta,
                ])}
              >
                <BarrasHorizontales
                  maximo={100}
                  lectura
                  items={cats.map((c) => ({
                    etiqueta: c.cat?.nombre ?? "—",
                    valor: c.asistencia,
                    texto: porcentaje(c.asistencia),
                    color: c.cat?.color,
                    detalle: `${c.personas} pers. · puntualidad ${porcentaje(c.puntualidad)}`,
                  }))}
                />
              </Figura>
            </>
          )}
          <section class="grupo">
            <h3>Quiénes faltan o llegan tarde más seguido</h3>
            {criticas.length ? (
              <ol class="criticas">
                {criticas.map((c) => {
                  const x = personaPorId.get(c.personalId);
                  const cat = x ? catPorId.get(x.categoria_id) : undefined;
                  return (
                    <li>
                      <span
                        class="ini"
                        style={`--c: ${cat?.color ?? "#64748b"}`}
                        aria-hidden="true"
                      >
                        {(x?.nombre[0] ?? "") + (x?.apellido[0] ?? "")}
                      </span>
                      <span class="quien">
                        {x ? (
                          <a href={`/personal/${x.id}`} data-persona={x.id}>
                            {x.nombre} {x.apellido}
                          </a>
                        ) : (
                          "—"
                        )}
                        <small>{cat?.nombre}</small>
                      </span>
                      <span class="cifras">
                        <strong>{c.faltas}</strong> {c.faltas === 1 ? "falta" : "faltas"} ·{" "}
                        <strong>{c.tardanzas}</strong> tarde
                      </span>
                    </li>
                  );
                })}
              </ol>
            ) : (
              <p class="nota">Nadie acumula faltas ni tardanzas en el período.</p>
            )}
          </section>
        </div>
      </template>
    </>
  )}
</PanelLayout>

<script>
  import { enCadaPantalla } from "@/scripts/pantalla";
  import { abrirVentanaLocal } from "@/scripts/ventanas";
  // La vista elegida se recuerda en este equipo (también si la página vino precargada)
  document.addEventListener("click", (ev) => {
    const a = (ev.target as HTMLElement).closest<HTMLAnchorElement>(".vistas a");
    const vista = a && new URL(a.href).searchParams.get("vista");
    if (vista) document.cookie = `panel_vista=${vista}; path=/; max-age=31536000; samesite=lax`;
  });
  // Tras cambiar el período o la categoría en la segunda capa, se vuelve a abrir
  enCadaPantalla(() => {
    const abrir = new URL(location.href).searchParams.get("abrir");
    if (abrir && document.getElementById(`capa-${abrir}`)) abrirVentanaLocal(`capa-${abrir}`);
  });
