---
/**
 * Panel de control › Por categoría (D-55, D-56). Sin categoría: comparación entre
 * grupos (cada barra y cada fila llevan a su categoría). Con una categoría: su
 * vista, comparada con el colegio, con su gente.
 */
import PanelSeccionLayout from "@/layouts/PanelSeccionLayout.astro";
import Tarjeta from "@/components/ui/Tarjeta.astro";
import Tabla from "@/components/ui/Tabla.astro";
import Icono from "@/components/ui/Icono.astro";
import Figura from "@/components/graficas/Figura.astro";
import BarrasHorizontales from "@/components/graficas/BarrasHorizontales.astro";
import GraficaLinea from "@/components/graficas/GraficaLinea.astro";
import Contador from "@/components/panel/Contador.astro";
import { fechaCorta, hoyEnZona } from "@/lib/fecha";
import { listarCategorias } from "@/lib/datos/categorias";
import {
  cargarPanel,
  consultaExportar,
  dd,
  diaTexto,
  enlacePanel,
  iniciales,
  leerFiltros,
} from "@/lib/datos/panel";
import { lecturaPorcentaje, NOMBRE_LECTURA } from "@/lib/reglas/estadisticas";
import { numero, plural, porcentaje } from "@/lib/formato";

const sb = Astro.locals.supabase;
const hoy = hoyEnZona();
const categorias = await listarCategorias(sb);
const filtros = leerFiltros(Astro.url, categorias);
const d = await cargarPanel(sb, {
  hoy,
  filtros,
  categorias,
  esDirectiva: Astro.locals.perfil!.rol === "directiva",
});
const exportar = consultaExportar(d.rango, filtros);
const cat = categorias.find((c) => c.id === filtros.categoriaId);
const { resumen, colegio, hayDatos } = d;
const aCategoria = (id: string) =>
  enlacePanel("/panel/categorias", { ...filtros, categoriaId: id });
const enAtencion = d.cats.filter((c) => lecturaPorcentaje(c.asistencia) !== "bien").length;
// Diferencia con el colegio, en palabras
const frente = (propio: number, delColegio: number | undefined) => {
  if (delColegio === undefined) return undefined;
  const dif = propio - delColegio;
  return Math.abs(dif) < 1
    ? "igual que el colegio"
    : `${plural(Math.abs(Math.round(dif)), "punto", "puntos")} ${dif > 0 ? "por encima" : "por debajo"} del colegio`;
};
const lectura = cat
  ? hayDatos
    ? lecturaPorcentaje(resumen.asistencia)
    : undefined
  : d.peorCat
    ? lecturaPorcentaje(d.peorCat.asistencia)
    : undefined;
const frase = cat
  ? hayDatos
    ? `${cat.nombre}: ${porcentaje(resumen.asistencia)} de asistencia${colegio?.conteo.total ? ` · el colegio está en ${porcentaje(colegio.asistencia)}` : ""}`
    : `${cat.nombre}: sin registros`
  : d.peorCat && d.cats.length > 1
    ? `${d.fraseCategoria} (${porcentaje(d.peorCat.asistencia)})`
    : d.fraseCategoria;
---

<PanelSeccionLayout
  titulo={cat ? cat.nombre : "Por categoría"}
  frase={frase}
  lectura={lectura}
  filtros={filtros}
  categorias={categorias}
  rango={`${fechaCorta(d.rango.desde)} – ${fechaCorta(d.rango.hasta)}`}
  esDemo={d.esDemo}
  sinDatos={!hayDatos}
>
  {cat ? (
    <>
      <Tarjeta datos>
        <dl class="cifras-seccion">
          <div class={hayDatos ? lecturaPorcentaje(resumen.asistencia) : undefined} style="--i: 0">
            <dt>Asistencia</dt>
            <dd class="valor">
              <Contador valor={resumen.asistencia} sufijo=" %" />
            </dd>
            <dd class="nota-cifra">
              {frente(resumen.asistencia, colegio?.conteo.total ? colegio.asistencia : undefined)}
            </dd>
          </div>
          <div class={hayDatos ? lecturaPorcentaje(resumen.puntualidad) : undefined} style="--i: 1">
            <dt>Puntualidad</dt>
            <dd class="valor">
              <Contador valor={resumen.puntualidad} sufijo=" %" />
            </dd>
            <dd class="nota-cifra">
              {frente(resumen.puntualidad, colegio?.conteo.total ? colegio.puntualidad : undefined)}
            </dd>
          </div>
          <div class:list={[resumen.conteo.falta && "atencion"]} style="--i: 2">
            <dt>Faltas</dt>
            <dd>
              <a class="valor" href={enlacePanel("/panel/ausencias", filtros)}>
                <Contador valor={resumen.conteo.falta} />
              </a>
            </dd>
            <dd class="nota-cifra">
              {colegio?.conteo.total ? `Colegio: ${numero(colegio.conteo.falta)}` : undefined}
            </dd>
          </div>
          <div style="--i: 3">
            <dt>Personas</dt>
            <dd class="valor">
              <Contador valor={d.personas.length} />
            </dd>
            <dd class="nota-cifra">activas en la categoría</dd>
          </div>
        </dl>
      </Tarjeta>

      {d.serieTendencia.length > 1 && (
        <Figura
          titulo={`Tendencia de ${cat.nombre}`}
          descripcion="La línea punteada es la asistencia del colegio en el mismo período. Toque un día para ver quién vino."
          columnas={["Fecha", "Asistencia"]}
          filas={d.serieTendencia.map((s) => [fechaCorta(s.clave), porcentaje(s.valor, 2)])}
        >
          <GraficaLinea
            puntos={d.serieTendencia.map((s) => ({
              etiqueta: dd(s.clave),
              fecha: s.clave,
              valor: s.valor,
              detalle: `${diaTexto(s.clave)} · ${plural(s.conteo.falta, "falta", "faltas")}`,
              href: `/panel/hoy?fecha=${s.clave}&categoria=${cat.id}`,
            }))}
            referencia={
              colegio?.conteo.total
                ? {
                    valor: colegio.asistencia,
                    etiqueta: `Colegio ${porcentaje(colegio.asistencia)}`,
                  }
                : undefined
            }
          />
        </Figura>
      )}

      <Tarjeta
        titulo={`Personas de ${cat.nombre}`}
        descripcion="De la asistencia más baja a la más alta. Toque un nombre para ver a la persona."
      >
        <label class="buscar-en">
          Buscar una persona
          <input type="search" data-filtrar="gente" placeholder="Nombre" autocomplete="off" />
        </label>
        <div data-filtrable="gente" data-limitada>
          <Tabla
            titulo={`Personas de ${cat.nombre}`}
            hayFilas={d.personasPeriodo.length > 0}
            vacio="Nadie tiene registros en este período."
            tarjetas
          >
            <thead>
              <tr>
                <th scope="col">
                  <button type="button" class="ordenar">
                    Persona
                  </button>
                </th>
                <th scope="col" class="num" aria-sort="ascending">
                  <button type="button" class="ordenar">
                    Asistencia
                  </button>
                </th>
                <th scope="col" class="num">
                  <button type="button" class="ordenar">
                    Faltas
                  </button>
                </th>
                <th scope="col" class="num">
                  <button type="button" class="ordenar">
                    Tarde
                  </button>
                </th>
                <th scope="col" class="num">
                  <button type="button" class="ordenar">
                    Permisos
                  </button>
                </th>
              </tr>
            </thead>
            <tbody>
              {d.personasPeriodo.map((x, n) => {
                const l = lecturaPorcentaje(x.asistencia);
                return (
                  <tr class:list={[n >= 15 && "extra"]}>
                    <td
                      data-etiqueta="Persona"
                      data-valor={`${x.persona.apellido} ${x.persona.nombre}`}
                    >
                      <span class="persona-celda">
                        <span class="ini" style={`--c: ${cat.color}`} aria-hidden="true">
                          {iniciales(`${x.persona.nombre} ${x.persona.apellido}`)}
                        </span>
                        <a href={`/personal/${x.persona.id}`} data-persona={x.persona.id}>
                          {x.persona.apellido}, {x.persona.nombre}
                        </a>
                      </span>
                    </td>
                    <td data-etiqueta="Asistencia" class="num" data-valor={x.asistencia}>
                      <span class:list={["pct", l]}>{porcentaje(x.asistencia)}</span>
                    </td>
                    <td data-etiqueta="Faltas" class="num">
                      {x.faltas}
                    </td>
                    <td data-etiqueta="Tarde" class="num">
                      {x.tardanzas}
                    </td>
                    <td data-etiqueta="Permisos" class="num">
                      {x.permisos}
                    </td>
                  </tr>
                );
              })}
            </tbody>
          </Tabla>
        </div>
        {d.personasPeriodo.length > 15 && (
          <button type="button" class="ver-todos">
            Ver todas ({d.personasPeriodo.length} personas)
          </button>
        )}
      </Tarjeta>
    </>
  ) : (
    <>
      {d.mejorCat && d.peorCat && (
        <Tarjeta datos>
          <dl class="cifras-seccion">
            <div class={lecturaPorcentaje(d.mejorCat.asistencia)} style="--i: 0">
              <dt>La mejor: {d.mejorCat.cat?.nombre}</dt>
              <dd>
                <a class="valor" href={aCategoria(d.mejorCat.categoriaId)}>
                  <Contador valor={d.mejorCat.asistencia} sufijo=" %" />
                </a>
              </dd>
            </div>
            <div class={lecturaPorcentaje(d.peorCat.asistencia)} style="--i: 1">
              <dt>La más baja: {d.peorCat.cat?.nombre}</dt>
              <dd>
                <a class="valor" href={aCategoria(d.peorCat.categoriaId)}>
                  <Contador valor={d.peorCat.asistencia} sufijo=" %" />
                </a>
              </dd>
            </div>
            <div class:list={[enAtencion && "atencion"]} style="--i: 2">
              <dt>Por debajo de 90 %</dt>
              <dd class="valor">
                <Contador valor={enAtencion} />
              </dd>
              <dd class="nota-cifra">
                {plural(d.cats.length, "categoría", "categorías")} en total
              </dd>
            </div>
          </dl>
        </Tarjeta>
      )}

      {d.cats.length > 0 && (
        <Figura
          titulo="Asistencia por categoría"
          descripcion={`${d.concl.categorias ?? "Asistencia de cada grupo del personal."} Toque una barra para ver esa categoría.`}
          columnas={["Categoría", "Asistencia"]}
          filas={d.cats.map((c) => [c.cat?.nombre ?? "—", porcentaje(c.asistencia, 2)])}
        >
          <BarrasHorizontales
            maximo={100}
            lectura
            items={d.cats.map((c) => ({
              etiqueta: c.cat?.nombre ?? "—",
              valor: c.asistencia,
              texto: porcentaje(c.asistencia),
              color: c.cat?.color,
              detalle: `${c.personas} pers. · puntualidad ${porcentaje(c.puntualidad)}`,
              href: aCategoria(c.categoriaId),
            }))}
          />
        </Figura>
      )}

      <Tarjeta titulo="Comparación" descripcion="Toque una categoría para ver su detalle.">
        <Tabla
          titulo="Comparación por categoría"
          hayFilas={d.cats.length > 0}
          vacio="No hay registros en este período."
          tarjetas
        >
          <thead>
            <tr>
              <th scope="col">
                <button type="button" class="ordenar">
                  Categoría
                </button>
              </th>
              <th scope="col" class="num">
                <button type="button" class="ordenar">
                  Personas
                </button>
              </th>
              <th scope="col" class="num">
                <button type="button" class="ordenar">
                  Asistencia
                </button>
              </th>
              <th scope="col" class="num">
                <button type="button" class="ordenar">
                  Puntualidad
                </button>
              </th>
              <th scope="col" class="num">
                <button type="button" class="ordenar">
                  Faltas
                </button>
              </th>
              <th scope="col">
                <button type="button" class="ordenar">
                  Lectura
                </button>
              </th>
            </tr>
          </thead>
          <tbody>
            {d.cats.map((c) => {
              const l = lecturaPorcentaje(c.asistencia);
              return (
                <tr class="fila-enlace">
                  <td data-etiqueta="Categoría" data-valor={c.cat?.nombre ?? ""}>
                    <a class="cat" href={aCategoria(c.categoriaId)}>
                      <span class="punto" style={`background: ${c.cat?.color ?? "#64748b"}`} />
                      {c.cat?.nombre ?? "—"}
                    </a>
                  </td>
                  <td data-etiqueta="Personas" class="num">
                    {c.personas}
                  </td>
                  <td data-etiqueta="Asistencia" class="num" data-valor={c.asistencia}>
                    {porcentaje(c.asistencia)}
                  </td>
                  <td data-etiqueta="Puntualidad" class="num" data-valor={c.puntualidad}>
                    {porcentaje(c.puntualidad)}
                  </td>
                  <td data-etiqueta="Faltas" class="num">
                    {c.conteo.falta}
                  </td>
                  <td data-etiqueta="Lectura" data-valor={c.asistencia}>
                    <span class:list={["chip", l]}>{NOMBRE_LECTURA[l]}</span>
                  </td>
                </tr>
              );
            })}
          </tbody>
        </Tabla>
      </Tarjeta>
    </>
  )}

  <Fragment slot="lateral">
    {cat ? (
      <Tarjeta titulo="Otras categorías" descripcion="Para comparar, toque otra.">
        <ul class="otras">
          {categorias
            .filter((c) => c.activa && c.id !== cat.id)
            .map((c) => (
              <li>
                <a href={aCategoria(c.id)}>
                  <span class="punto" style={`background: ${c.color}`} />
                  {c.nombre}
                  <Icono nombre="siguiente" tamano={16} />
                </a>
              </li>
            ))}
        </ul>
      </Tarjeta>
    ) : (
      <Tarjeta titulo="Quiénes faltan o llegan tarde más seguido">
        {d.criticas.length ? (
          <ol class="ranking">
            {d.criticas.map((c) => {
              const x = d.personaPorId.get(c.personalId);
              const ct = x ? d.catPorId.get(x.categoria_id) : undefined;
              return (
                <li>
                  <span class="persona-celda">
                    <span class="ini" style={`--c: ${ct?.color ?? "#64748b"}`} aria-hidden="true">
                      {x ? iniciales(`${x.nombre} ${x.apellido}`) : ""}
                    </span>
                    {x ? (
                      <a href={`/personal/${x.id}`} data-persona={x.id}>
                        {x.nombre} {x.apellido}
                      </a>
                    ) : (
                      "—"
                    )}
                  </span>
                  <span class="texto-suave">
                    {plural(c.faltas, "falta", "faltas")} · {c.tardanzas} tarde
                  </span>
                </li>
              );
            })}
          </ol>
        ) : (
          <p class="texto-suave">Nadie acumula faltas ni tardanzas.</p>
        )}
      </Tarjeta>
    )}
    <Tarjeta titulo="Acciones">
      <ul class="acciones-seccion">
        <li>
          <a href={`/api/reportes/resumen?formato=xlsx&${exportar}`} download data-astro-reload>
            <Icono nombre="documento" tamano={18} /> Descargar {cat ? cat.nombre : "todo"} en Excel
          </a>
        </li>
        {cat && (
          <li>
            <a href={`/panel/hoy?categoria=${cat.id}`}>
              <Icono nombre="reloj" tamano={18} /> Ver {cat.nombre} hoy
            </a>
          </li>
        )}
        {cat && (
          <li>
            <a href={enlacePanel("/panel/categorias", { ...filtros, categoriaId: null })}>
              <Icono nombre="usuarios" tamano={18} /> Comparar todas las categorías
            </a>
          </li>
        )}
        <li>
          <a href="/jornadas#categorias">
            <Icono nombre="ajustes" tamano={18} /> Administrar categorías
          </a>
        </li>
      </ul>
    </Tarjeta>
  </Fragment>
</PanelSeccionLayout>

<style>
  .cat {
    display: inline-flex;
    align-items: center;
    gap: var(--esp-2);
    color: var(--color-texto);
    font-weight: var(--peso-medio);
  }
  /* Toda la fila de la tabla lleva a la categoría */
  .fila-enlace {
    position: relative;
    cursor: pointer;
  }
  .fila-enlace .cat::after {
    content: "";
    position: absolute;
    inset: 0;
  }
  .fila-enlace:hover {
    background: var(--color-superficie-hover);
  }
  .punto {
    width: 9px;
    height: 9px;
    border-radius: 50%;
  }
  .chip {
    padding: 5px var(--esp-3);
    border-radius: 999px;
    font-size: var(--texto-sm);
    font-weight: var(--peso-fuerte);
  }
  .chip.bien,
  .pct.bien {
    color: var(--color-exito);
  }
  .chip.bien {
    background: var(--color-exito-suave);
  }
  .chip.atencion,
  .pct.atencion {
    color: var(--color-alerta);
  }
  .chip.atencion {
    background: var(--color-alerta-suave);
  }
  .chip.bajo,
  .pct.bajo {
    color: var(--color-error);
  }
  .chip.bajo {
    background: var(--color-error-suave);
  }
  .pct {
    font-weight: var(--peso-fuerte);
  }
  .ranking,
  .otras {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .ranking li {
    display: grid;
    gap: 6px;
    padding: var(--esp-3) 0;
    border-top: 1px solid var(--color-borde);
    font-size: var(--texto-sm);
  }
  .ranking li:first-child {
    border-top: 0;
    padding-top: 0;
  }
  .ranking .texto-suave {
    padding-left: calc(34px + var(--esp-3));
  }
  .otras a {
    display: flex;
    align-items: center;
    gap: var(--esp-2);
    min-height: 44px;
    padding: 0 var(--esp-2);
    border-radius: var(--radio-sm);
    color: var(--color-texto);
    font-weight: var(--peso-medio);
    text-decoration: none;
  }
  .otras a :global(.icono) {
    margin-left: auto;
    color: var(--color-acento-texto);
  }
  .otras a:hover {
    background: var(--color-superficie-hover);
  }
</style>
