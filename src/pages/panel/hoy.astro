        <div class="v-campo">
          <span class="v-leyenda" id="m-momento">
            ¿A qué hora?
          </span>
          <div class="v-chips" role="radiogroup" aria-labelledby="m-momento">
            <label>
              <input type="radio" name="momento" value="ahora" checked />
              Ahora
            </label>
            <label>
              <input type="radio" name="momento" value="otra" />
              Otra hora
            </label>
          </div>
        </div>
      )}
      <div class="v-campo" data-si-otra-hora hidden={esHoy}>
        <label for="m-hora">Hora</label>
        <input id="m-hora" name="hora" type="time" />
      </div>
      <div class="v-campo" data-si-otra-hora hidden={esHoy}>
        <span class="v-leyenda" id="m-motivo">
          ¿Por qué se escribe a mano?
        </span>
        <div class="v-chips" role="radiogroup" aria-labelledby="m-motivo">
          {MOTIVOS_MANUAL.map((m) => (
            <label>
              <input type="radio" name="motivo_manual" value={m} />
              {m}
            </label>
          ))}
        </div>
      </div>
      <div class="v-campo" data-si-otro hidden>
        <label for="m-obs">Escriba el motivo</label>
        <input id="m-obs" name="observacion" maxlength="300" />
      </div>
      <p class="nota">
        {esHoy
          ? "«Ahora» usa la hora oficial del servidor. Una hora escrita a mano queda señalada para revisión."
          : "Es un día anterior: escriba la hora y el motivo. Queda señalada para revisión."}
      </p>
    </form>
    <Boton slot="acciones" type="submit" form="form-marcar" data-texto-cargando="Registrando…">
      Registrar
    </Boton>
  </Modal>
</PanelLayout>

<script>
  import { enCadaPantalla } from "@/scripts/pantalla";
  // ?q= (enlaces desde otras pantallas) se aplica al llegar; luego se filtra al escribir
  enCadaPantalla(() => {
    const buscar = document.querySelector<HTMLInputElement>('input[data-filtrar="hoy"]');
    if (buscar?.value) buscar.dispatchEvent(new Event("input", { bubbles: true }));
  });
  // Prepara el diálogo con la persona y el tipo de marcación de la fila.
  document.addEventListener("click", (ev) => {
    const b = (ev.target as HTMLElement).closest<HTMLElement>("[data-marcar-persona]");
    if (!b) return;
    const form = document.getElementById("form-marcar") as HTMLFormElement | null;
    if (!form) return;
    const campo = (n: string) => form.querySelector<HTMLInputElement>(`[data-campo="${n}"]`);
    const tipo = b.dataset.marcarTipo ?? "entrada";
    campo("persona")!.value = b.dataset.marcarPersona ?? "";
    campo("tipo")!.value = tipo;
    const p = form.querySelector<HTMLElement>('[data-campo="texto"]');
    if (p)
      p.textContent = `${tipo === "entrada" ? "Entrada" : "Salida"} de ${b.dataset.marcarNombre}`;
    const titulo = document.getElementById("modal-marcar-titulo");
    if (titulo) titulo.textContent = tipo === "entrada" ? "Marcar entrada" : "Marcar salida";
    // Volver a empezar: «Ahora», sin hora ni motivo
    const hoy = !!form.querySelector('input[name="momento"]');
    form
      .querySelectorAll<HTMLInputElement>('input[name="hora"], input[name="observacion"]')
      .forEach((i) => (i.value = ""));
    form
      .querySelectorAll<HTMLInputElement>('input[name="motivo_manual"]')
      .forEach((i) => (i.checked = false));
    const ahora = form.querySelector<HTMLInputElement>('input[name="momento"][value="ahora"]');
    if (ahora) ahora.checked = true;
    form.querySelectorAll<HTMLElement>("[data-si-otra-hora]").forEach((e) => (e.hidden = hoy));
    form.querySelectorAll<HTMLElement>("[data-si-otro]").forEach((e) => (e.hidden = true));
    form.querySelectorAll(".v-error").forEach((e) => e.remove());
    const general = form.querySelector(".v-mensaje-error");
    if (general) general.textContent = "";
  });
  // «Otra hora» muestra la hora y el motivo; «Otro» pide escribirlo.
  document.addEventListener("change", (ev) => {
    const t = ev.target as HTMLInputElement;
    const form = t.form;
    if (form?.id !== "form-marcar") return;
    if (t.name === "momento") {
      form
        .querySelectorAll<HTMLElement>("[data-si-otra-hora]")
        .forEach((e) => (e.hidden = t.value !== "otra"));
      if (t.value === "otra") form.querySelector<HTMLInputElement>("#m-hora")?.focus();
    } else if (t.name === "motivo_manual") {
      const otro = form.querySelector<HTMLElement>("[data-si-otro]");
      if (otro) otro.hidden = t.value !== "Otro";
      if (t.value === "Otro") form.querySelector<HTMLInputElement>("#m-obs")?.focus();
    }
  });
</script>

