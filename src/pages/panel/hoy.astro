                  <td data-etiqueta="Entrada" class="hora">
                    {ent ? (
                      <span>
                        {ent.h} <span class="suave">{ent.m}</span>
                      </span>
                    ) : (
                      <span class="suave">—</span>
                    )}
                  </td>
                  <td data-etiqueta="Salida" class="hora">
                    {sal ? (
                      <span>
                        {sal.h} <span class="suave">{sal.m}</span>
                      </span>
