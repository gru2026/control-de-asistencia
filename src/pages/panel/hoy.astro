---
import PanelLayout from "@/layouts/PanelLayout.astro";
import Tarjeta from "@/components/ui/Tarjeta.astro";
import Tabla from "@/components/ui/Tabla.astro";
import Badge, { type TipoBadge } from "@/components/ui/Badge.astro";
import Boton from "@/components/ui/Boton.astro";
import Icono from "@/components/ui/Icono.astro";
import Modal from "@/components/ui/Modal.astro";
import ChipCategoria from "@/components/ui/ChipCategoria.astro";
import SubnavPanel from "@/components/panel/SubnavPanel.astro";
import "@/styles/panel.css";
import { listarCategorias } from "@/lib/datos/categorias";
import {
  aExcepcion,
  aJornada,
  COLUMNAS_JORNADA,
  type FilaHorario,
  type FilaJornada,
} from "@/lib/datos/jornadas";
import { resolverJornada } from "@/lib/reglas/jornada";
import { estadoFila, type ClaveFila } from "@/lib/reglas/registro";
import { permisoCubre } from "@/lib/reglas/permisos";
import { horaEnZona, sumarDias } from "@/lib/reglas/tiempo";
import { esUuid, texto } from "@/lib/validacion";
import { lunesDe, NOMBRE_DIA_SEMANA } from "@/lib/datos/panel";
import { lecturaPorcentaje } from "@/lib/reglas/estadisticas";
import { fechaLarga, hoyEnZona } from "@/lib/fecha";
import { ponerFlash } from "@/lib/flash";
import { deshacerAsistido, marcarAsistido } from "@/lib/servicios/asistido";
import type { EstadoAsistencia } from "@/types";

const sb = Astro.locals.supabase;
const perfil = Astro.locals.perfil!;
const p = Astro.url.searchParams;
const hoy = hoyEnZona();
const fechaParam = p.get("fecha") ?? "";
const fecha = /^\d{4}-\d{2}-\d{2}$/.test(fechaParam) && fechaParam <= hoy ? fechaParam : hoy;
const esHoy = fecha === hoy;

// ── Marcación asistida ─────────────────────────────────────────
let mensaje: string | null = null;
if (Astro.request.method === "POST") {
  const f = await Astro.request.formData();
  const personalId = texto(f, "personal_id");
  const tipo = texto(f, "tipo");
  const deshacer = texto(f, "accion") === "deshacer";
  const hora = texto(f, "hora");
  // Sin JavaScript también llega el motivo elegido con los botones
  const motivo = texto(f, "motivo_manual");
  const observacion =
    (motivo && motivo !== "Otro" ? motivo : texto(f, "observacion")).slice(0, 300) || null;
  if (!esUuid(personalId) || (tipo !== "entrada" && tipo !== "salida")) {
    mensaje = "Solicitud no válida.";
  } else if (hora && !/^([01]\d|2[0-3]):[0-5]\d$/.test(hora)) {
    mensaje = "Hora no válida.";
  } else if (deshacer) {
    const ok = await deshacerAsistido({ personalId, fecha, tipo, usuarioId: perfil.id });
    ponerFlash(
      Astro.cookies,
      ok ? "info" : "error",
      ok ? "Marcación deshecha." : "Ya no se puede deshacer: corríjala con otra hora.",
    );
    // Si el «Deshacer» vino de otra pantalla (panel de la persona), se vuelve a ella.
    const volver = texto(f, "volver");
    const destino =
      volver.startsWith("/") && !volver.startsWith("//")
        ? volver
        : Astro.url.pathname + Astro.url.search;
    return Astro.redirect(destino, 303);
  } else {
    try {
      const r = await marcarAsistido({
        personalId,
        fecha,
        tipo,
        horaManual: hora || null,
        observacion,
        usuarioId: perfil.id,
      });
      ponerFlash(
        Astro.cookies,
        r.ok ? "exito" : "error",
        r.mensaje,
        r.ok && r.deshacible
          ? { accion: "deshacer", datos: { personal_id: personalId, tipo } }
          : undefined,
      );
      return Astro.redirect(Astro.url.pathname + Astro.url.search, 303);
    } catch (e) {
      console.error("[panel/hoy]", e);
      mensaje = "No se pudo registrar. Intente de nuevo.";
    }
  }
  Astro.response.status = 400;
}

// ── Datos del día ──────────────────────────────────────────────
interface FilaPersona {
  id: string;
  nombre: string;
  apellido: string;
  cedula: string;
  categoria_id: string;
  marca_en_pc: boolean;
  fecha_ingreso: string | null;
  jornadas: FilaJornada | null;
  horarios: FilaHorario[];
}
interface FilaReg {
  personal_id: string;
  estado: EstadoAsistencia;
  hora_entrada: string | null;
  hora_salida: string | null;
  entrada_metodo: string | null;
  salida_metodo: string | null;
  salida_no_registrada: boolean;
  senalado: boolean;
  revisado_por: string | null;
  es_demo: boolean;
}
const [categorias, gente, regs, perms, { data: feriado }] = await Promise.all([
  listarCategorias(sb),
  sb
    .from("personal")
    .select(
      `id, nombre, apellido, cedula, categoria_id, marca_en_pc, fecha_ingreso, jornadas(${COLUMNAS_JORNADA}), horarios(dia_semana, hora_entrada, hora_salida, tolerancia_min, libre)`,
    )
    .eq("estado", "activo")
    .order("apellido")
    .order("nombre"),
  sb
    .from("registros_asistencia")
    .select(
      "personal_id, estado, hora_entrada, hora_salida, entrada_metodo, salida_metodo, salida_no_registrada, senalado, revisado_por, es_demo",
    )
    .eq("fecha", fecha),
  sb
    .from("permisos")
    .select("personal_id, fecha_desde, fecha_hasta")
    .lte("fecha_desde", fecha)
    .gte("fecha_hasta", fecha),
  sb.from("feriados").select("descripcion").eq("fecha", fecha).maybeSingle(),
]);
// Semana del día elegido (D-57): cada día con su lectura, sin contar datos de demostración
const lunes = lunesDe(fecha);
const domingo = sumarDias(lunes, 6);
const [{ data: regsSemana }, { data: feriadosSemana }] = await Promise.all([
  sb
    .from("registros_asistencia")
    .select("fecha, estado")
    .gte("fecha", lunes)
    .lte("fecha", domingo < hoy ? domingo : hoy)
    .eq("es_demo", false),
  sb.from("feriados").select("fecha").gte("fecha", lunes).lte("fecha", domingo),
]);
const porDiaSemana = new Map<string, { total: number; cumplidas: number }>();
for (const r of (regsSemana ?? []) as { fecha: string; estado: EstadoAsistencia }[]) {
  const x = porDiaSemana.get(r.fecha) ?? { total: 0, cumplidas: 0 };
  x.total++;
  if (r.estado !== "falta") x.cumplidas++;
  porDiaSemana.set(r.fecha, x);
}
const esFeriado = new Set(((feriadosSemana ?? []) as { fecha: string }[]).map((f) => f.fecha));
const semanaDias = Array.from({ length: 7 }, (_, i) => {
  const f = sumarDias(lunes, i);
  const d = porDiaSemana.get(f);
  const pct = d?.total ? (d.cumplidas / d.total) * 100 : null;
  return {
    fecha: f,
    dia: Number(f.slice(8, 10)),
    nombre: NOMBRE_DIA_SEMANA[i + 1]!.slice(0, 3),
    futuro: f > hoy,
    feriado: esFeriado.has(f),
    pct,
    lectura: pct === null ? null : lecturaPorcentaje(pct),
  };
});
const catPorId = new Map(categorias.map((c) => [c.id, c]));
const regPorPersona = new Map(((regs.data ?? []) as FilaReg[]).map((r) => [r.personal_id, r]));
const permisos = (perms.data ?? []).map((x) => ({
  personalId: x.personal_id as string,
  desde: x.fecha_desde as string,
  hasta: x.fecha_hasta as string,
}));

const filasTodas = ((gente.data ?? []) as unknown as FilaPersona[])
  .filter((x) => !x.fecha_ingreso || x.fecha_ingreso <= fecha)
  .map((x) => {
    const regla = resolverJornada({
      fecha,
      jornada: x.jornadas ? aJornada(x.jornadas) : null,
      excepciones: x.horarios.map(aExcepcion),
      feriados: feriado ? [fecha] : [],
    });
    const r = regPorPersona.get(x.id);
    const real = r && !r.es_demo ? r : null;
    const estado = estadoFila({
      regla,
      registro: r
        ? {
            horaEntrada: r.hora_entrada,
            horaSalida: r.hora_salida,
            estado: r.estado,
            salidaNoRegistrada: r.salida_no_registrada,
            esDemo: r.es_demo,
          }
        : null,
      tienePermiso: permisoCubre(permisos, x.id, fecha),
    });
    return { persona: x, regla, real, ...estado };
  });

// ── Filtros ────────────────────────────────────────────────────
const VISTAS = {
  todos: "Programados hoy",
  pendientes: "Por llegar",
  llegaron: "Llegaron",
  tarde: "Llegaron tarde",
  salida: "Sin salida marcada",
  faltas: "Faltas",
  permisos: "Permisos",
  secretaria: "Marcan en secretaría",
  libres: "Sin jornada este día",
} as const;
type Vista = keyof typeof VISTAS;
const vista: Vista = (Object.keys(VISTAS) as Vista[]).includes(p.get("ver") as Vista)
  ? (p.get("ver") as Vista)
  : "todos";
const categoria = categorias.some((c) => c.id === p.get("categoria")) ? p.get("categoria") : null;
const q = (p.get("q") ?? "").slice(0, 80);

const LLEGARON: ClaveFila[] = ["presente", "tarde", "sin_salida"];
const enVistaDe = (v: Vista) => (f: (typeof filasTodas)[number]) => {
  switch (v) {
    case "pendientes":
      return f.clave === "pendiente";
    case "llegaron":
      return LLEGARON.includes(f.clave) && !!f.real?.hora_entrada;
    case "tarde":
      return f.real?.estado === "tarde";
    case "salida":
      return f.accion === "salida";
    case "faltas":
      return f.clave === "falta";
    case "permisos":
      return f.clave === "permiso";
    case "secretaria":
      return f.persona.marca_en_pc && f.clave !== "no_programado";
    case "libres":
      return f.clave === "no_programado";
    default:
      return f.clave !== "no_programado";
  }
};
const enVista = enVistaDe(vista);
const deCategoria = (f: (typeof filasTodas)[number]) =>
  !categoria || f.persona.categoria_id === categoria;
// Cuántas personas hay en cada estado (con la categoría elegida): los botones de estado los muestran
const conteo = Object.fromEntries(
  (Object.keys(VISTAS) as Vista[]).map((v) => [
    v,
    filasTodas.filter(enVistaDe(v)).filter(deCategoria).length,
  ]),
) as Record<Vista, number>;
const filas = filasTodas
  .filter(enVista)
  .filter(deCategoria)
  // Primero quienes faltan por llegar y marcan en secretaría
  .sort(
    (a, b) =>
      Number(b.clave === "pendiente") - Number(a.clave === "pendiente") ||
      Number(b.persona.marca_en_pc) - Number(a.persona.marca_en_pc),
  );

const programados = filasTodas.filter((f) => f.clave !== "no_programado");
const resumen = {
  programados: programados.length,
  llegaron: programados.filter((f) => f.real?.hora_entrada).length,
  pendientes: programados.filter((f) => f.clave === "pendiente").length,
  permisos: programados.filter((f) => f.clave === "permiso").length,
  faltas: programados.filter((f) => f.clave === "falta").length,
};

const ESTADO: Record<ClaveFila, [TipoBadge, string]> = {
  pendiente: ["info", "Por llegar"],
  presente: ["presente", "Presente"],
  tarde: ["tarde", "Tarde"],
  falta: ["falta", "Falta"],
  permiso: ["permiso", "Permiso"],
  sin_salida: ["pendiente", "Sin salida"],
  no_programado: ["inactivo", "Sin jornada"],
};
const METODO: Record<string, string> = {
  qr: "teléfono",
  asistido: "secretaría",
  manual: "a mano",
  kiosco: "PC",
};
const hora = (iso: string | null | undefined, metodo: string | null | undefined) =>
  iso ? { h: horaEnZona(iso), m: metodo ? (METODO[metodo] ?? metodo) : "" } : null;
const navegar = (f: string) => {
  const u = new URL(Astro.url);
  if (f === hoy) u.searchParams.delete("fecha");
  else u.searchParams.set("fecha", f);
  return u.pathname + u.search;
};
const hayFiltros = Boolean(categoria || vista !== "todos");
// Botones de estado: nombre corto y color de su punto
const ESTADOS_BOTON: { v: Vista; texto: string; tono?: string }[] = [
  { v: "todos", texto: "Todos" },
  { v: "pendientes", texto: esHoy ? "Por llegar" : "Sin registro", tono: "info" },
  { v: "llegaron", texto: "Llegaron", tono: "exito" },
  { v: "tarde", texto: "Tarde", tono: "alerta" },
  { v: "salida", texto: "Sin salida", tono: "alerta" },
  { v: "faltas", texto: "Faltas", tono: "error" },
  { v: "permisos", texto: "Permiso", tono: "gris" },
  { v: "secretaria", texto: "En secretaría" },
  { v: "libres", texto: "Sin jornada" },
];
const siempre: Vista[] = ["todos", "pendientes", "llegaron"];
const conVer = (v: Vista) => {
  const u = new URL(Astro.url);
  if (v === "todos") u.searchParams.delete("ver");
  else u.searchParams.set("ver", v);
  return u.pathname + u.search;
};
// Frase en palabras (como en el resto del panel)
const largo = fechaLarga(fecha);
const fechaDia = largo.charAt(0).toUpperCase() + largo.slice(1);
const pctLlegaron = resumen.programados ? (resumen.llegaron / resumen.programados) * 100 : 0;
const fraseDia = feriado
  ? `Feriado: ${feriado.descripcion}`
  : resumen.programados === 0
    ? "Nadie tiene jornada este día"
    : esHoy
      ? `${resumen.llegaron} de ${resumen.programados} ya llegaron`
      : `${resumen.llegaron} de ${resumen.programados} vinieron`;
const detalleDia =
  resumen.programados && !feriado
    ? [
        resumen.pendientes && `${resumen.pendientes} ${esHoy ? "por llegar" : "sin registro"}`,
        conteo.tarde && `${conteo.tarde} tarde`,
        resumen.faltas && `${resumen.faltas} ${resumen.faltas === 1 ? "falta" : "faltas"}`,
        resumen.permisos && `${resumen.permisos} de permiso`,
      ]
        .filter(Boolean)
        .join(" · ")
    : "";
const volver = encodeURIComponent("/panel/hoy");
const MOTIVOS_MANUAL = [
  "Falla de conexión",
  "Olvidó marcar",
  "Teléfono dañado o sin batería",
  "No tiene teléfono",
  "Otro",
];
---

<PanelLayout
  titulo="Hoy"
  amplio
  migas={[{ texto: "Panel de control", href: "/panel" }, { texto: "Hoy" }]}
>
  <SubnavPanel filtros={{ periodo: "mes", categoriaId: categoria }} />

  <div class="pila">
    {mensaje && (
      <p class="error-linea" role="alert">
        {mensaje}
      </p>
    )}

    <!-- Tarjeta del día: cómo va (izquierda) y qué día se ve (derecha) -->
    <section class="tarjeta-dia" aria-label="Resumen del día">
      <div class="resumen-dia">
        <p class="fecha-dia">
          {fechaDia}
          {esHoy && <span class="es-hoy">Hoy</span>}
        </p>
        <p class="frase">{fraseDia}</p>
        {resumen.programados > 0 && !feriado && (
          <div class="avance-fila">
            <div
              class="avance"
              role="progressbar"
              aria-label="Llegaron"
              aria-valuemin="0"
              aria-valuemax={resumen.programados}
              aria-valuenow={resumen.llegaron}
            >
              <span style={`width: ${pctLlegaron}%`}></span>
            </div>
            <span class="pct">{Math.round(pctLlegaron)} %</span>
          </div>
        )}
        {detalleDia && <p class="detalle">{detalleDia}</p>}
      </div>
      <!-- Semana: cada día se toca; el color dice cómo fue -->
      <nav class="semana" aria-label="Elegir el día">
        <div class="fila-dias">
          <a href={navegar(sumarDias(fecha, -7))} class="flecha" aria-label="Semana anterior">
            <Icono nombre="anterior" />
          </a>
          <ol class="dias">
            {semanaDias.map((d) => (
              <li>
                {d.futuro ? (
                  <span class="dia-chip futuro" aria-hidden="true">
                    <span class="dsem">{d.nombre}</span>
                    <span class="num">{d.dia}</span>
                    <span class="marca">&nbsp;</span>
                  </span>
                ) : (
                  <a
                    href={navegar(d.fecha)}
                    class:list={["dia-chip", d.lectura, d.fecha === fecha && "actual"]}
                    aria-current={d.fecha === fecha ? "date" : undefined}
                    aria-label={`${d.nombre} ${d.dia}${d.fecha === hoy ? " (hoy)" : ""}${d.feriado ? ", feriado" : d.pct !== null ? `, ${Math.round(d.pct)} % de asistencia` : ""}`}
                  >
                    <span class="dsem">{d.nombre}</span>
                    <span class="num">{d.dia}</span>
                    <span class="marca">
                      {d.fecha === hoy
                        ? "Hoy"
                        : d.feriado
                          ? "Feriado"
                          : d.pct !== null
                            ? `${Math.round(d.pct)} %`
                            : "—"}
                    </span>
                  </a>
                )}
              </li>
            ))}
          </ol>
          {sumarDias(fecha, 7) <= hoy ? (
            <a href={navegar(sumarDias(fecha, 7))} class="flecha" aria-label="Semana siguiente">
              <Icono nombre="siguiente" />
            </a>
          ) : (
            <span class="flecha inactiva" aria-hidden="true">
              <Icono nombre="siguiente" />
            </span>
          )}
        </div>
        <div class="fila-fecha">
          <form method="get" class="otra-fecha" data-autoenviar>
            <label>
              <Icono nombre="calendario" tamano={18} />
              <span class="visualmente-oculto">Otra fecha</span>
              <input
                type="date"
                name="fecha"
                value={fecha}
                max={hoy}
                aria-label="Elegir otra fecha"
              />
            </label>
            {vista !== "todos" && <input type="hidden" name="ver" value={vista} />}
            {categoria && <input type="hidden" name="categoria" value={categoria} />}
            <noscript>
              <button type="submit">Ir</button>
            </noscript>
          </form>
          {!esHoy && (
            <a href={navegar(hoy)} class="ir-hoy">
              Volver a hoy
            </a>
          )}
        </div>
      </nav>
    </section>

    {feriado && (
      <p class="aviso-linea">Feriado: {feriado.descripcion}. Nadie tiene jornada este día.</p>
    )}

    <Tarjeta>
      <!-- Estados: filtran la lista y dicen cuántos hay -->
      <nav class="estados" aria-label="Mostrar">
        {ESTADOS_BOTON.filter((e) => siempre.includes(e.v) || conteo[e.v] > 0 || e.v === vista).map(
          (e) => (
            <a href={conVer(e.v)} aria-current={vista === e.v ? "true" : undefined}>
              {e.tono && <span class:list={["punto", e.tono]} aria-hidden="true" />}
              {e.texto}
              <span class="cuenta">{conteo[e.v]}</span>
            </a>
          ),
        )}
      </nav>

      <div class="herramientas">
        <label class="buscar">
          <Icono nombre="buscar" tamano={18} />
          <input
            type="search"
            data-filtrar="hoy"
            value={q}
            placeholder="Buscar por nombre o cédula"
            aria-label="Buscar por nombre o cédula"
            autocomplete="off"
          />
        </label>
        <form method="get" class="cat" data-autoenviar>
          {!esHoy && <input type="hidden" name="fecha" value={fecha} />}
          {vista !== "todos" && <input type="hidden" name="ver" value={vista} />}
          <label for="hoy-cat" class="visualmente-oculto">
            Categoría
          </label>
          <select id="hoy-cat" name="categoria">
            <option value="">Todas las categorías</option>
            {categorias.map((c) => (
              <option value={c.id} selected={c.id === categoria}>
                {c.nombre}
              </option>
            ))}
          </select>
          <noscript>
            <button type="submit">Aplicar</button>
          </noscript>
        </form>
        <span class="total">
          <strong>{filas.length}</strong> {filas.length === 1 ? "persona" : "personas"}
        </span>
      </div>

      <div data-filtrable="hoy">
        <Tabla
          titulo="Registro del día"
          tarjetas
          hayFilas={filas.length > 0}
          vacio={hayFiltros ? "Nadie coincide con esos filtros." : "Nadie tiene jornada este día."}
        >
          <Fragment slot="vacio">
            {hayFiltros && (
              <a href={esHoy ? "/panel/hoy" : `/panel/hoy?fecha=${fecha}`}>Limpiar filtros</a>
            )}
          </Fragment>
          <thead>
            <tr>
              <th scope="col">Persona</th>
              <th scope="col">Categoría</th>
              <th scope="col" class="col-jornada">
                Jornada
              </th>
              <th scope="col">Entrada</th>
              <th scope="col">Salida</th>
              <th scope="col">Estado</th>
              <th scope="col">
                <span class="visualmente-oculto">Acciones</span>
              </th>
            </tr>
          </thead>
          <tbody>
            {filas.map((f) => {
              const c = catPorId.get(f.persona.categoria_id);
              const nombre = `${f.persona.nombre} ${f.persona.apellido}`;
              const ent = hora(f.real?.hora_entrada, f.real?.entrada_metodo);
              const sal = hora(f.real?.hora_salida, f.real?.salida_metodo);
              const [badge, textoBase] = ESTADO[f.clave];
              // En un día pasado, quien no marcó no está «por llegar»
              const textoEstado = !esHoy && f.clave === "pendiente" ? "Sin registro" : textoBase;
              return (
                <tr data-buscar={f.persona.cedula}>
                  <td class="principal">
                    <a
                      href={`/personal/${f.persona.id}`}
                      class="nombre"
                      data-persona={f.persona.id}
                    >
                      {f.persona.apellido}, {f.persona.nombre}
                    </a>
                    {f.persona.marca_en_pc && <span class="sin-tel">Marca en secretaría</span>}
                  </td>
                  <td data-etiqueta="Categoría">
                    {c ? <ChipCategoria nombre={c.nombre} color={c.color} /> : "—"}
                  </td>
                  <td data-etiqueta="Jornada" class="solo-pc col-jornada hora">
