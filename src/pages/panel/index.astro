          )}
        </section>
      )}
      <div class="acciones-vistazo">
        <button
          type="button"
          class="v-boton v-secundario"
          data-ventana="/ventanas/permiso"
          data-ventana-modo="centro"
        >
          <Icono nombre="permiso" tamano={18} /> Cargar un permiso
        </button>
      </div>
    </div>
    <footer class="v-pie">
      <a
        href={irDesde("ausencias")("/panel/ausencias")}
        data-seccion
        class="v-boton v-primario v-bloque-ancho"
      >
        Ver todo en Ausencias <Icono nombre="siguiente" tamano={18} />
      </a>
    </footer>
  </template>

  <template id="capa-categorias">
    <header class="v-cabecera" tabindex="-1">
      <div>
        <h2 class="v-titulo" id="capa-categorias-titulo" data-ventana-titulo>
          Por categoría
        </h2>
        <p class="v-sub">{NOMBRE_PERIODO[filtros.periodo]}</p>
      </div>
      <button type="button" class="v-cerrar" aria-label="Cerrar" data-cerrar-ventana>
        <Icono nombre="error" tamano={22} />
      </button>
    </header>
    <div class="v-contenido vistazo">
      {d.mejorCat && d.peorCat && (
        <dl class="tres">
          <div class={lecturaPorcentaje(d.mejorCat.asistencia)}>
            <dt>La mejor</dt>
            <dd>
              <a
                href={irDesde("categorias")("/panel/categorias", {
                  categoria: d.mejorCat.categoriaId,
                })}
              >
                {porcentaje(d.mejorCat.asistencia)}
              </a>
              <small>{d.mejorCat.cat?.nombre}</small>
            </dd>
          </div>
          <div class={lecturaPorcentaje(d.peorCat.asistencia)}>
            <dt>La más baja</dt>
            <dd>
              <a
                href={irDesde("categorias")("/panel/categorias", {
                  categoria: d.peorCat.categoriaId,
                })}
              >
                {porcentaje(d.peorCat.asistencia)}
              </a>
              <small>{d.peorCat.cat?.nombre}</small>
            </dd>
          </div>
          <div class:list={[enAtencion && "atencion"]}>
            <dt>Por debajo de 90 %</dt>
            <dd>
              <a href={irDesde("categorias")("/panel/categorias")}>{enAtencion}</a>
            </dd>
          </div>
        </dl>
      )}
      {d.cats.length > 0 && (
        <BarrasHorizontales
          maximo={100}
          lectura
          items={d.cats.map((c) => ({
            etiqueta: c.cat?.nombre ?? "—",
