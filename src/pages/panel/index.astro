                <button
                  type="button"
                  class="v-boton v-secundario"
                  data-ventana={`/ventanas/permiso?persona=${r.personalId}&desde=${r.fecha}`}
                  data-ventana-modo="centro"
                >
                  Cargar permiso
                </button>
              </li>
            ))}
          </ul>
          {d.faltasPeriodo.length > 5 && (
            <a class="ver-mas" href={irDesde("ausencias")("/panel/ausencias")}>
              Ver las {d.faltasPeriodo.length} faltas <Icono nombre="siguiente" tamano={16} />
