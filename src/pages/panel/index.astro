---
/**
 * Panel de control · Resumen (D-53, D-55). Tres niveles:
 * 1) recuadros en palabras; 2) vistazo en el panel lateral (datos rápidos y
 * acciones); 3) la sección completa (/panel/…), por el botón «Ver todo» o el menú.
 */
import PanelSeccionLayout from "@/layouts/PanelSeccionLayout.astro";
import Icono from "@/components/ui/Icono.astro";
import Modulo from "@/components/panel/Modulo.astro";
import MiniLinea from "@/components/panel/MiniLinea.astro";
import Anillo from "@/components/panel/Anillo.astro";
import Contador from "@/components/panel/Contador.astro";
import BarraApilada from "@/components/graficas/BarraApilada.astro";
import BarrasHorizontales from "@/components/graficas/BarrasHorizontales.astro";
import GraficaLinea from "@/components/graficas/GraficaLinea.astro";
import { fechaCorta, fechaLarga, hoyEnZona } from "@/lib/fecha";
import { listarCategorias } from "@/lib/datos/categorias";
import {
  cargarPanel,
  dd,
  diaTexto,
  enlacePanel,
  iniciales,
  leerFiltros,
  NOMBRE_PERIODO,
} from "@/lib/datos/panel";
import { lecturaPorcentaje, NOMBRE_LECTURA } from "@/lib/reglas/estadisticas";
import { numero, plural, porcentaje } from "@/lib/formato";

const sb = Astro.locals.supabase;
const perfil = Astro.locals.perfil!;
const hoy = hoyEnZona();
const categorias = await listarCategorias(sb);
const filtros = leerFiltros(Astro.url, categorias);
const esDirectiva = perfil.rol === "directiva";
const d = await cargarPanel(sb, { hoy, filtros, categorias, esDirectiva });
const ir = (ruta: string, extra: Record<string, string | null> = {}) =>
  enlacePanel(ruta, filtros, extra);
// Desde un vistazo, la sección ofrece «Volver al vistazo» (D-56)
const irDesde =
  (capa: string) =>
  (ruta: string, extra: Record<string, string | null> = {}) =>
    ir(ruta, { ...extra, volver: capa });

const { resumen, hayDatos } = d;
const lecturaMes = hayDatos ? lecturaPorcentaje(resumen.asistencia) : undefined;
const lecturaPunt = hayDatos ? lecturaPorcentaje(resumen.puntualidad) : undefined;
const maxLlegada = Math.max(1, ...d.llegadas.map((l) => l.valor));
const TONO_TRAMO: Record<string, string> = {
  antes: "puntual",
  "0-5": "puntual",
  "6-15": "tolerancia",
  "16-30": "tarde",
  "31-60": "muy-tarde",
  "60+": "muy-tarde",
};
const grupo = (...claves: string[]) =>
  d.llegadas.filter((l) => claves.includes(l.clave)).reduce((s, l) => s + l.valor, 0);
const llegadasGrupos = [
  { clase: "puntual", texto: "A tiempo", valor: grupo("antes", "0-5") },
  { clase: "tolerancia", texto: "En tolerancia", valor: grupo("6-15") },
  { clase: "tarde", texto: "Tarde", valor: grupo("16-30", "31-60", "60+") },
];
const pct = (v: number) => porcentaje(d.totalLlegadas ? (v / d.totalLlegadas) * 100 : 0);
const diasBajos = [...d.serieTendencia].sort((a, b) => a.valor - b.valor).slice(0, 3);
const enAtencion = d.cats.filter((c) => lecturaPorcentaje(c.asistencia) !== "bien").length;
const contarTipo = (t: string) => d.tareas.filter((x) => x.tipo === t).length;
const proximos = Math.max(0, d.totalAus - d.permisosHoy);
const planillaHoy = `/api/reportes/planilla?fecha=${hoy}&tipo=docentes&formato=pdf&ver=1`;
---

<PanelSeccionLayout
  titulo="Panel de control"
  subtitulo={fechaLarga(hoy)}
  resumen
  filtros={filtros}
  categorias={categorias}
  esDemo={d.esDemo}
  rango={`${fechaCorta(d.rango.desde)} – ${fechaCorta(d.rango.hasta)}`}
>
  <div class:list={["modulos", Astro.url.searchParams.get("abrir") && "quieto"]}>
    <Modulo
      titulo="Hoy"
      icono="reloj"
      frase={d.fraseHoy}
      detalle={d.detalleHoy}
      capa="capa-hoy"
      tono="azul"
      orden={0}
    >
      {d.hayJornadaHoy && (
        <Fragment slot="frase">
          <Contador valor={d.llegaronHoy} /> de {numero(d.laborablesHoy)} ya llegaron
        </Fragment>
      )}
      {d.hayJornadaHoy && (
        <Anillo valor={(d.llegaronHoy / d.laborablesHoy) * 100} texto="llegaron" />
      )}
    </Modulo>

    <Modulo
      titulo="Pendientes"
      icono="campana"
      frase={
        d.tareas.length
          ? plural(d.tareas.length, "cosa por resolver", "cosas por resolver")
          : "Todo al día"
      }
      detalle={d.tareas.length ? undefined : "No hay nada pendiente."}
      lectura={d.tareas.length ? "atencion" : "bien"}
      capa="capa-pendientes"
      tono="ambar"
      orden={1}
    >
      {d.tareas.length > 0 && (
        <Fragment slot="frase">
          <Contador valor={d.tareas.length} />{" "}
          {d.tareas.length === 1 ? "cosa por resolver" : "cosas por resolver"}
        </Fragment>
      )}
      {d.tareas.length > 0 && (
        <span class="mini-tareas">
          {d.tareas.slice(0, 3).map((t, i) => (
            <span style={`--i: ${i}`}>
              <Icono nombre={t.icono} tamano={16} />
              {t.texto}
            </span>
          ))}
        </span>
      )}
    </Modulo>

    <Modulo
      titulo={NOMBRE_PERIODO[filtros.periodo]}
      icono="tendencia"
      frase={hayDatos ? `${porcentaje(resumen.asistencia)} de asistencia` : "Sin registros todavía"}
      detalle={d.comparacionAsistencia}
      lectura={lecturaMes}
      capa="capa-asistencia"
      tono="verde"
      orden={2}
    >
      {hayDatos && (
        <Fragment slot="frase">
          <Contador valor={resumen.asistencia} sufijo=" %" /> de asistencia
        </Fragment>
      )}
      <MiniLinea
        valores={d.serieTendencia.map((s) => s.valor)}
        final={hayDatos ? porcentaje(d.serieTendencia.at(-1)?.valor ?? 0) : undefined}
      />
    </Modulo>

    <Modulo
      titulo="Puntualidad"
      icono="reloj"
      frase={d.frasePuntualidad}
      detalle={hayDatos ? `${porcentaje(resumen.puntualidad)} llegó a tiempo` : undefined}
      lectura={lecturaPunt}
      capa="capa-puntualidad"
      tono="violeta"
      orden={3}
    >
      {hayDatos && (
        <span class="mini-barras">
          {d.llegadas.map((l, i) => (
            <span
              class={TONO_TRAMO[l.clave] ?? "puntual"}
              style={`height: ${Math.max(4, (l.valor / maxLlegada) * 100)}%; --i: ${i}`}
            />
          ))}
        </span>
      )}
    </Modulo>

    <Modulo
      titulo="Ausencias y permisos"
      icono="permiso"
      frase={
        d.totalAus
          ? plural(d.totalAus, "persona con permiso", "personas con permiso")
          : "Nadie tiene permiso"
      }
      detalle={
        d.proximoFeriado
          ? `Próximo feriado: ${diaTexto(d.proximoFeriado.fecha)}`
          : "Hoy y los próximos 7 días"
      }
      capa="capa-ausencias"
      tono="rosa"
      orden={4}
    >
      {d.totalAus > 0 && (
        <Fragment slot="frase">
          <Contador valor={d.totalAus} />{" "}
          {d.totalAus === 1 ? "persona con permiso" : "personas con permiso"}
        </Fragment>
      )}
      {d.ausentes.length > 0 && (
        <span class="caras">
          {d.ausentes.slice(0, 6).map((a, i) => (
            <span style={`--c: ${a.color}; --i: ${i}`}>{iniciales(a.nombre)}</span>
          ))}
          {d.totalAus > 6 && (
            <span class="mas" style={`--i: ${Math.min(6, d.ausentes.length)}`}>
              +{d.totalAus - 6}
            </span>
          )}
        </span>
      )}
    </Modulo>

    <Modulo
      titulo="Por categoría"
      icono="usuarios"
      frase={d.fraseCategoria}
      detalle={
        d.peorCat && d.cats.length > 1
          ? `${d.peorCat.cat?.nombre}: ${porcentaje(d.peorCat.asistencia)} de asistencia`
          : undefined
      }
      lectura={d.peorCat ? lecturaPorcentaje(d.peorCat.asistencia) : undefined}
      capa="capa-categorias"
      tono="cian"
      orden={5}
    >
      {d.cats.length > 0 && (
        <span class="mini-cats">
          {d.catsOrden.slice(0, 4).map((c, i) => (
            <span class="fila-cat" style={`--i: ${i}`}>
              <span class="nombre-cat">
                <span class="punto-cat" style={`background: ${c.cat?.color ?? "#64748b"}`} />
                {c.cat?.nombre ?? "—"}
              </span>
              <span class="barra-cat">
                <span
                  class={lecturaPorcentaje(c.asistencia)}
                  style={`width: ${Math.max(4, c.asistencia)}%`}
                />
              </span>
              <span class="pct-cat">{porcentaje(c.asistencia)}</span>
            </span>
          ))}
        </span>
      )}
    </Modulo>
  </div>
  <p class="pie-panel">
    Toque un recuadro para ver un vistazo; desde ahí, «Ver todo» abre la sección completa. También
    están en el menú, dentro de <strong>Panel de control</strong>.
  </p>

  <!-- ── Vistazos (segundo nivel): mismo orden siempre ── -->
  <template id="capa-hoy">
    <header class="v-cabecera" tabindex="-1">
      <div>
        <h2 class="v-titulo" id="capa-hoy-titulo" data-ventana-titulo>
          Hoy
        </h2>
        <p class="v-sub">{fechaLarga(hoy)}</p>
      </div>
      <button type="button" class="v-cerrar" aria-label="Cerrar" data-cerrar-ventana>
        <Icono nombre="error" tamano={22} />
      </button>
    </header>
    <div class="v-contenido vistazo">
      <p class="frase-vistazo">{d.fraseHoy}</p>
      {d.hayJornadaHoy && (
        <>
          <dl class="tres">
            <div>
              <dt>Llegaron</dt>
              <dd>
                <a href={irDesde("hoy")("/panel/hoy", { ver: "llegaron" })}>
                  {numero(d.llegaronHoy)}
                </a>
              </dd>
            </div>
            <div class:list={[d.hoyConteo.tarde && "atencion"]}>
              <dt>Tarde</dt>
              <dd>
                <a href={irDesde("hoy")("/panel/hoy", { ver: "llegaron" })}>
                  {numero(d.hoyConteo.tarde)}
                </a>
              </dd>
            </div>
            <div class:list={[d.pendientesHoy && "atencion"]}>
              <dt>Sin marcar</dt>
              <dd>
                <a href={irDesde("hoy")("/panel/hoy", { ver: "pendientes" })}>
                  {numero(d.pendientesHoy)}
                </a>
              </dd>
            </div>
          </dl>
          <BarraApilada segmentos={d.hoySegmentos} soloConValor />
        </>
      )}
      {d.sinMarcarHoy.length > 0 && (
        <section class="corta">
          <h3>Aún sin marcar</h3>
          <ul>
            {d.sinMarcarHoy.slice(0, 5).map((x) => (
              <li>
                <a href={`/personal/${x.id}`} data-persona={x.id}>
                  {x.apellido}, {x.nombre}
                </a>
                <span>{d.catPorId.get(x.categoria_id)?.nombre}</span>
              </li>
            ))}
          </ul>
          {d.sinMarcarHoy.length > 5 && (
            <a class="ver-mas" href={irDesde("hoy")("/panel/hoy", { ver: "pendientes" })}>
              Ver los {d.sinMarcarHoy.length} sin marcar <Icono nombre="siguiente" tamano={16} />
            </a>
          )}
        </section>
      )}
      <div class="acciones-vistazo">
        <a
          href={planillaHoy}
          target="_blank"
          rel="noopener"
          data-astro-reload
          class="v-boton v-secundario"
        >
          <Icono nombre="descargar" tamano={18} /> Planilla de hoy
        </a>
      </div>
    </div>
    <footer class="v-pie">
      <a href={irDesde("hoy")("/panel/hoy")} data-seccion class="v-boton v-primario v-bloque-ancho">
        Ver todo en Hoy <Icono nombre="siguiente" tamano={18} />
      </a>
    </footer>
  </template>

  <template id="capa-pendientes">
    <header class="v-cabecera" tabindex="-1">
      <div>
        <h2 class="v-titulo" id="capa-pendientes-titulo" data-ventana-titulo>
          Pendientes
        </h2>
        <p class="v-sub">Lo que espera una acción</p>
      </div>
      <button type="button" class="v-cerrar" aria-label="Cerrar" data-cerrar-ventana>
        <Icono nombre="error" tamano={22} />
      </button>
    </header>
    <div class="v-contenido vistazo">
      <p class="frase-vistazo">
        {d.tareas.length
          ? plural(d.tareas.length, "cosa por resolver", "cosas por resolver")
          : "Todo al día"}
      </p>
      <dl class="tres">
        <div class:list={[contarTipo("telefono") && "atencion"]}>
          <dt>Teléfonos</dt>
          <dd>
            <a href={irDesde("pendientes")("/panel/pendientes", { tipo: "telefono" })}>
              {contarTipo("telefono")}
            </a>
          </dd>
        </div>
        <div class:list={[contarTipo("falta") && "atencion"]}>
          <dt>Faltas</dt>
          <dd>
            <a href={irDesde("pendientes")("/panel/pendientes", { tipo: "falta" })}>
              {contarTipo("falta")}
            </a>
          </dd>
        </div>
        <div class:list={[contarTipo("salida") && "atencion"]}>
          <dt>Salidas</dt>
          <dd>
            <a href={irDesde("pendientes")("/panel/pendientes", { tipo: "salida" })}>
              {contarTipo("salida")}
            </a>
          </dd>
        </div>
      </dl>
      {d.tareas.length > 0 && (
        <section class="corta">
          <h3>Lo primero</h3>
          <ul class="tareas-vistazo">
            {d.tareas.slice(0, 5).map((t) => (
              <li>
                <span>{t.texto}</span>
                {t.aprobar ? (
                  <form method="post" action="/api/acciones" data-api>
                    <input type="hidden" name="accion" value="disp_aprobar" />
                    <input type="hidden" name="personal_id" value={t.aprobar.personalId} />
                    <input type="hidden" name="dispositivo_id" value={t.aprobar.dispositivoId} />
                    <button
                      type="submit"
                      class="v-boton v-secundario"
                      data-texto-cargando="Aprobando…"
                    >
                      {t.boton}
                    </button>
                  </form>
                ) : t.ventana ? (
                  <button
                    type="button"
                    class="v-boton v-secundario"
                    data-ventana={t.ventana}
                    data-ventana-modo="centro"
                  >
                    {t.boton}
                  </button>
                ) : t.persona ? (
                  <a
                    class="v-boton v-secundario"
                    href={`/personal/${t.persona}`}
                    data-persona={t.persona}
                  >
                    {t.boton}
                  </a>
                ) : (
                  <a class="v-boton v-secundario" href={t.href}>
                    {t.boton}
                  </a>
                )}
              </li>
            ))}
          </ul>
          {d.tareas.length > 5 && (
            <a class="ver-mas" href={irDesde("pendientes")("/panel/pendientes")}>
              Ver los {d.tareas.length} pendientes <Icono nombre="siguiente" tamano={16} />
            </a>
          )}
        </section>
      )}
    </div>
    <footer class="v-pie">
      <a
        href={irDesde("pendientes")("/panel/pendientes")}
        data-seccion
        class="v-boton v-primario v-bloque-ancho"
      >
        Ver todo en Pendientes <Icono nombre="siguiente" tamano={18} />
      </a>
    </footer>
  </template>

  <template id="capa-asistencia">
    <header class="v-cabecera" tabindex="-1">
      <div>
        <h2 class="v-titulo" id="capa-asistencia-titulo" data-ventana-titulo>
          Asistencia
        </h2>
        <p class="v-sub">
          {NOMBRE_PERIODO[filtros.periodo]} · {fechaCorta(d.rango.desde)} –{" "}
          {fechaCorta(d.rango.hasta)}
        </p>
      </div>
      <button type="button" class="v-cerrar" aria-label="Cerrar" data-cerrar-ventana>
        <Icono nombre="error" tamano={22} />
      </button>
    </header>
    <div class="v-contenido vistazo">
      <p class="frase-vistazo">
        {lecturaMes && <span class:list={["chip", lecturaMes]}>{NOMBRE_LECTURA[lecturaMes]}</span>}
        {hayDatos ? `${porcentaje(resumen.asistencia)} de asistencia` : "Sin registros todavía"}
        {d.comparacionAsistencia && <small>{d.comparacionAsistencia}</small>}
      </p>
      <dl class="tres">
        <div>
          <dt>Asistencia</dt>
          <dd>
            <a href={irDesde("asistencia")("/panel/asistencia")}>
              {hayDatos ? porcentaje(resumen.asistencia) : "—"}
            </a>
          </dd>
        </div>
        <div class:list={[resumen.conteo.falta && "atencion"]}>
          <dt>Faltas</dt>
          <dd>
            <a href={irDesde("asistencia")("/panel/ausencias")}>{numero(resumen.conteo.falta)}</a>
          </dd>
        </div>
        <div>
          <dt>Permisos</dt>
          <dd>
            <a href={irDesde("asistencia")("/panel/ausencias")}>{numero(resumen.conteo.permiso)}</a>
          </dd>
        </div>
      </dl>
      {d.serieTendencia.length > 1 && (
        <GraficaLinea
          puntos={d.serieTendencia.map((s) => ({
            etiqueta: dd(s.clave),
            fecha: s.clave,
            valor: s.valor,
            detalle: `${diaTexto(s.clave)} · ${plural(s.conteo.falta, "falta", "faltas")}, ${s.conteo.tarde} tarde`,
            href: `/panel/hoy?fecha=${s.clave}`,
          }))}
          referencia={{
            valor: resumen.asistencia,
            etiqueta: `Prom. ${porcentaje(resumen.asistencia)}`,
          }}
        />
      )}
      {diasBajos.length > 0 && (
        <section class="corta">
          <h3>Los días más bajos</h3>
          <ul>
            {diasBajos.map((s) => (
              <li>
                <a href={`/panel/hoy?fecha=${s.clave}`}>{diaTexto(s.clave)}</a>
                <span class:list={["pct", lecturaPorcentaje(s.valor)]}>{porcentaje(s.valor)}</span>
              </li>
            ))}
          </ul>
        </section>
      )}
    </div>
    <footer class="v-pie">
      <a
        href={irDesde("asistencia")("/panel/asistencia")}
        data-seccion
        class="v-boton v-primario v-bloque-ancho"
      >
        Ver todo en Asistencia <Icono nombre="siguiente" tamano={18} />
      </a>
    </footer>
  </template>

  <template id="capa-puntualidad">
    <header class="v-cabecera" tabindex="-1">
      <div>
        <h2 class="v-titulo" id="capa-puntualidad-titulo" data-ventana-titulo>
          Puntualidad
        </h2>
        <p class="v-sub">{NOMBRE_PERIODO[filtros.periodo]}</p>
      </div>
      <button type="button" class="v-cerrar" aria-label="Cerrar" data-cerrar-ventana>
        <Icono nombre="error" tamano={22} />
      </button>
    </header>
    <div class="v-contenido vistazo">
      <p class="frase-vistazo">
        {lecturaPunt && (
          <span class:list={["chip", lecturaPunt]}>{NOMBRE_LECTURA[lecturaPunt]}</span>
        )}
        {d.frasePuntualidad}
      </p>
      <dl class="tres">
        {llegadasGrupos.map((g) => (
          <div class={g.clase}>
            <dt>{g.texto}</dt>
            <dd>
              <a href={irDesde("puntualidad")("/panel/puntualidad")}>{pct(g.valor)}</a>
            </dd>
          </div>
        ))}
      </dl>
      {d.totalLlegadas > 0 && (
        <div class="proporcion" aria-hidden="true">
          {llegadasGrupos
            .filter((g) => g.valor)
            .map((g) => (
              <span class={g.clase} style={`flex: ${g.valor}`} />
            ))}
        </div>
      )}
      {d.masTarde.length > 0 && (
        <section class="corta">
          <h3>Quiénes llegan tarde más seguido</h3>
          <ul>
            {d.masTarde.slice(0, 5).map((c) => {
              const x = d.personaPorId.get(c.personalId);
              return (
                <li>
                  {x ? (
                    <a href={`/personal/${x.id}`} data-persona={x.id}>
                      {x.nombre} {x.apellido}
                    </a>
                  ) : (
                    "—"
                  )}
                  <span>{plural(c.tardanzas, "vez", "veces")}</span>
                </li>
              );
            })}
          </ul>
          {d.masTarde.length > 5 && (
            <a class="ver-mas" href={irDesde("puntualidad")("/panel/puntualidad")}>
              Ver las {d.masTarde.length} personas <Icono nombre="siguiente" tamano={16} />
            </a>
          )}
        </section>
      )}
    </div>
    <footer class="v-pie">
      <a
        href={irDesde("puntualidad")("/panel/puntualidad")}
        data-seccion
        class="v-boton v-primario v-bloque-ancho"
      >
        Ver todo en Puntualidad <Icono nombre="siguiente" tamano={18} />
      </a>
    </footer>
  </template>

  <template id="capa-ausencias">
    <header class="v-cabecera" tabindex="-1">
      <div>
        <h2 class="v-titulo" id="capa-ausencias-titulo" data-ventana-titulo>
          Ausencias y permisos
        </h2>
        <p class="v-sub">Faltas del período y permisos de esta semana</p>
      </div>
      <button type="button" class="v-cerrar" aria-label="Cerrar" data-cerrar-ventana>
        <Icono nombre="error" tamano={22} />
      </button>
    </header>
    <div class="v-contenido vistazo">
      <dl class="tres">
        <div class:list={[d.faltasPeriodo.length && "atencion"]}>
          <dt>Faltas</dt>
          <dd>
            <a href={irDesde("ausencias")("/panel/ausencias")}>{numero(d.faltasPeriodo.length)}</a>
          </dd>
        </div>
        <div>
          <dt>De permiso hoy</dt>
          <dd>
            <a href={irDesde("ausencias")("/panel/ausencias")}>{numero(d.permisosHoy)}</a>
          </dd>
        </div>
        <div>
          <dt>Próximos 7 días</dt>
          <dd>
            <a href={irDesde("ausencias")("/panel/ausencias")}>{numero(proximos)}</a>
          </dd>
        </div>
      </dl>
      {d.faltasPeriodo.length > 0 && (
        <section class="corta">
          <h3>Faltas más recientes</h3>
          <ul class="tareas-vistazo">
            {d.faltasPeriodo.slice(0, 5).map((r) => (
              <li>
                <span>
                  <strong>{d.nombreDe(r.personalId)}</strong> · {diaTexto(r.fecha)}
