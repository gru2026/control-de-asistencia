            detalle: `${c.personas} pers.`,
            href: irDesde("categorias")("/panel/categorias", { categoria: c.categoriaId }),
          }))}
        />
      )}
    </div>
    <footer class="v-pie">
      <a
        href={irDesde("categorias")("/panel/categorias")}
        data-seccion
        class="v-boton v-primario v-bloque-ancho"
      >
        Ver todo en Por categoría <Icono nombre="siguiente" tamano={18} />
      </a>
    </footer>
  </template>
</PanelSeccionLayout>

