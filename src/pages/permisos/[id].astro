---
import PanelLayout from "@/layouts/PanelLayout.astro";
import Tarjeta from "@/components/ui/Tarjeta.astro";
import Boton from "@/components/ui/Boton.astro";
import Alerta from "@/components/ui/Alerta.astro";
import Input from "@/components/ui/Input.astro";
import Select from "@/components/ui/Select.astro";
import Modal from "@/components/ui/Modal.astro";
import Icono from "@/components/ui/Icono.astro";
import { esUuid, MOTIVOS_PERMISO, texto, validarPermiso, type Errores } from "@/lib/validacion";
import { eliminarPermiso, guardarPermiso } from "@/lib/servicios/permisos";
import { ponerFlash } from "@/lib/flash";
import { fechaCorta, hoyEnZona } from "@/lib/fecha";
import { plural } from "@/lib/formato";
import { diasDelPermiso } from "@/lib/reglas/permisos";

const { id = "" } = Astro.params;
const esNuevo = id === "nuevo";
if (!esNuevo && !esUuid(id)) return Astro.rewrite("/404");

const sb = Astro.locals.supabase;
const perfil = Astro.locals.perfil!;
const volverA = (() => {
  const v = Astro.url.searchParams.get("volver");
  return v && (/^\/personal\/[0-9a-f-]{36}$/.test(v) || v === "/panel/hoy") ? v : "/permisos";
})();

interface FilaPermiso {
  id: string;
  personal_id: string;
  fecha_desde: string;
  fecha_hasta: string;
  motivo: string;
  observacion: string | null;
  creado_en: string;
}
let actual: FilaPermiso | null = null;
if (!esNuevo) {
  const { data } = await sb
    .from("permisos")
    .select("id, personal_id, fecha_desde, fecha_hasta, motivo, observacion, creado_en")
    .eq("id", id)
    .maybeSingle<FilaPermiso>();
  if (!data) return Astro.rewrite("/404");
  actual = data;
}

let errores: Errores = {};
let mensaje: string | null = null;
let valores: Record<string, string> = {};

if (Astro.request.method === "POST") {
  const f = await Astro.request.formData();
  valores = Object.fromEntries([...f.entries()].map(([k, v]) => [k, String(v)]));
  try {
    if (texto(f, "accion") === "eliminar" && actual) {
      const r = await eliminarPermiso(sb, actual.id);
      if (r.ok) {
        ponerFlash(
          Astro.cookies,
          "exito",
          r.cambios
            ? `Permiso eliminado. ${plural(r.cambios, "día volvió", "días volvieron")} a falta.`
            : "Permiso eliminado.",
        );
        return Astro.redirect(volverA, 303);
      }
      mensaje = r.mensaje;
    } else {
      const v = validarPermiso(f);
      if (!v.ok) errores = v.errores;
      else {
        const r = await guardarPermiso(sb, v.datos, perfil.id, actual?.id);
        if (r.ok) {
          const extra = r.cambios
            ? ` ${plural(r.cambios, "falta pasó", "faltas pasaron")} a permiso.`
            : "";
          ponerFlash(
            Astro.cookies,
            "exito",
            `${esNuevo ? "Permiso cargado." : "Permiso actualizado."}${extra}`,
          );
          return Astro.redirect(volverA, 303);
        }
        if (r.campo) errores = { [r.campo]: r.mensaje };
        else mensaje = r.mensaje;
      }
    }
  } catch (e) {
    console.error("[permisos]", e);
    mensaje = "Ocurrió un error al guardar. Intente de nuevo.";
  }
  mensaje ??= "Revise los campos marcados.";
  Astro.response.status = 400;
}

const { data: gente } = await sb
  .from("personal")
  .select("id, nombre, apellido, cedula")
  .eq("estado", "activo")
  .order("apellido")
  .order("nombre");
const personas = (gente ?? []) as {
  id: string;
  nombre: string;
  apellido: string;
  cedula: string;
}[];

const hoy = hoyEnZona();
const desdeParam = /^\d{4}-\d{2}-\d{2}$/.test(Astro.url.searchParams.get("desde") ?? "")
  ? Astro.url.searchParams.get("desde")
  : null;
const inicial: Record<string, string> = actual
  ? {
      personal_id: actual.personal_id,
      fecha_desde: actual.fecha_desde,
      fecha_hasta: actual.fecha_hasta,
      motivo: actual.motivo,
      observacion: actual.observacion ?? "",
    }
  : {
      personal_id: Astro.url.searchParams.get("persona") ?? "",
      fecha_desde: desdeParam ?? hoy,
      fecha_hasta: desdeParam ?? hoy,
      motivo: "",
      observacion: "",
    };
const v = (k: string) =>
  Astro.request.method === "POST" ? (valores[k] ?? "") : (inicial[k] ?? "");
// Si la persona ya no está activa, igual se muestra para poder editar su permiso.
const opcionesPersonas = personas.map((x) => ({
  valor: x.id,
  texto: `${x.apellido}, ${x.nombre} · ${x.cedula}`,
}));
if (actual && !personas.some((x) => x.id === actual!.personal_id)) {
  const { data: x } = await sb
    .from("personal")
    .select("nombre, apellido, cedula")
    .eq("id", actual.personal_id)
    .single();
  if (x)
    opcionesPersonas.unshift({
      valor: actual.personal_id,
      texto: `${x.apellido}, ${x.nombre} · ${x.cedula} (inactivo)`,
    });
}
const motivoEsLista = (MOTIVOS_PERMISO as readonly string[]).includes(v("motivo")) || !v("motivo");
const opcionesMotivo = [
  ...MOTIVOS_PERMISO.map((m) => ({ valor: m, texto: m })),
  ...(motivoEsLista ? [] : [{ valor: v("motivo"), texto: v("motivo") }]),
];
// Zona lateral: faltas que cubre y otros permisos de la persona
const personaElegida = v("personal_id");
const [faltasRes, otrosRes] = esUuid(personaElegida)
  ? await Promise.all([
      sb
        .from("registros_asistencia")
        .select("id", { count: "exact", head: true })
        .eq("personal_id", personaElegida)
        .eq("estado", "falta")
        .is("hora_entrada", null)
        .gte("fecha", v("fecha_desde") || hoy)
        .lte("fecha", v("fecha_hasta") || v("fecha_desde") || hoy),
      sb
        .from("permisos")
        .select("id, fecha_desde, fecha_hasta, motivo")
        .eq("personal_id", personaElegida)
        .neq("id", actual?.id ?? "00000000-0000-0000-0000-000000000000")
        .order("fecha_desde", { ascending: false })
        .limit(5),
    ])
  : [{ count: 0 }, { data: [] }];
const faltasEnRango = faltasRes.count ?? 0;
const otrosPermisos = (otrosRes.data ?? []) as {
  fecha_desde: string;
  fecha_hasta: string;
  motivo: string;
}[];
---

<PanelLayout
  titulo={esNuevo ? "Nuevo permiso" : "Editar permiso"}
  migas={[{ texto: "Permisos", href: "/permisos" }, { texto: esNuevo ? "Nuevo" : "Editar" }]}
>
  <form method="post" class="dos-zonas" novalidate data-avisar-cambios data-form-permiso>
    <div class="zona-principal">
      {mensaje && <Alerta tipo="error">{mensaje}</Alerta>}
      <Tarjeta>
        <div class="campos">
          <Select
            class="c-largo"
            etiqueta="Persona"
            nombre="personal_id"
            opciones={opcionesPersonas}
            valor={v("personal_id")}
            vacia="Seleccione…"
            error={errores.personal_id}
            required
          />
          <Input
            class="c-corto"
            etiqueta="Desde"
            nombre="fecha_desde"
            type="date"
            value={v("fecha_desde")}
            error={errores.fecha_desde}
            required
          />
          <Input
            class="c-corto"
            etiqueta="Hasta"
            nombre="fecha_hasta"
            type="date"
            value={v("fecha_hasta")}
            error={errores.fecha_hasta}
            ayuda="Un solo día: la misma fecha."
          />
          <fieldset class="opciones-campo c-completo">
            <legend>
              Motivo{" "}
              <span class="obligatorio" aria-hidden="true">
                *
              </span>
            </legend>
            <div class="v-chips">
              {opcionesMotivo.map((m) => (
                <label>
                  <input
                    type="radio"
                    name="motivo"
                    value={m.valor}
                    checked={m.valor === v("motivo")}
                  />
                  {m.texto}
                </label>
              ))}
            </div>
            {errores.motivo && <small class="error">{errores.motivo}</small>}
          </fieldset>
          <div class="campo c-completo">
            <label for="observacion">Observación</label>
            <textarea
              id="observacion"
              name="observacion"
              rows="3"
              maxlength="500"
              aria-invalid={errores.observacion ? "true" : undefined}
              aria-describedby={errores.observacion ? "observacion-error" : "observacion-ayuda"}
            >{v("observacion")}</textarea>
            {errores.observacion ? (
              <small id="observacion-error" class="error">
                {errores.observacion}
              </small>
            ) : (
              <small id="observacion-ayuda">
                Opcional. Por ejemplo, el número del reposo o quién lo autorizó. Obligatoria si el
                motivo es «Otro».
              </small>
            )}
          </div>
        </div>
      </Tarjeta>
    </div>

    <aside class="zona-lateral" aria-label="Resumen del permiso">
      <Tarjeta titulo="Resumen">
        <dl class="datos-lateral">
          <div>
            <dt>Duración</dt>
            <dd data-dias-permiso>
              {plural(
                diasDelPermiso(
                  v("fecha_desde") || hoy,
                  v("fecha_hasta") || v("fecha_desde") || hoy,
                ),
                "día",
                "días",
              )}
            </dd>
          </div>
          <div>
            <dt>Faltas que pasan a permiso</dt>
            <dd>{faltasEnRango}</dd>
          </div>
        </dl>
        <p class="nota espacio">Las faltas de esas fechas pasan a permiso al guardar.</p>
      </Tarjeta>
      {otrosPermisos.length > 0 && (
        <Tarjeta titulo="Otros permisos de la persona">
          <ul class="lista">
            {otrosPermisos.map((x) => (
              <li>
                <span>
                  {x.fecha_desde === x.fecha_hasta
                    ? fechaCorta(x.fecha_desde)
                    : `${fechaCorta(x.fecha_desde)} – ${fechaCorta(x.fecha_hasta)}`}
                </span>
                <span class="nota">{x.motivo}</span>
              </li>
            ))}
          </ul>
        </Tarjeta>
      )}
      <div class="pie-form">
        {!esNuevo && (
          <Boton variante="fantasma" data-abrir-modal="modal-eliminar" class="eliminar">
            <Icono nombre="papelera" tamano={18} />
            Eliminar
          </Boton>
        )}
        <Boton href={volverA} variante="secundario">
          Cancelar
        </Boton>
        <Boton type="submit" data-texto-cargando="Guardando…">
          {esNuevo ? "Cargar permiso" : "Guardar cambios"}
        </Boton>
      </div>
    </aside>
  </form>

  {!esNuevo && (
    <Modal id="modal-eliminar" titulo="¿Eliminar este permiso?">
      <p>Los días que ya pasaron y no tienen marcación volverán a contar como falta.</p>
      <form method="post" slot="acciones">
        <input type="hidden" name="accion" value="eliminar" />
        <Boton type="submit" variante="peligro">
          Eliminar
        </Boton>
      </form>
    </Modal>
  )}
</PanelLayout>

<script>
  // «Hasta» nunca antes de «Desde» (delegado: sobrevive a la navegación).
  document.addEventListener("change", (ev) => {
    const desde = ev.target as HTMLInputElement;
    if (desde.name !== "fecha_desde") return;
    const hasta = desde.form?.querySelector<HTMLInputElement>('input[name="fecha_hasta"]');
    if (!hasta) return;
    hasta.min = desde.value;
    if (!hasta.value || hasta.value < desde.value) hasta.value = desde.value;
  });
  // Duración en vivo en la zona lateral
  document.addEventListener("change", (ev) => {
    const form = (ev.target as HTMLInputElement).form;
    if (!form?.hasAttribute("data-form-permiso")) return;
    const d = form.querySelector<HTMLInputElement>('input[name="fecha_desde"]')?.value;
    const h = form.querySelector<HTMLInputElement>('input[name="fecha_hasta"]')?.value || d;
    const salida = document.querySelector("[data-dias-permiso]");
    if (!d || !h || !salida) return;
    const n = Math.round((Date.parse(h) - Date.parse(d)) / 86_400_000) + 1;
    salida.textContent = n > 0 ? `${n} ${n === 1 ? "día" : "días"}` : "—";
  });
</script>

<style>
  .campo {
    display: grid;
    gap: 6px;
  }
  .campo label {
    font-weight: var(--peso-medio);
    font-size: var(--texto-sm);
  }
  textarea {
    padding: var(--esp-3);
    border: 1px solid var(--color-borde-fuerte);
    border-radius: var(--radio-sm);
    resize: vertical;
    font-family: inherit;
  }
  textarea[aria-invalid="true"] {
    border-color: var(--color-error);
  }
  small {
    color: var(--color-texto-suave);
  }
  .error {
    color: var(--color-error);
    font-weight: 600;
  }
  .obligatorio {
    color: var(--color-error);
  }
  .nota {
    margin: 0;
    font-size: var(--texto-sm);
    color: var(--color-texto-suave);
  }
  .espacio {
    margin-top: var(--esp-3);
  }
  .lista {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .lista li {
    display: flex;
    justify-content: space-between;
    gap: var(--esp-2);
    padding: var(--esp-2) 0;
    border-top: 1px solid var(--color-borde);
    font-size: var(--texto-sm);
  }
  .lista li:first-child {
    border-top: 0;
    padding-top: 0;
  }
  .pie-form :global(.eliminar) {
    margin-right: auto;
    color: var(--color-error);
  }
</style>
