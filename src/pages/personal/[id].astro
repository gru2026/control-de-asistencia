---
import PanelLayout from "@/layouts/PanelLayout.astro";
import Tarjeta from "@/components/ui/Tarjeta.astro";
import Boton from "@/components/ui/Boton.astro";
import Icono from "@/components/ui/Icono.astro";
import Badge from "@/components/ui/Badge.astro";
import Alerta from "@/components/ui/Alerta.astro";
import Modal from "@/components/ui/Modal.astro";
import Input from "@/components/ui/Input.astro";
import Select from "@/components/ui/Select.astro";
import CamposPersonal from "@/components/personal/CamposPersonal.astro";
import CamposCuenta from "@/components/personal/CamposCuenta.astro";
import {
  aExcepcion,
  aJornada,
  listarJornadas,
  type FilaHorario,
  type FilaJornada,
} from "@/lib/datos/jornadas";
import { resolverJornada } from "@/lib/reglas/jornada";
import {
  esUuid,
  texto,
  validarClave,
  validarCuenta,
  validarExcepciones,
  validarPersonal,
  type Errores,
} from "@/lib/validacion";
import {
  actualizarPersonal,
  cambiarEstadoPersonal,
  vincularCuentaNueva,
} from "@/lib/servicios/personal";
import {
  cambiarRol,
  crearCuentaCedula,
  generarClaveTemporal,
  restablecerClave,
  restablecerClaveInicial,
} from "@/lib/servicios/cuentas";
import { CLAVE_INICIAL, esCuentaCedula, usuarioVisible } from "@/lib/auth/cedula";
import { limpiarIntentos } from "@/lib/servicios/intentos";
import { ponerFlash } from "@/lib/flash";
import { fechaCorta, horaCorta } from "@/lib/fecha";
import ChipCategoria from "@/components/ui/ChipCategoria.astro";
import { listarCategorias } from "@/lib/datos/categorias";
import { resumir, type RegistroEstadistica } from "@/lib/reglas/estadisticas";
import { diferenciaMin } from "@/lib/reglas/estados";
import { horaEnZona, sumarDias } from "@/lib/reglas/tiempo";
import { hoyEnZona } from "@/lib/fecha";
import { vigenciaPermiso } from "@/lib/reglas/permisos";
import {
  aprobarDispositivo,
  autorizarCambioTelefono,
  cambiarMarcaEnPc,
  cancelarCambioTelefono,
  COLUMNAS_DISPOSITIVO,
  revocarDispositivo,
  type FilaDispositivo,
} from "@/lib/servicios/dispositivos";
import {
  NOMBRE_DIA,
  NOMBRE_ROL,
  NOMBRE_VINCULO,
  ROLES,
  type DiaSemana,
  type EstadoAsistencia,
  type Rol,
  type Vinculo,
} from "@/types";

const { id = "" } = Astro.params;
if (!esUuid(id)) return Astro.rewrite("/404");

const sb = Astro.locals.supabase;
const perfil = Astro.locals.perfil!;
const esDirectiva = perfil.rol === "directiva";

interface Ficha {
  id: string;
  nombre: string;
  apellido: string;
  cedula: string;
  categoria_id: string;
  vinculo: Vinculo;
  carga_horaria: number | null;
  telefono: string | null;
  jornada_id: string | null;
  fecha_ingreso: string | null;
  estado: "activo" | "inactivo";
  creado_en: string;
  marca_en_pc: boolean;
  cambio_telefono: boolean;
  jornadas: FilaJornada | null;
  usuarios: {
    id: string;
    email: string;
    rol: Rol;
    estado: "activo" | "inactivo";
    debe_cambiar_clave: boolean;
  } | null;
  horarios: FilaHorario[];
}

async function cargar() {
  const { data } = await sb
    .from("personal")
    .select(
      "id, nombre, apellido, cedula, categoria_id, vinculo, carga_horaria, telefono, jornada_id, fecha_ingreso, estado, creado_en, marca_en_pc, cambio_telefono," +
        " jornadas(id, nombre, hora_entrada, hora_salida, tolerancia_min, pausa_min, dias_laborables, activa, nocturna)," +
        " usuarios(id, email, rol, estado, debe_cambiar_clave)," +
        " horarios(dia_semana, hora_entrada, hora_salida, tolerancia_min, libre)",
    )
    .eq("id", id)
    .maybeSingle<Ficha>();
  return data;
}

let ficha = await cargar();
if (!ficha) return Astro.rewrite("/404");

// ── Acciones (solo directiva) ──────────────────────────────────
let seccion: string | null = null;
let errores: Errores = {};
let mensaje: string | null = null;
let valoresForm: Record<string, string> = {};

// Secretaría también aprueba o revoca teléfonos (R11); el resto es solo de la directiva.
const ACCIONES_ADMIN = [
  "disp_aprobar",
  "disp_revocar",
  "tel_cambio",
  "tel_cancelar",
  "marca_pc",
  "clave_inicial",
];

if (Astro.request.method === "POST") {
  const f = await Astro.request.formData();
  seccion = texto(f, "accion");
  if (!esDirectiva && !ACCIONES_ADMIN.includes(seccion)) {
    return new Response("Prohibido", { status: 403 });
  }
  valoresForm = Object.fromEntries([...f.entries()].map(([k, v]) => [k, String(v)]));
  let exito: string | null = null;

  switch (seccion) {
    case "tel_cambio": {
      if (!ficha.usuarios) break;
      await autorizarCambioTelefono(id, ficha.usuarios.id);
      exito = "Cambio autorizado: el próximo teléfono con que marque quedará aprobado.";
      break;
    }
    case "tel_cancelar": {
      await cancelarCambioTelefono(id);
      exito = "Cambio de teléfono cancelado.";
      break;
    }
    case "marca_pc": {
      const valor = texto(f, "valor") === "si";
      await cambiarMarcaEnPc(id, valor);
      exito = valor
        ? "Listo: su asistencia se registra en secretaría (Asistencia › Registro del día)."
        : "Listo: vuelve a marcar con su teléfono.";
      break;
    }
    case "disp_aprobar":
    case "disp_revocar": {
      const dispId = texto(f, "dispositivo_id");
      if (!esUuid(dispId) || !ficha.usuarios) break;
      // El teléfono debe pertenecer a la cuenta de esta ficha.
      const { data: propio } = await sb
        .from("dispositivos")
        .select("id")
        .eq("id", dispId)
        .eq("usuario_id", ficha.usuarios.id)
        .maybeSingle();
      if (!propio) {
        mensaje = "El teléfono no pertenece a esta persona.";
        break;
      }
      const res =
        seccion === "disp_aprobar"
          ? await aprobarDispositivo(sb, dispId, perfil.id)
          : await revocarDispositivo(sb, dispId);
      if (res.ok)
        exito =
          seccion === "disp_aprobar"
            ? "Teléfono aprobado. Ya puede marcar desde él."
            : "Teléfono revocado. Ya no puede marcar desde él.";
      else mensaje = res.mensaje;
      break;
    }
    case "datos": {
      const r = validarPersonal(f);
      if (!r.ok) {
        errores = r.errores;
        break;
      }
      const res = await actualizarPersonal(sb, id, r.datos);
      if (res.ok) exito = "Datos actualizados.";
      else ({ mensaje, errores = {} } = res);
      break;
    }
    case "excepciones": {
      const r = validarExcepciones(f);
      if (!r.ok) {
        errores = r.errores;
        break;
      }
      const dias = r.datos.map((d) => d.dia_semana);
      if (r.datos.length) {
        const { error } = await sb.from("horarios").upsert(
          r.datos.map((d) => ({ ...d, personal_id: id })),
          { onConflict: "personal_id,dia_semana" },
        );
        if (error) {
          mensaje = "No se pudo guardar el horario.";
          break;
        }
      }
      let borrar = sb.from("horarios").delete().eq("personal_id", id);
      if (dias.length) borrar = borrar.not("dia_semana", "in", `(${dias.join(",")})`);
      const { error } = await borrar;
      if (error) mensaje = "No se pudo guardar el horario.";
      else exito = "Horario semanal actualizado.";
      break;
    }
    case "crear_cuenta_cedula": {
      if (ficha.usuarios) {
        mensaje = "Esta persona ya tiene una cuenta.";
        break;
      }
      const rol = (texto(f, "rol") || "personal") as Rol;
      const res = await crearCuentaCedula(sb, ficha, ROLES.includes(rol) ? rol : "personal");
      if (res.ok)
        exito = `Cuenta creada. Usuario: ${ficha.cedula} · contraseña inicial: ${CLAVE_INICIAL}. La cambiará al entrar.`;
      else mensaje = res.mensaje;
      break;
    }
    case "clave_inicial": {
      if (!ficha.usuarios) break;
      const res = await restablecerClaveInicial(ficha.usuarios.id, ficha.usuarios.email);
      if (res.ok) await limpiarIntentos(ficha.cedula);
      if (res.ok)
        exito = `Contraseña restablecida a ${CLAVE_INICIAL}. Al entrar deberá crear una nueva.`;
      else mensaje = res.mensaje;
      break;
    }
    case "crear_cuenta": {
      if (ficha.usuarios) {
        mensaje = "Esta persona ya tiene una cuenta.";
        break;
      }
      const r = validarCuenta(f);
      if (!r.ok) {
        errores = r.errores;
        break;
      }
      const res = await vincularCuentaNueva(sb, id, ficha, r.datos);
      if (res.ok) exito = "Cuenta de acceso creada. Entregue la contraseña temporal a la persona.";
      else ({ mensaje, errores = {} } = res);
      break;
    }
    case "clave": {
      const clave = texto(f, "password");
      const err = validarClave(clave);
      if (err) {
        errores = { password: err };
        break;
      }
      if (!ficha.usuarios) break;
      const res = await restablecerClave(ficha.usuarios.id, clave);
      if (res.ok) exito = "Contraseña restablecida. Entregue la nueva contraseña a la persona.";
      else mensaje = res.mensaje;
      break;
    }
    case "rol": {
      const rol = texto(f, "rol") as Rol;
      if (!ficha.usuarios || !ROLES.includes(rol)) break;
      const res = await cambiarRol(sb, ficha.usuarios.id, rol, perfil.id);
      if (res.ok) exito = `Rol cambiado a ${NOMBRE_ROL[rol]}.`;
      else mensaje = res.mensaje;
      break;
    }
    case "activar":
    case "desactivar": {
      const res = await cambiarEstadoPersonal(sb, id, seccion === "activar", perfil.id);
      if (res.ok) exito = seccion === "activar" ? "Persona reactivada." : "Persona desactivada.";
      else mensaje = res.mensaje;
      break;
    }
    default:
      mensaje = "Acción no reconocida.";
  }

  if (exito) {
    ponerFlash(Astro.cookies, "exito", exito);
    return Astro.redirect(`/personal/${id}`, 303);
  }
  mensaje ??= "Revise los campos marcados.";
  Astro.response.status = 400;
  ficha = (await cargar()) ?? ficha;
}

const [jornadas, categorias, { data: disps }] = await Promise.all([
  listarJornadas(sb),
  listarCategorias(sb),
  ficha.usuarios
    ? sb
        .from("dispositivos")
        .select(COLUMNAS_DISPOSITIVO)
        .eq("usuario_id", ficha.usuarios.id)
        .eq("tipo", "celular")
        .order("creado_en", { ascending: false })
    : Promise.resolve({ data: [] }),
]);
const ORDEN_DISP = { pendiente: 0, aprobado: 1, revocado: 2 } as const;
const dispositivos = ((disps ?? []) as FilaDispositivo[]).sort(
  (a, b) => ORDEN_DISP[a.estado] - ORDEN_DISP[b.estado],
);
const NOMBRE_DISP = { aprobado: "Aprobado", pendiente: "Pendiente", revocado: "Revocado" };
const TIPO_DISP = { aprobado: "activo", pendiente: "pendiente", revocado: "inactivo" } as const;
const fechaHora = (iso: string | null) =>
  iso ? `${fechaCorta(hoyEnZona(undefined, new Date(iso)))} ${horaEnZona(iso)}` : "—";
const categoria = categorias.find((c) => c.id === ficha!.categoria_id);

// Resumen de los últimos 30 días e historial reciente
const hoy = hoyEnZona();
interface FilaRegistro {
  fecha: string;
  estado: EstadoAsistencia;
  hora_entrada: string | null;
  hora_salida: string | null;
  hora_esperada_entrada: string | null;
  horas_trabajadas: number | null;
  es_demo: boolean;
}
const { data: regs } = await sb
  .from("registros_asistencia")
  .select(
    "fecha, estado, hora_entrada, hora_salida, hora_esperada_entrada, horas_trabajadas, es_demo",
  )
  .eq("personal_id", id)
  .gte("fecha", sumarDias(hoy, -30))
  .order("fecha", { ascending: false });
const registros = (regs ?? []) as FilaRegistro[];
const registroHoy = registros.find((r) => r.fecha === hoy);
const resumen30 = resumir(
  registros.map((r): RegistroEstadistica => ({
    fecha: r.fecha,
    personalId: id,
    categoriaId: ficha!.categoria_id,
    estado: r.estado,
    diferenciaMin:
      r.hora_entrada && r.hora_esperada_entrada
        ? diferenciaMin(horaEnZona(r.hora_entrada), r.hora_esperada_entrada.slice(0, 5))
        : null,
    horas: r.horas_trabajadas === null ? null : Number(r.horas_trabajadas),
  })),
);
const ultimos = registros.slice(0, 10);
const { data: perms } = await sb
  .from("permisos")
  .select("id, fecha_desde, fecha_hasta, motivo")
  .eq("personal_id", id)
  .gte("fecha_hasta", sumarDias(hoy, -90))
  .order("fecha_desde", { ascending: false });
const permisos = (perms ?? []) as {
  id: string;
  fecha_desde: string;
  fecha_hasta: string;
  motivo: string;
}[];
const NOMBRE_ESTADO_FICHA = {
  presente: "Presente",
  tarde: "Tarde",
  falta: "Falta",
  permiso: "Permiso",
};
const estadoTelefono = ficha.marca_en_pc
  ? "Marca en secretaría"
  : dispositivos.some((d) => d.estado === "pendiente")
    ? "Por aprobar"
    : dispositivos.some((d) => d.estado === "aprobado")
      ? "Aprobado"
      : "Sin registrar";
const excepciones = new Map(ficha.horarios.map((h) => [h.dia_semana, h]));

// Resumen semanal efectivo (semana de referencia: 5–11 oct 2026, lunes a domingo)
const jornadaBase = ficha.jornadas ? aJornada(ficha.jornadas) : null;
const semana = ([1, 2, 3, 4, 5, 6, 7] as DiaSemana[]).map((d) => ({
  dia: d,
  regla: resolverJornada({
    fecha: `2026-10-${String(4 + d).padStart(2, "0")}`,
    jornada: jornadaBase,
    excepciones: ficha!.horarios.map(aExcepcion),
  }),
  excepcion: excepciones.get(d),
}));

const valoresDatos =
  seccion === "datos"
    ? valoresForm
    : {
        nombre: ficha.nombre,
        apellido: ficha.apellido,
        cedula: ficha.cedula,
        categoria_id: ficha.categoria_id,
        vinculo: ficha.vinculo,
        carga_horaria: ficha.carga_horaria,
        telefono: ficha.telefono,
        fecha_ingreso: ficha.fecha_ingreso,
        jornada_id: ficha.jornada_id,
      };
const err = (s: string) => (seccion === s ? errores : {});

// Pestaña abierta al llegar: la de la última acción (p. ej. errores al guardar los datos)
const SECCIONES_FICHA = [
  { id: "resumen", texto: "Resumen" },
  { id: "datos", texto: "Datos" },
  { id: "horario", texto: "Horario" },
  { id: "acceso", texto: "Teléfono y cuenta" },
  { id: "estado", texto: "Estado" },
] as const;
const PESTANA_DE_ACCION: Record<string, (typeof SECCIONES_FICHA)[number]["id"]> = {
  datos: "datos",
  excepciones: "horario",
  crear_cuenta: "acceso",
  crear_cuenta_cedula: "acceso",
  clave: "acceso",
  clave_inicial: "acceso",
  rol: "acceso",
  disp_aprobar: "acceso",
  disp_revocar: "acceso",
  tel_cambio: "acceso",
  tel_cancelar: "acceso",
  marca_pc: "acceso",
  activar: "estado",
  desactivar: "estado",
};
const activa = (seccion && PESTANA_DE_ACCION[seccion]) || "resumen";
const valorExc = (k: string, porDefecto: string) =>
  seccion === "excepciones" ? (valoresForm[k] ?? porDefecto) : porDefecto;
---

<PanelLayout
  titulo="Ficha de personal"
  migas={[
    { texto: "Panel", href: "/panel" },
    { texto: "Personal", href: "/personal" },
    { texto: `${ficha.nombre} ${ficha.apellido}` },
  ]}
>
  <Fragment slot="acciones">
    <Boton href="/personal" variante="secundario">
      <Icono nombre="atras" tamano={18} />
      Volver
    </Boton>
  </Fragment>

  <div class="pila">
    <section class="cabecera" aria-label="Resumen de la persona">
      <span class="avatar" aria-hidden="true" style={`--c: ${categoria?.color ?? "#64748b"}`}>
        {(ficha.nombre[0] ?? "") + (ficha.apellido[0] ?? "")}
      </span>
      <div class="identidad">
        <h2>
          {ficha.nombre} {ficha.apellido}
        </h2>
        <p>
          <span>{ficha.cedula}</span>
          {categoria && <ChipCategoria nombre={categoria.nombre} color={categoria.color} />}
          <span>{NOMBRE_VINCULO[ficha.vinculo]}</span>
          {ficha.carga_horaria && <span>{ficha.carga_horaria} h/semana</span>}
          <Badge tipo={ficha.estado}>{ficha.estado === "activo" ? "Activo" : "Inactivo"}</Badge>
        </p>
      </div>
      <dl class="mini-kpis" aria-label="Últimos 30 días">
        <div>
          <dt>Asistencia</dt>
          <dd>{resumen30.conteo.total ? `${resumen30.asistencia}%` : "—"}</dd>
        </div>
        <div>
          <dt>Tardanzas</dt>
          <dd>{resumen30.conteo.tarde}</dd>
        </div>
        <div>
          <dt>Faltas</dt>
          <dd>{resumen30.conteo.falta}</dd>
        </div>
        <div>
          <dt>Horas</dt>
          <dd>{Math.round(resumen30.horasTotales)}</dd>
        </div>
      </dl>
    </section>

    <div class="dos-zonas">
      <div class="zona-principal">
        <!-- Por capas: una sección a la vez (sin JavaScript se ven todas) -->
        <nav class="pestanas" aria-label="Secciones de la ficha" data-pestanas-ficha>
          {SECCIONES_FICHA.filter((x) => esDirectiva || x.id !== "estado").map((x) => (
            <a
              href={`#${x.id}`}
              data-tab={x.id}
              aria-current={activa === x.id ? "true" : undefined}
            >
              {x.texto}
            </a>
          ))}
        </nav>

        {mensaje && <Alerta tipo="error">{mensaje}</Alerta>}
        {!esDirectiva && (
          <Alerta tipo="info">Vista de solo lectura. Los cambios los realiza la directiva.</Alerta>
        )}

        <div class:list={["panel-ficha", activa === "resumen" && "activo"]} data-panel="resumen">
          <!-- Asistencia y permisos -->
          <Tarjeta
            titulo="Últimos registros de asistencia"
            id="historial"
            descripcion="Últimos 10 días registrados."
          >
            {ultimos.length ? (
              <ul class="historial">
                {ultimos.map((u) => (
                  <li>
                    <span class="fecha">{fechaCorta(u.fecha)}</span>
                    <Badge tipo={u.estado}>{NOMBRE_ESTADO_FICHA[u.estado]}</Badge>
                    <span class="horas">
                      {u.hora_entrada ? horaEnZona(u.hora_entrada) : "—"} →{" "}
                      {u.hora_salida ? horaEnZona(u.hora_salida) : "—"}
                    </span>
                    {u.es_demo && <span class="demo">demo</span>}
                  </li>
                ))}
              </ul>
            ) : (
              <p class="nota">Aún no hay registros de asistencia.</p>
            )}
          </Tarjeta>

          <Tarjeta
            titulo="Permisos"
            id="permisos"
            descripcion="Ausencias justificadas de los últimos 90 días y las próximas."
          >
            <Boton
              slot="acciones"
              href={`/permisos/nuevo?persona=${ficha.id}&volver=/personal/${ficha.id}`}
              data-ventana={`/ventanas/permiso?persona=${ficha.id}`}
              data-ventana-modo="centro"
              variante="secundario"
              tamano="pequeno"
            >
              <Icono nombre="mas" tamano={16} />
              Cargar permiso
            </Boton>
            {permisos.length ? (
              <ul class="historial">
                {permisos.map((x) => {
                  const vig = vigenciaPermiso(x.fecha_desde, x.fecha_hasta, hoy);
                  return (
                    <li>
                      <a class="fecha" href={`/permisos/${x.id}?volver=/personal/${ficha!.id}`}>
                        {x.fecha_desde === x.fecha_hasta
                          ? fechaCorta(x.fecha_desde)
                          : `${fechaCorta(x.fecha_desde)} – ${fechaCorta(x.fecha_hasta)}`}
                      </a>
                      <span class="horas">{x.motivo}</span>
                      <Badge
                        tipo={
                          vig === "vigente" ? "activo" : vig === "proximo" ? "info" : "inactivo"
                        }
                      >
                        {vig === "vigente"
                          ? "Vigente"
                          : vig === "proximo"
                            ? "Próximo"
                            : "Terminado"}
                      </Badge>
                    </li>
                  );
                })}
              </ul>
            ) : (
              <p class="nota">Sin permisos en este período.</p>
            )}
          </Tarjeta>
        </div>

        <div class:list={["panel-ficha", activa === "datos" && "activo"]} data-panel="datos">
          <!-- Datos personales -->
          <Tarjeta titulo="Datos personales" id="datos">
            <form method="post" novalidate data-avisar-cambios>
              <input type="hidden" name="accion" value="datos" />
              <fieldset disabled={!esDirectiva}>
                <CamposPersonal
                  valores={valoresDatos}
                  errores={err("datos")}
                  jornadas={jornadas}
                  categorias={categorias}
                />
              </fieldset>
              {esDirectiva && (
                <div class="final">
                  <Boton type="submit">Guardar datos</Boton>
                </div>
              )}
            </form>
          </Tarjeta>
        </div>

        <div class:list={["panel-ficha", activa === "horario" && "activo"]} data-panel="horario">
          <!-- Horario semanal -->
          <Tarjeta
            id="horario"
            titulo="Horario semanal"
            descripcion={
              ficha.jornadas
                ? `Jornada «${ficha.jornadas.nombre}». Use «Horario especial» o «Libre» solo para los días que difieren.`
                : "Asigne primero una jornada en los datos personales."
            }
          >
            <form method="post" novalidate>
              <input type="hidden" name="accion" value="excepciones" />
              <fieldset disabled={!esDirectiva}>
                <div class="semana">
                  <div class="fila cabecera-horario" aria-hidden="true">
                    <span>Día</span>
                    <span>Tipo</span>
                    <span>Entrada</span>
                    <span>Salida</span>
                    <span>Tolerancia</span>
                    <span>Resultado</span>
                  </div>
                  {semana.map(({ dia, regla, excepcion }) => {
                    const tipo = valorExc(
                      `tipo_${dia}`,
                      excepcion ? (excepcion.libre ? "libre" : "especial") : "normal",
                    );
                    const e = err("excepciones");
                    return (
                      <div class="fila">
                        <strong>{NOMBRE_DIA[dia]}</strong>
                        <Select
                          etiqueta={`Tipo · ${NOMBRE_DIA[dia]}`}
                          class="sin-etiqueta"
                          nombre={`tipo_${dia}`}
                          valor={tipo}
                          opciones={[
                            { valor: "normal", texto: "Según jornada" },
                            { valor: "especial", texto: "Horario especial" },
                            { valor: "libre", texto: "Libre" },
                          ]}
                        />
                        <Input
                          class="sin-etiqueta"
                          etiqueta={`Entrada · ${NOMBRE_DIA[dia]}`}
                          nombre={`entrada_${dia}`}
                          type="time"
                          value={valorExc(`entrada_${dia}`, horaCorta(excepcion?.hora_entrada))}
                          error={e[`entrada_${dia}`]}
                        />
                        <Input
                          class="sin-etiqueta"
                          etiqueta={`Salida · ${NOMBRE_DIA[dia]}`}
                          nombre={`salida_${dia}`}
                          type="time"
                          value={valorExc(`salida_${dia}`, horaCorta(excepcion?.hora_salida))}
                          error={e[`salida_${dia}`]}
                        />
                        <Input
                          class="sin-etiqueta"
                          etiqueta={`Tolerancia (min) · ${NOMBRE_DIA[dia]}`}
                          nombre={`tolerancia_${dia}`}
                          type="number"
                          min="0"
                          max="180"
                          placeholder="Jornada"
                          value={valorExc(
                            `tolerancia_${dia}`,
                            excepcion?.tolerancia_min?.toString() ?? "",
                          )}
                          error={e[`tolerancia_${dia}`]}
                        />
                        <span class="resultado">
                          {regla
                            ? `${regla.horaEntrada}–${regla.horaSalida} (±${regla.toleranciaMin}′)`
                            : "No laborable"}
                        </span>
                      </div>
                    );
                  })}
                </div>
                <p class="nota">
                  Entrada, salida y tolerancia solo se usan en los días con «Horario especial».
                </p>
              </fieldset>
              {esDirectiva && (
                <div class="final">
                  <Boton type="submit">Guardar horario</Boton>
                </div>
              )}
            </form>
          </Tarjeta>
        </div>

        <div class:list={["panel-ficha", activa === "acceso" && "activo"]} data-panel="acceso">
          <Tarjeta titulo="Cuenta de acceso" id="cuenta">
            {ficha.usuarios ? (
              <div class="pila">
                <dl class="datos">
                  <div>
                    <dt>{esCuentaCedula(ficha.usuarios.email) ? "Usuario" : "Correo"}</dt>
                    <dd>{usuarioVisible(ficha.usuarios.email)}</dd>
                  </div>
                  <div>
                    <dt>Rol</dt>
                    <dd>{NOMBRE_ROL[ficha.usuarios.rol]}</dd>
                  </div>
                  <div>
                    <dt>Estado</dt>
                    <dd>
                      {ficha.usuarios.estado !== "activo" ? (
                        <Badge tipo="inactivo">Desactivada</Badge>
                      ) : ficha.usuarios.debe_cambiar_clave ? (
                        <Badge tipo="pendiente">Sin activar (contraseña {CLAVE_INICIAL})</Badge>
                      ) : (
                        <Badge tipo="activo">Activa</Badge>
                      )}
                    </dd>
                  </div>
                </dl>
                {!esDirectiva && esCuentaCedula(ficha.usuarios.email) && (
                  <form method="post" class="mini">
                    <input type="hidden" name="accion" value="clave_inicial" />
                    <p class="nota">
                      Si olvidó su contraseña, vuelve a ser {CLAVE_INICIAL} y al entrar crea una
                      nueva.
                    </p>
                    <Boton type="submit" variante="secundario">
                      Restablecer a {CLAVE_INICIAL}
                    </Boton>
                  </form>
                )}
                {esDirectiva && (
                  <div class="dos">
                    {esCuentaCedula(ficha.usuarios.email) ? (
                      <form method="post" class="mini">
                        <input type="hidden" name="accion" value="clave_inicial" />
                        <p class="nota">
                          Si olvidó su contraseña, vuelve a ser {CLAVE_INICIAL} y al entrar crea una
                          nueva.
                        </p>
                        <Boton type="submit" variante="secundario">
                          Restablecer a {CLAVE_INICIAL}
                        </Boton>
                      </form>
                    ) : (
                      <form method="post" class="mini" novalidate>
                        <input type="hidden" name="accion" value="clave" />
                        <Input
                          etiqueta="Nueva contraseña temporal"
                          nombre="password"
                          type="text"
                          autocomplete="off"
                          value={
                            seccion === "clave" ? valoresForm.password : generarClaveTemporal()
                          }
                          error={err("clave").password}
                        />
                        <Boton type="submit" variante="secundario">
                          Restablecer contraseña
                        </Boton>
                      </form>
                    )}
                    <form method="post" class="mini">
                      <input type="hidden" name="accion" value="rol" />
                      <Select
                        etiqueta="Rol"
                        nombre="rol"
                        valor={ficha.usuarios.rol}
                        opciones={ROLES.map((r) => ({ valor: r, texto: NOMBRE_ROL[r] }))}
                      />
                      <Boton type="submit" variante="secundario">
                        Cambiar rol
                      </Boton>
                    </form>
                  </div>
                )}
              </div>
            ) : esDirectiva ? (
              <div class="pila">
                <form method="post" class="cuenta-cedula">
                  <input type="hidden" name="accion" value="crear_cuenta_cedula" />
                  <p class="nota">
                    Esta persona aún no tiene cuenta. Sin cuenta no puede marcar desde su teléfono.
                    Entrará con su cédula <strong>{ficha.cedula}</strong> y la contraseña inicial{" "}
                    <strong>{CLAVE_INICIAL}</strong>, que deberá cambiar en su primer ingreso.
                  </p>
                  <Select
                    etiqueta="Rol"
                    nombre="rol"
                    valor="personal"
                    opciones={ROLES.map((r) => ({ valor: r, texto: NOMBRE_ROL[r] }))}
                  />
                  <div class="final">
                    <Boton type="submit">Crear cuenta</Boton>
                  </div>
                </form>
                <details class="con-correo" open={seccion === "crear_cuenta"}>
                  <summary>Crear con correo y contraseña propios</summary>
                  <form method="post" novalidate>
                    <input type="hidden" name="accion" value="crear_cuenta" />
                    <CamposCuenta
                      valores={seccion === "crear_cuenta" ? valoresForm : {}}
                      errores={err("crear_cuenta")}
                      claveSugerida={generarClaveTemporal()}
                    />
                    <div class="final">
                      <Boton type="submit" variante="secundario">
                        Crear cuenta con correo
                      </Boton>
                    </div>
                  </form>
                </details>
              </div>
            ) : (
              <p class="nota">Sin cuenta de acceso.</p>
            )}
          </Tarjeta>

          <Tarjeta
            titulo="Teléfono de marcación"
            id="dispositivo"
            descripcion="Un solo teléfono aprobado por persona. El primero se aprueba solo al marcar por primera vez."
          >
            {ficha.marca_en_pc ? (
              <div class="tel-modo">
                <p class="nota">
                  <strong>Marca en secretaría.</strong> No usa teléfono: su entrada y salida se
                  registran en Asistencia › Registro del día.
                </p>
                <form method="post">
                  <input type="hidden" name="accion" value="marca_pc" />
                  <input type="hidden" name="valor" value="" />
                  <Boton type="submit" variante="secundario" tamano="pequeno">
                    Volver a marcar con teléfono
                  </Boton>
                </form>
              </div>
            ) : (
              <>
                {!ficha.usuarios ? (
                  <p class="nota">Necesita una cuenta de acceso para marcar con el teléfono.</p>
                ) : dispositivos.length === 0 ? (
                  <p class="nota">Todavía no ha marcado desde ningún teléfono.</p>
                ) : (
                  <ul class="dispositivos">
                    {dispositivos.map((d) => (
                      <li>
                        <div class="disp-dato">
                          <strong>{d.descripcion ?? "Teléfono"}</strong>
                          <span class="nota">
                            Registrado {fechaHora(d.creado_en)}
                            {d.ultimo_uso && <> · último uso {fechaHora(d.ultimo_uso)}</>}
                          </span>
                        </div>
                        <Badge tipo={TIPO_DISP[d.estado]}>{NOMBRE_DISP[d.estado]}</Badge>
                        <form method="post" class="disp-accion">
                          <input type="hidden" name="dispositivo_id" value={d.id} />
                          {d.estado === "aprobado" ? (
                            <Boton
                              type="submit"
                              name="accion"
                              value="disp_revocar"
                              variante="secundario"
                              tamano="pequeno"
                            >
                              Revocar
                            </Boton>
                          ) : (
                            <Boton
                              type="submit"
                              name="accion"
                              value="disp_aprobar"
                              tamano="pequeno"
                            >
                              Aprobar
                            </Boton>
                          )}
                        </form>
                      </li>
                    ))}
                  </ul>
                )}
                {dispositivos.some((d) => d.estado === "pendiente") &&
                  dispositivos.some((d) => d.estado === "aprobado") && (
                    <p class="nota disp-aviso">
                      Al aprobar el teléfono nuevo, el anterior queda revocado.
                    </p>
                  )}
                {ficha.cambio_telefono && (
                  <p class="nota disp-aviso cambio">
                    Cambio de teléfono autorizado: el próximo teléfono con que marque quedará
                    aprobado.
                  </p>
                )}
                <div class="tel-acciones">
                  {ficha.usuarios &&
                    (ficha.cambio_telefono ? (
                      <form method="post">
                        <input type="hidden" name="accion" value="tel_cancelar" />
                        <Boton type="submit" variante="secundario" tamano="pequeno">
                          Cancelar el cambio
                        </Boton>
                      </form>
                    ) : (
                      <form method="post">
                        <input type="hidden" name="accion" value="tel_cambio" />
                        <Boton type="submit" variante="secundario" tamano="pequeno">
                          <Icono nombre="telefono" tamano={16} />
                          Cambiar de teléfono
                        </Boton>
                      </form>
                    ))}
                  <form method="post">
                    <input type="hidden" name="accion" value="marca_pc" />
                    <input type="hidden" name="valor" value="si" />
                    <Boton type="submit" variante="fantasma" tamano="pequeno">
                      No tiene teléfono: marca en secretaría
                    </Boton>
                  </form>
                </div>
              </>
            )}
          </Tarjeta>
        </div>

        <div class:list={["panel-ficha", activa === "estado" && "activo"]} data-panel="estado">
          {esDirectiva && (
            <Tarjeta titulo="Estado" id="estado">
              <p class="nota">
                Registrada el {fechaCorta(ficha.creado_en.slice(0, 10))}. Las personas nunca se
                borran: se desactivan para conservar su historial.
              </p>
              {ficha.estado === "activo" ? (
                <Boton variante="peligro" data-abrir-modal="confirmar-desactivar">
                  Desactivar persona
                </Boton>
              ) : (
                <form method="post">
                  <input type="hidden" name="accion" value="activar" />
                  <Boton type="submit">Reactivar persona</Boton>
                </form>
              )}
            </Tarjeta>
          )}
        </div>
      </div>

      <aside class="zona-lateral" aria-label="De un vistazo">
        <Tarjeta titulo="De un vistazo">
          <dl class="datos-lateral">
            <div>
              <dt>Hoy</dt>
              <dd>
                {registroHoy ? (
                  <>
                    <Badge tipo={registroHoy.estado}>
                      {NOMBRE_ESTADO_FICHA[registroHoy.estado]}
                    </Badge>
                    {registroHoy.hora_entrada && ` ${horaEnZona(registroHoy.hora_entrada)}`}
                    {registroHoy.hora_salida && ` → ${horaEnZona(registroHoy.hora_salida)}`}
                  </>
                ) : (
                  "Sin registro"
                )}
              </dd>
            </div>
            <div>
              <dt>Jornada</dt>
              <dd>
                {ficha.jornadas
                  ? `${horaCorta(ficha.jornadas.hora_entrada)}–${horaCorta(ficha.jornadas.hora_salida)}`
                  : "Sin asignar"}
              </dd>
            </div>
            <div>
              <dt>Teléfono</dt>
              <dd>{estadoTelefono}</dd>
            </div>
            <div>
              <dt>Cuenta</dt>
              <dd>
                {ficha.usuarios
                  ? ficha.usuarios.estado !== "activo"
                    ? "Desactivada"
                    : ficha.usuarios.debe_cambiar_clave
                      ? "Sin activar"
                      : NOMBRE_ROL[ficha.usuarios.rol]
                  : "Sin cuenta"}
              </dd>
            </div>
            <div>
              <dt>Permisos (90 días)</dt>
              <dd>{permisos.length}</dd>
            </div>
          </dl>
        </Tarjeta>
        <div class="pie-form">
          <Boton
            href={`/permisos/nuevo?persona=${ficha.id}`}
            data-ventana={`/ventanas/permiso?persona=${ficha.id}`}
            data-ventana-modo="centro"
            variante="secundario"
          >
            <Icono nombre="permiso" tamano={18} />
            Cargar permiso
          </Boton>
        </div>
      </aside>
    </div>
  </div>

  {esDirectiva && ficha.estado === "activo" && (
    <Modal id="confirmar-desactivar" titulo="¿Desactivar a esta persona?">
      <p>
        {ficha.nombre} {ficha.apellido} dejará de aparecer en el registro diario
        {ficha.usuarios ? " y su cuenta quedará bloqueada" : ""}. Su historial se conserva y puede
        reactivarse después.
      </p>
      <form method="post" slot="acciones">
        <input type="hidden" name="accion" value="desactivar" />
        <Boton type="submit" variante="peligro">
          Desactivar
        </Boton>
      </form>
    </Modal>
  )}
</PanelLayout>

