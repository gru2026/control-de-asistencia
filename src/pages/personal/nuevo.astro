---
import PanelLayout from "@/layouts/PanelLayout.astro";
import Tarjeta from "@/components/ui/Tarjeta.astro";
import Boton from "@/components/ui/Boton.astro";
import Icono from "@/components/ui/Icono.astro";
import Alerta from "@/components/ui/Alerta.astro";
import CamposPersonal from "@/components/personal/CamposPersonal.astro";
import { listarJornadas } from "@/lib/datos/jornadas";
import { listarCategorias } from "@/lib/datos/categorias";
import { texto, validarPersonal, type Errores } from "@/lib/validacion";
import { crearPersonal } from "@/lib/servicios/personal";
import { crearCuentaCedula } from "@/lib/servicios/cuentas";
import { CLAVE_INICIAL } from "@/lib/auth/cedula";
import { ponerFlash } from "@/lib/flash";
import { NOMBRE_ROL, ROLES, type Rol } from "@/types";

const sb = Astro.locals.supabase;
const [jornadas, categorias] = await Promise.all([listarJornadas(sb), listarCategorias(sb)]);

let valores: Record<string, string> = {};
let errores: Errores = {};
let mensaje: string | null = null;
let conCuenta = true;
let rol: Rol = "personal";

if (Astro.request.method === "POST") {
  const f = await Astro.request.formData();
  valores = Object.fromEntries([...f.entries()].map(([k, v]) => [k, String(v)]));
  conCuenta = texto(f, "con_cuenta") === "si";
  rol = ROLES.includes(texto(f, "rol") as Rol) ? (texto(f, "rol") as Rol) : "personal";

  const rp = validarPersonal(f);
  if (rp.ok) {
    const r = await crearPersonal(sb, rp.datos, null);
    if (r.ok) {
      const persona = `${rp.datos.nombre} ${rp.datos.apellido}`;
      let texto_ = `${persona} registrado.`;
      if (conCuenta) {
        const c = await crearCuentaCedula(sb, { id: r.id, ...rp.datos }, rol);
        texto_ = c.ok
          ? `${persona} registrado. Entra con su cédula ${rp.datos.cedula} y la contraseña ${CLAVE_INICIAL}.`
          : `${persona} registrado, pero no se creó la cuenta: ${c.mensaje}`;
      }
      ponerFlash(Astro.cookies, "exito", texto_);
      return Astro.redirect(`/personal/${r.id}`, 303);
    }
    mensaje = r.mensaje;
    errores = { ...(r.errores ?? {}) };
  } else {
    errores = rp.errores;
    mensaje = "Revise los campos marcados.";
  }
  Astro.response.status = 400;
}
const jornadaElegida = jornadas.find((j) => j.id === valores.jornada_id);
---

<PanelLayout
  titulo="Nuevo personal"
  migas={[
    { texto: "Panel", href: "/panel" },
    { texto: "Personal", href: "/personal" },
    { texto: "Nuevo" },
  ]}
>
  <Fragment slot="acciones">
    <Boton href="/personal" variante="secundario">
      <Icono nombre="atras" tamano={18} />
      Volver
    </Boton>
  </Fragment>

  <form method="post" class="dos-zonas" novalidate data-avisar-cambios>
    <div class="zona-principal">
      {mensaje && <Alerta tipo="error">{mensaje}</Alerta>}
      <Tarjeta titulo="Datos personales">
        <CamposPersonal
          valores={valores}
          errores={errores}
          jornadas={jornadas}
          categorias={categorias}
        />
      </Tarjeta>
    </div>

    <aside class="zona-lateral" aria-label="Cuenta y resumen">
      <Tarjeta titulo="Cuenta de acceso" descripcion="Para que marque desde su teléfono.">
        <div class="cuenta">
          <label class="casilla">
            <input type="checkbox" name="con_cuenta" value="si" checked={conCuenta} />
            <span>
              <strong>Crear su cuenta ahora</strong>
              <small>Entrará con su cédula y la contraseña {CLAVE_INICIAL}.</small>
            </span>
          </label>
          <fieldset class="opciones-campo">
            <legend>Tipo de cuenta</legend>
            <div class="v-chips">
              {ROLES.map((r) => (
                <label>
                  <input type="radio" name="rol" value={r} checked={r === rol} />
                  {NOMBRE_ROL[r]}
                </label>
              ))}
            </div>
          </fieldset>
        </div>
      </Tarjeta>
      <Tarjeta titulo="Jornada">
        <p class="resumen" data-resumen-jornada>
          {jornadaElegida ? jornadaElegida.nombre : "Sin asignar"}
        </p>
        <p class="nota">
          Se propone sola al elegir la categoría. Puede cambiarla luego en su ficha.
        </p>
      </Tarjeta>
      <div class="pie-form">
        <Boton href="/personal" variante="secundario">
          Cancelar
        </Boton>
        <Boton type="submit">Guardar</Boton>
      </div>
    </aside>
  </form>
</PanelLayout>

<style>
  .cuenta {
    display: grid;
    gap: var(--esp-4);
  }
  .casilla {
    display: grid;
    grid-template-columns: 20px 1fr;
    column-gap: var(--esp-3);
    cursor: pointer;
  }
  .casilla input {
    width: 20px;
    height: 20px;
  }
  .casilla span {
    display: grid;
  }
  .casilla small,
  .nota {
    color: var(--color-texto-suave);
    font-size: var(--texto-sm);
  }
  .resumen {
    margin: 0 0 var(--esp-2);
    font-weight: var(--peso-fuerte);
  }
  .nota {
    margin: 0;
  }
</style>
